{
  "name": "Single Question Poll or Survey",
  "format": "2.0",
  "themePath": "default",
  "forms": [
    {
      "name": "AdminStart",
      "startPoint": true,
      "items": [
        {
          "type": "skipInstructions",
          "label": "skip1",
          "commands": [
            {
              "cmd": "if",
              "condition": {
                "field": "AdminStart:TitleText",
                "op": "isNotBlank"
              },
              "then": [
                {
                  "cmd": "skip",
                  "to": "__EndOfForm__"
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "label": "H1",
          "level": "main",
          "content": "Customize your Survey"
        },
        {
          "type": "fib",
          "label": "Q1",
          "style": "",
          "prompt": "Title of your survey:\n__________________________________________________________",
          "blanks": [
            {
              "name": "TitleText",
              "length": 58,
              "alternateLabel": "TitleText"
            }
          ]
        },
        {
          "type": "fib",
          "label": "Q2",
          "style": "",
          "prompt": "Question text:\n__________________________________________________________",
          "blanks": [
            {
              "name": "QuestionText",
              "length": 58,
              "alternateLabel": "QuestionText",
              "height": 2
            }
          ]
        },
        {
          "type": "fib",
          "label": "Q3",
          "style": "",
          "prompt": "Choices:\n__________________________________________________________\n__________________________________________________________\n__________________________________________________________\n__________________________________________________________",
          "blanks": [
            {
              "name": "Choice1",
              "length": 58,
              "alternateLabel": "Choice1",
              "required": true
            },
            {
              "name": "Choice2",
              "length": 58,
              "alternateLabel": "Choice2",
              "required": true
            },
            {
              "name": "Choice3",
              "length": 58,
              "alternateLabel": "Choice3"
            },
            {
              "name": "Choice4",
              "length": 58,
              "alternateLabel": "Choice4"
            }
          ]
        },
        {
          "type": "mc",
          "label": "Q4",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "Ask your users for their names, or keep them anonymous?",
          "choices": [
            {
              "label": "a",
              "text": "Ask for name (not recommended for surveying large groups.)"
            },
            {
              "label": "b",
              "text": "Do not ask for name (anonymous)"
            }
          ],
          "name": "AskForNames"
        },
        {
          "type": "mc",
          "label": "Q5",
          "onlyone": false,
          "required": false,
          "style": "vertical",
          "displayAs": "checkbox",
          "choiceSource": "manual",
          "question": "",
          "choices": [
            {
              "label": "a",
              "text": "Check here to be notified by email when someone takes the survey"
            }
          ],
          "name": "EmailNotify?"
        },
        {
          "type": "fib",
          "label": "Q6",
          "style": "",
          "prompt": "If you checked the box above, please provide your email address:\n__________________________________________________________",
          "blanks": [
            {
              "name": "AdminEmail",
              "length": 58,
              "alternateLabel": "AdminEmail"
            }
          ]
        },
        {
          "type": "mc",
          "label": "MCQ1",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "Continue to Administration Dashboard?",
          "choices": [
            {
              "label": "a",
              "text": "Yes"
            },
            {
              "label": "b",
              "text": "No"
            }
          ]
        },
        {
          "type": "field",
          "label": "",
          "name": "NumberOfChoices"
        }
      ],
      "themePath": "default",
      "process": "Post-Customize",
      "preProcess": "Pre-Customize",
      "dataEntryOnly": true
    },
    {
      "name": "Start Questionnaire",
      "startPoint": true,
      "items": [
        {
          "type": "skipInstructions",
          "label": "skip1",
          "commands": [
            {
              "cmd": "skip",
              "to": "__EndOfForm__"
            }
          ]
        }
      ],
      "themePath": "default",
      "process": "Post-StartQuestionnaire"
    },
    {
      "name": "Questionnaire",
      "startPoint": false,
      "items": [
        {
          "type": "text",
          "label": "T1",
          "style": "normal",
          "content": "<p style=\"text-align:center\"><span style=\"font-size:16pt;color:#000000\"><b><span class=\"field-token function-table-token\" contenteditable=\"false\" data-field-name=\"Customize_TitleText\" title=\"Customize_TitleText\" draggable=\"true\">&lt;&lt;Customize_TitleText&gt;&gt;</span></b></span></p>"
        },
        {
          "type": "mc",
          "label": "Q1",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "<<Customize_QuestionText>>",
          "choices": [
            {
              "label": "a",
              "text": "<<Customize_Choice1>>"
            },
            {
              "label": "b",
              "text": "<<Customize_Choice2>>"
            },
            {
              "label": "c",
              "text": "<<Customize_Choice3>>"
            },
            {
              "label": "d",
              "text": "<<Customize_Choice4>>"
            }
          ],
          "name": "UserResponse"
        },
        {
          "type": "field",
          "label": "",
          "name": "activeRecord"
        }
      ],
      "themePath": "default",
      "process": "Post_Questionnaire"
    },
    {
      "name": "Questionnaire_Name",
      "startPoint": false,
      "items": [
        {
          "type": "text",
          "label": "T1",
          "style": "normal",
          "content": "<p style=\"text-align:center\"><span style=\"font-size:16pt;color:#000000\"><b><span class=\"field-token function-table-token\" contenteditable=\"false\" data-field-name=\"Customize_TitleText\" title=\"Customize_TitleText\" draggable=\"true\">&lt;&lt;Customize_TitleText&gt;&gt;</span></b></span></p>"
        },
        {
          "type": "fib",
          "label": "Q1",
          "style": "",
          "prompt": "Please enter your name: ________________________________________",
          "blanks": [
            {
              "name": "Name",
              "length": 40,
              "alternateLabel": "Name",
              "required": true
            }
          ]
        },
        {
          "type": "mc",
          "label": "Q2",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "<<Customize_QuestionText>>",
          "choices": [
            {
              "label": "a",
              "text": "<<Customize_Choice1>>"
            },
            {
              "label": "b",
              "text": "<<Customize_Choice2>>"
            },
            {
              "label": "c",
              "text": "<<Customize_Choice3>>"
            },
            {
              "label": "d",
              "text": "<<Customize_Choice4>>"
            }
          ],
          "name": "UserResponse"
        },
        {
          "type": "field",
          "label": "",
          "name": "activeRecord"
        }
      ],
      "themePath": "default",
      "process": "Post_Questionnaire"
    },
    {
      "name": "Administration",
      "startPoint": false,
      "items": [
        {
          "type": "heading",
          "label": "H1",
          "level": "main",
          "content": "Administration Dashboard"
        },
        {
          "type": "mc",
          "label": "MCQ1",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "Please choose and then press Submit button:",
          "choices": [
            {
              "label": "a",
              "text": "Go back to Customize Survey"
            },
            {
              "label": "b",
              "text": "Test your Survey"
            },
            {
              "label": "c",
              "text": "Exclude Signatory from Display"
            },
            {
              "label": "d",
              "text": "Purge all Results"
            },
            {
              "label": "e",
              "text": "Quit Administrative Dashboard"
            }
          ]
        }
      ],
      "themePath": "default",
      "process": "Post-Administration",
      "preProcess": "Pre-Administration"
    },
    {
      "name": "Exclude Signatory",
      "startPoint": false,
      "items": [
        {
          "type": "heading",
          "label": "H1",
          "level": "main",
          "content": "Exclude Signatory"
        },
        {
          "type": "text",
          "label": "T1",
          "style": "instructional",
          "content": "This routine will keep a signatory from showing on the list, although it will not delete the name.  This is useful if you see an obviously fake signatory, although it is preserved in the record for any future audit of results."
        },
        {
          "type": "text",
          "label": "T2",
          "style": "normal",
          "content": [
            {
              "type": "paragraph",
              "align": "left",
              "indent": 0,
              "nodes": [
                {
                  "type": "font",
                  "nodes": [
                    {
                      "type": "itemizationTable",
                      "version": 2,
                      "form": "Questionnaire_Name",
                      "columns": [
                        {
                          "header": "Name",
                          "field": "Record:Questionnaire_Name:Name"
                        },
                        {
                          "header": "Choice",
                          "field": "Record:Questionnaire_Name:UserResponse"
                        },
                        {
                          "header": "Active Record",
                          "field": "Record:Questionnaire_Name:Name"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "font",
                  "nodes": [],
                  "face": "Arial",
                  "size": 16,
                  "color": "#000000"
                }
              ]
            },
            {
              "type": "paragraph",
              "align": "left",
              "indent": 0,
              "nodes": []
            }
          ]
        },
        {
          "type": "fib",
          "label": "FIB1",
          "style": "",
          "prompt": "Name to exclude: ____________________",
          "blanks": [
            {
              "name": "FIB1:a",
              "length": 20,
              "alternateLabel": "FIB1:a"
            }
          ]
        }
      ],
      "process": "Post-Exclude"
    }
  ],
  "processes": [
    {
      "name": "Post-StartQuestionnaire",
      "commands": [
        {
          "cmd": "comment",
          "text": "[object Object]"
        },
        {
          "cmd": "set",
          "field": "Admin?",
          "value": "No",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "comment",
          "text": "[object Object]"
        },
        {
          "cmd": "get",
          "recordList": "Setup Records",
          "sourceForms": [
            "AdminStart"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "SetupRecord",
          "recordList": "Setup Records",
          "do": [
            {
              "cmd": "set",
              "field": "Customize_TitleText",
              "value": "<<SetupRecord:AdminStart:TitleText>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_QuestionText",
              "value": "<<SetupRecord:AdminStart:QuestionText>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "NumberOfChoices",
              "value": "<<SetupRecord:AdminStart:NumberOfChoices>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice1",
              "value": "<<SetupRecord:AdminStart:Choice1>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice2",
              "value": "<<SetupRecord:AdminStart:Choice2>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice3",
              "value": "<<SetupRecord:AdminStart:Choice3>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice4",
              "value": "<<SetupRecord:AdminStart:Choice4>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "IncludeName",
              "value": "false",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "if",
              "condition": {
                "field": "SetupRecord:AdminStart:AskForNames",
                "op": "mcEquals",
                "value": "a"
              },
              "then": [
                {
                  "cmd": "set",
                  "field": "IncludeName",
                  "value": "true",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ]
            },
            {
              "cmd": "if",
              "condition": {
                "and": [
                  {
                    "field": "SetupRecord:AdminStart:EmailNotify?",
                    "op": "mcEquals",
                    "value": "a"
                  },
                  {
                    "field": "SetupRecord:AdminStart:AdminEmail",
                    "op": "isNotBlank"
                  }
                ]
              },
              "then": [
                {
                  "cmd": "set",
                  "field": "EmailAddress",
                  "value": "<<SetupRecord:AdminStart:AdminEmail>>",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ],
              "else": [
                {
                  "cmd": "set",
                  "field": "EmailAddress",
                  "value": "No Notification",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ]
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Start Questionnaire:IncludeName",
            "op": "equals",
            "value": "true"
          },
          "then": [
            {
              "cmd": "show",
              "form": "Questionnaire_Name"
            }
          ]
        },
        {
          "cmd": "show",
          "form": "Questionnaire"
        }
      ]
    },
    {
      "name": "Post-Customize",
      "commands": [
        {
          "cmd": "set",
          "field": "AdminStart:NumberOfChoices",
          "value": "0",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "if",
          "condition": {
            "field": "AdminStart:Choice1",
            "op": "isNotBlank"
          },
          "then": [
            {
              "cmd": "set",
              "field": "AdminStart:NumberOfChoices",
              "value": "<<AdminStart:NumberOfChoices>> + 1",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "if",
              "condition": {
                "field": "AdminStart:Choice2",
                "op": "isNotBlank"
              },
              "then": [
                {
                  "cmd": "set",
                  "field": "AdminStart:NumberOfChoices",
                  "value": "<<AdminStart:NumberOfChoices>> + 1",
                  "concat": false,
                  "arithmeticAsText": false
                },
                {
                  "cmd": "if",
                  "condition": {
                    "field": "AdminStart:Choice3",
                    "op": "isNotBlank"
                  },
                  "then": [
                    {
                      "cmd": "set",
                      "field": "AdminStart:NumberOfChoices",
                      "value": "<<AdminStart:NumberOfChoices>> + 1",
                      "concat": false,
                      "arithmeticAsText": false
                    },
                    {
                      "cmd": "if",
                      "condition": {
                        "field": "AdminStart:Choice4",
                        "op": "isNotBlank"
                      },
                      "then": [
                        {
                          "cmd": "set",
                          "field": "AdminStart:NumberOfChoices",
                          "value": "<<AdminStart:NumberOfChoices>> + 1",
                          "concat": false,
                          "arithmeticAsText": false
                        }
                      ]
                    }
                  ]
                }
              ],
              "else": [
                {
                  "cmd": "showDocument",
                  "document": "Choice Count Error",
                  "reset": false
                },
                {
                  "cmd": "show",
                  "form": "AdminStart"
                }
              ]
            }
          ],
          "else": [
            {
              "cmd": "showDocument",
              "document": "Choice Count Error",
              "reset": false
            },
            {
              "cmd": "show",
              "form": "AdminStart"
            }
          ]
        },
        {
          "cmd": "comment",
          "text": "[object Object]"
        },
        {
          "cmd": "if",
          "condition": {
            "field": "AdminStart:MCQ1",
            "op": "mcEquals",
            "value": "a"
          },
          "then": [
            {
              "cmd": "comment",
              "text": "[object Object]"
            },
            {
              "cmd": "set",
              "field": "Admin?",
              "value": "Yes",
              "concat": false
            },
            {
              "cmd": "show",
              "form": "Administration"
            }
          ],
          "else": [
            {
              "cmd": "show",
              "form": "AdminStart"
            }
          ]
        }
      ]
    },
    {
      "name": "Post_Questionnaire",
      "commands": [
        {
          "cmd": "comment",
          "text": "[object Object]"
        },
        {
          "cmd": "set",
          "field": "activeRecord",
          "value": "1",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "set",
          "field": "Questionnaire_Name:activeRecord",
          "value": "<<activeRecord>>",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "set",
          "field": "Questionnaire:activeRecord",
          "value": "<<activeRecord>>",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Questionnaire_Name:Admin?",
            "op": "doesNotEqual",
            "value": "Yes"
          },
          "then": [
            {
              "cmd": "showDocument",
              "document": "Questionnaire Done",
              "reset": false
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Questionnaire_Name:EmailAddress",
            "op": "doesNotEqual",
            "value": "No Notification"
          },
          "then": [
            {
              "cmd": "send",
              "to": {
                "fieldRef": "EmailAddress"
              },
              "subject": "Response to <<Customize_TitleText>>",
              "body": {
                "document": "Email Notification",
                "reset": false,
                "showHeader": true
              }
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Questionnaire_Name:Admin?",
            "op": "equals",
            "value": "Yes"
          },
          "then": [
            {
              "cmd": "comment",
              "text": "[object Object]"
            },
            {
              "cmd": "show",
              "form": "Administration"
            }
          ]
        }
      ]
    },
    {
      "name": "Pre-Administration",
      "commands": [
        {
          "cmd": "get",
          "recordList": "Settings",
          "sourceForms": [
            "AdminStart"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "Setting",
          "recordList": "Settings",
          "do": [
            {
              "cmd": "set",
              "field": "Customize_TitleText",
              "value": "<<Setting:AdminStart:TitleText>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_QuestionText",
              "value": "<<Setting:AdminStart:QuestionText>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "NumberOfChoices",
              "value": "<<Setting:AdminStart:NumberOfChoices>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice1",
              "value": "<<Setting:AdminStart:Choice1>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice2",
              "value": "<<Setting:AdminStart:Choice2>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice3",
              "value": "<<Setting:AdminStart:Choice3>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Choice4",
              "value": "<<Setting:AdminStart:Choice4>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "IncludeName",
              "value": "false",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "if",
              "condition": {
                "field": "Setting:AdminStart:AskForNames",
                "op": "mcEquals",
                "value": "a"
              },
              "then": [
                {
                  "cmd": "set",
                  "field": "IncludeName",
                  "value": "true",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ]
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:IncludeName",
            "op": "equals",
            "value": "true"
          },
          "then": [
            {
              "cmd": "showDocument",
              "document": "Results with Names",
              "reset": false
            },
            {
              "cmd": "showDocument",
              "document": "Excluded Names",
              "reset": false
            }
          ],
          "else": [
            {
              "cmd": "showDocument",
              "document": "Results",
              "reset": false
            }
          ]
        }
      ]
    },
    {
      "name": "Post-Administration",
      "commands": [
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:MCQ1",
            "op": "mcEquals",
            "value": "a"
          },
          "then": [
            {
              "cmd": "comment",
              "text": "[object Object]"
            },
            {
              "cmd": "show",
              "form": "AdminStart"
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:MCQ1",
            "op": "mcEquals",
            "value": "b"
          },
          "then": [
            {
              "cmd": "comment",
              "text": "[object Object]"
            },
            {
              "cmd": "set",
              "field": "Admin?",
              "value": "Yes",
              "concat": false
            },
            {
              "cmd": "if",
              "condition": {
                "field": "Administration:IncludeName",
                "op": "equals",
                "value": "true"
              },
              "then": [
                {
                  "cmd": "show",
                  "form": "Questionnaire_Name"
                }
              ]
            },
            {
              "cmd": "show",
              "form": "Questionnaire"
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:MCQ1",
            "op": "mcEquals",
            "value": "c"
          },
          "then": [
            {
              "cmd": "comment",
              "text": "[object Object]"
            },
            {
              "cmd": "show",
              "form": "Exclude Signatory"
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:MCQ1",
            "op": "mcEquals",
            "value": "d"
          },
          "then": [
            {
              "cmd": "comment",
              "text": "[object Object]"
            },
            {
              "cmd": "delete",
              "form": "Questionnaire",
              "from": "Questionnaire"
            },
            {
              "cmd": "delete",
              "form": "Questionnaire_Name",
              "from": "Questionnaire_Name"
