    {
      "name": "Main",
      "startPoint": false,
      "items": [
        {
          "type": "text",
          "label": "T1",
          "style": "normal",
          "content": "Mass Mailing to Confirmed Names"
        },
        {
          "type": "mc",
          "label": "Q1",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "Would you like to:",
          "choices": [
            {
              "label": "a",
              "text": "Send out the message"
            },
            {
              "label": "b",
              "text": "Edit message further"
            },
            {
              "label": "c",
              "text": "Abandon message"
            }
          ]
        }
      ],
      "themePath": "default",
      "process": "Process 1",
      "preProcess": "Process 2"
    }
  ],
  "processes": [
    {
      "name": "Process 1",
      "commands": [
        {
          "cmd": "if",
          "condition": {
            "field": "Main:Q1",
            "op": "mcEquals",
            "value": "b"
          },
          "then": [
            {
              "cmd": "show",
              "form": "Start"
            }
          ]
        },
        {
          "cmd": "set",
          "field": "Counter",
          "value": "0",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Main:Q1",
            "op": "mcEquals",
            "value": "a"
          },
          "then": [
            {
              "cmd": "get",
              "recordList": "Record List 1",
              "sourceForms": [
                "BBSharedEmailList"
              ],
              "where": {
                "field": "Record List 1:BBSharedEmailList:DisplayEmail",
                "op": "equals",
                "value": "<<Record List 1:BBSharedEmailList:DisplayEmail>>"
              }
            },
            {
              "cmd": "foreach",
              "recordName": "Record",
              "recordList": "Record List 1",
              "do": [
                {
                  "cmd": "set",
                  "field": "Counter",
                  "value": "<<Counter>> + 1",
                  "concat": false,
                  "arithmeticAsText": false
                },
                {
                  "cmd": "set",
                  "field": "First",
                  "value": "<<Record:BBSharedEmailList:First>>",
                  "concat": false,
                  "arithmeticAsText": false
                },
                {
                  "cmd": "send",
                  "to": {
                    "fieldRef": "Record:BBSharedEmailList:Email"
                  },
                  "subject": "<<Subject>>",
                  "body": {
                    "document": "EmailContent",
                    "reset": false,
                    "showHeader": true
                  }
                }
              ]
            },
            {
              "cmd": "showDocument",
              "document": "Report",
              "reset": false
            },
            {
              "cmd": "showDocument",
              "document": "EmailContent",
              "reset": false
            }
          ]
        }
      ]
    },
    {
      "name": "Process 2",
      "commands": [
        {
          "cmd": "get",
          "recordList": "Record List 3",
          "sourceForms": [
            "Start"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "Missive",
          "recordList": "Record List 3",
          "do": [
            {
              "cmd": "set",
              "field": "First",
              "value": "So-and-so",
              "concat": false,
              "arithmeticAsText": true
            },
            {
              "cmd": "set",
              "field": "Subject",
              "value": "<<Missive:Start:Q1:a>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "MainText",
              "value": "<<Missive:Start:Q2:a>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Close",
              "value": "<<Missive:Start:Q3:a>>",
              "concat": false,
              "arithmeticAsText": false
            }
          ]
        },
        {
          "cmd": "showDocument",
          "document": "EmailContent",
          "reset": false
        }
      ]
    },
    {
      "name": "Process 3",
      "commands": [
        {
          "cmd": "show",
          "form": "Main"
        }
      ]
    }
  ],
  "documents": [
