            }
          ]
        }
      ],
      "themePath": "basicblue",
      "process": "Post-Admin",
      "preProcess": "Post-Report"
    },
    {
      "name": "PickRecord",
      "startPoint": false,
      "items": [
        {
          "type": "text",
          "label": "T1",
          "style": "normal",
          "content": "<p><b>Here are the records that match </b><b><span class=\"field-token function-table-token\" contenteditable=\"false\" data-field-name=\"Target\" title=\"Target\" draggable=\"true\">&lt;&lt;Target&gt;&gt;</span></b><b>:</b></p><p></p><p><span><b><span class=\"function-token function-table-token\" contenteditable=\"false\" data-function-id=\"question-correlation-table\" data-function-instance=\"1\" data-function-config=\"{&quot;question-field-name&quot;:&quot;Questionnaire:Able&quot;,&quot;display-field-name&quot;:&quot;Questionnaire:Name&quot;,&quot;preferred-choice-field-name&quot;:&quot;Questionnaire:Preferred&quot;,&quot;conditionsRows&quot;:[{&quot;field&quot;:&quot;Questionnaire:Name&quot;,&quot;op&quot;:&quot;equals&quot;,&quot;value&quot;:&quot;&lt;&lt;Target&gt;&gt;&quot;}],&quot;conditionsCombinator&quot;:&quot;and&quot;}\" title=\"QUESTION CORRELATION TABLE\">&lt;&lt;QUESTION CORRELATION TABLE(Questionnaire:Able, Questionnaire:Name, Questionnaire:Preferred, Questionnaire:Name equals &lt;&lt;Target&gt;&gt;)&gt;&gt;</span></b></span></p>"
        },
        {
          "type": "mc",
          "label": "Q1",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "Delete:",
          "choices": [
            {
              "label": "a",
              "text": "All matching records"
            },
            {
              "label": "b",
              "text": "The first record"
            },
            {
              "label": "c",
              "text": "All but the first record"
            }
          ]
        }
      ],
      "themePath": "basicblue",
      "process": "Post-PickRecord"
    },
    {
      "name": "Update",
      "startPoint": false,
      "items": [
        {
          "type": "text",
          "label": "T1",
          "style": "normal",
          "content": "<p><b>A person named </b><b><span class=\"field-token function-table-token\" contenteditable=\"false\" data-field-name=\"Questionnaire:Name\" title=\"Questionnaire:Name\" draggable=\"true\">&lt;&lt;Questionnaire:Name&gt;&gt;</span></b><b> has already responded to this Questionnaire.</b></p>"
        },
        {
          "type": "mc",
          "label": "Q1",
          "onlyone": true,
          "required": false,
          "style": "vertical",
          "displayAs": "radio",
          "choiceSource": "manual",
          "question": "",
          "choices": [
            {
              "label": "a",
              "text": "I want to modify my previous response."
            },
            {
              "label": "b",
              "text": "I am a different person with a similar name."
            },
            {
              "label": "c",
              "text": "I had forgotten I'd already filled this out.  Please disregard this response."
            }
          ]
        }
      ],
      "themePath": "basicblue",
      "process": "Post-Update"
    }
  ],
  "processes": [
    {
      "name": "Pre-Questionnaire",
      "commands": [
        {
          "cmd": "comment",
          "text": "[object Object]"
        },
        {
          "cmd": "get",
          "recordList": "Settings",
          "sourceForms": [
            "Customize"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "Setting",
          "recordList": "Settings",
          "do": [
            {
              "cmd": "set",
              "field": "Customize_EventTitle",
              "value": "<<Setting:Customize:EventTitle>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_EventDescription",
              "value": "<<Setting:Customize:EventDescription>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date01",
              "value": "<<Setting:Customize:Date01>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date02",
              "value": "<<Setting:Customize:Date02>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date03",
              "value": "<<Setting:Customize:Date03>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date04",
              "value": "<<Setting:Customize:Date04>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date05",
              "value": "<<Setting:Customize:Date05>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date06",
              "value": "<<Setting:Customize:Date06>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date07",
              "value": "<<Setting:Customize:Date07>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date08",
              "value": "<<Setting:Customize:Date08>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date09",
              "value": "<<Setting:Customize:Date09>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date10",
              "value": "<<Setting:Customize:Date10>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Remarks",
              "value": "<<Setting:Customize:Remarks>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "ShowReportToUser",
              "value": "false",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "if",
              "condition": {
                "field": "Setting:Customize:PublicReport",
                "op": "mcEquals",
                "value": "b"
              },
              "then": [
                {
                  "cmd": "set",
                  "field": "ShowReportToUser",
                  "value": "true",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ]
            },
            {
              "cmd": "if",
              "condition": {
                "and": [
                  {
                    "field": "Setting:Customize:Q6",
                    "op": "mcEquals",
                    "value": "a"
                  },
                  {
                    "field": "Setting:Customize:AdminEmail",
                    "op": "isNotBlank"
                  }
                ]
              },
              "then": [
                {
                  "cmd": "set",
                  "field": "EmailNotify",
                  "value": "<<Setting:Customize:AdminEmail>>",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ],
              "else": [
                {
                  "cmd": "set",
                  "field": "EmailNotify",
                  "value": "No Notification",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Post-Customize",
      "commands": [
        {
          "cmd": "show",
          "form": "Customize"
        }
      ]
    },
    {
      "name": "Post-Questionnaire",
      "commands": [
        {
          "cmd": "get",
          "recordList": "Record List 4",
          "sourceForms": [
            "Questionnaire"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "Match",
          "recordList": "Record List 4",
          "do": [
            {
              "cmd": "if",
              "condition": {
                "field": "Match:Questionnaire:Name",
                "op": "equals",
                "value": "<<Questionnaire:Name>>"
              },
              "then": [
                {
                  "cmd": "show",
                  "form": "Update"
                }
              ]
            }
          ]
        },
        {
          "cmd": "showDocument",
          "document": "QuestionnaireComplete",
          "reset": false
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Questionnaire:ShowReportToUser",
            "op": "equals",
            "value": "true"
          },
          "then": [
            {
              "cmd": "showDocument",
              "document": "UserReportLink",
              "reset": false
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Questionnaire:EmailNotify",
            "op": "doesNotEqual",
            "value": "No Notification"
          },
          "then": [
            {
              "cmd": "send",
              "to": {
                "fieldRef": "EmailNotify"
              },
              "subject": "Response to <<Customize_EventTitle>> invitation",
              "body": {
                "document": "Notification",
                "reset": false,
                "showHeader": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pre-Customize",
      "commands": [
        {
          "cmd": "edit",
          "form": "Customize",
          "submit": "modify"
        }
      ]
    },
    {
      "name": "Post-Report",
      "commands": [
        {
          "cmd": "get",
          "recordList": "Settings",
          "sourceForms": [
            "Customize"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "Setting",
          "recordList": "Settings",
          "do": [
            {
              "cmd": "set",
              "field": "Customize_EventTitle",
              "value": "<<Setting:Customize:EventTitle>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date01",
              "value": "<<Setting:Customize:Date01>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date02",
              "value": "<<Setting:Customize:Date02>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date03",
              "value": "<<Setting:Customize:Date03>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date04",
              "value": "<<Setting:Customize:Date04>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date05",
              "value": "<<Setting:Customize:Date05>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date06",
              "value": "<<Setting:Customize:Date06>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date07",
              "value": "<<Setting:Customize:Date07>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date08",
              "value": "<<Setting:Customize:Date08>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date09",
              "value": "<<Setting:Customize:Date09>>",
              "concat": false,
              "arithmeticAsText": false
            },
            {
              "cmd": "set",
              "field": "Customize_Date10",
              "value": "<<Setting:Customize:Date10>>",
              "concat": false,
              "arithmeticAsText": false
            }
          ]
        },
        {
          "cmd": "comment",
          "text": "[object Object]"
        },
        {
          "cmd": "set",
          "field": "TotalResponses",
          "value": "0",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "get",
          "recordList": "ResponseList",
          "sourceForms": [
            "Questionnaire"
          ]
        },
        {
          "cmd": "foreach",
          "recordName": "Responses",
          "recordList": "ResponseList",
          "do": [
            {
              "cmd": "set",
              "field": "TotalResponses",
              "value": "<<TotalResponses>> + 1",
              "concat": false,
              "arithmeticAsText": false
            }
          ]
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:TotalResponses",
            "op": "equals",
            "value": "0"
          },
          "then": [
            {
              "cmd": "showDocument",
              "document": "No Responses",
              "reset": false
            }
          ],
          "else": [
            {
              "cmd": "showDocument",
              "document": "Report",
              "reset": false
            }
          ]
        }
      ]
    },
    {
      "name": "Post-Admin",
      "commands": [
        {
          "cmd": "set",
          "field": "Count",
          "value": "0",
          "concat": false,
          "arithmeticAsText": false
        },
        {
          "cmd": "if",
          "condition": {
            "field": "Administration:Name",
            "op": "isNotBlank"
          },
          "then": [
            {
              "cmd": "get",
              "recordList": "Record List 1",
              "sourceForms": [
                "Questionnaire"
              ],
              "where": {
                "field": "Record List 1:Questionnaire:Name",
                "op": "equals",
                "value": "<<Administration:Name>>"
              }
            },
            {
              "cmd": "foreach",
              "recordName": "Choice",
              "recordList": "Record List 1",
              "do": [
                {
                  "cmd": "set",
                  "field": "Count",
                  "value": "<<Count>> + 1",
                  "concat": false,
                  "arithmeticAsText": false
                },
                {
                  "cmd": "set",
                  "field": "Target",
                  "value": "<<Choice:Questionnaire:Name>>",
                  "concat": false,
                  "arithmeticAsText": false
                }
              ]
            },
            {
              "cmd": "if",
              "condition": {
                "field": "Administration:Count",
                "op": "equals",
                "value": "0"
              },
              "then": [
                {
                  "cmd": "showDocument",
                  "document": "NobodywthatName",
                  "reset": false
                }
              ]
            },
            {
              "cmd": "if",
              "condition": {
                "field": "Administration:Count",
                "op": "equals",
                "value": "1"
              },
              "then": [
                {
                  "cmd": "delete",
                  "form": "Questionnaire",
                  "from": "Questionnaire",
                  "where": {
                    "field": "Target",
                    "op": "equals",
                    "value": "<<Record:Questionnaire:Name>>"
                  }
                }
              ]
            },
            {
              "cmd": "if",
              "condition": {
                "field": "Administration:Count",
                "op": "isGreaterThan",
                "value": "1"
              },
              "then": [
                {
                  "cmd": "show",
                  "form": "PickRecord"
                }
              ]
            }
          ]
        },
        {
          "cmd": "show",
          "form": "Administration"
        }
      ]
