<fib label="Q15" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">6.  </font><blank label="a" length="20" required="false" alternateLabel="P6"/></paragraph></fib>
<fib label="Q16" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">7.  </font><blank label="a" length="20" required="false" alternateLabel="P7"/></paragraph></fib>
