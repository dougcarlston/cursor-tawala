<fib label="Q18" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">9.  </font><blank label="a" length="20" required="false" alternateLabel="P9"/></paragraph></fib>
<fib label="Q19" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">10.  </font><blank label="a" length="20" required="false" alternateLabel="P10"/></paragraph></fib>
<text label="T3" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press Submit to review your entries and to continue to payment section.</font></paragraph></text>
<skipInstructions>
<if>
<conditions>
<doesNotEqual field="Form 1:Email">
<string field="Form 1:EmailChk"/>
</doesNotEqual>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Email is blank or two versions are not the same."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Form 1:Gender" value="a"/>
</conditions>
<trueSet>
<set field="Sex" arithmeticAsText="false">
<string value="M"/>
</set>
</trueSet>
<falseSet>
<set field="Sex" arithmeticAsText="false">
<string value="F"/>
</set>
</falseSet>
</if>
<if>
<conditions>
<mcEquals field="Form 1:AgeGroup" value="a"/>
</conditions>
<trueSet>
<set field="Age" arithmeticAsText="true">
<string value="U-9"/>
</set>
</trueSet>
<falseSet>
<if>
<conditions>
<mcEquals field="Form 1:AgeGroup" value="b"/>
</conditions>
<trueSet>
<set field="Age" arithmeticAsText="true">
<string value="U-10"/>
</set>
</trueSet>
<falseSet>
<if>
<conditions>
<mcEquals field="Form 1:AgeGroup" value="c"/>
</conditions>
<trueSet>
<set field="Age" arithmeticAsText="true">
<string value="U-11"/>
</set>
</trueSet>
<falseSet>
<if>
<conditions>
<mcEquals field="Form 1:AgeGroup" value="d"/>
</conditions>
<trueSet>
<set field="Age" arithmeticAsText="true">
<string value="U-12"/>
</set>
</trueSet>
<falseSet>
<if>
<conditions>
<mcEquals field="Form 1:AgeGroup" value="e"/>
</conditions>
<trueSet>
<set field="Age" arithmeticAsText="true">
<string value="U-13"/>
</set>
</trueSet>
<falseSet>
<set field="Age" arithmeticAsText="true">
<string value="U-14"/>
</set>
</falseSet>
</if>
</falseSet>
</if>
</falseSet>
</if>
</falseSet>
</if>
</falseSet>
</if>
</skipInstructions>
