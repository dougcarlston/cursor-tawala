<items>
<text label="T1"><table indent="4620"><row><cell width="1380"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="Home"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/default.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="840"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="About"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/honoring-outstanding-educators-of-america.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="2700"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="News and Information"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/carlston-family-foundation-news/default.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="1335"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="Honorees"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/award-winning-teachers.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="1365"><division indent="0" align="right"><font color="000080"><u><invitation form="Nomination" project="">Nominate</invitation></u></font></division></cell><cell width="1155"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="Contact"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/contact-carlston-family-foundation/default.aspx"/>
</url>
</link>
</u></font></division></cell></row></table></text>
<text label="T2"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><image id="image2" width="894" height="327"><metafileHeader fileType="1" headerSize="9" version="768" fileSize="438887" numOfObjects="0" maxRecordSize="438865" numOfParams="0" />
</image></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="360"><b><i>Nominate a Life-changing Teacher</i></b></font></paragraph></text>
<text label="T3"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>The Carlston Family Foundation tries to find teachers who have had a profound, life-changing academic influence on their students and to provide for such teachers reward, recognition and a platform for their ideas to help shape the education environment of the California public school system.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="280"><b><i>Nominating Form</i></b></font></paragraph></text>
<text label="T4"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you have had a life-changing experience with a teacher, we'd like to hear about it.  We are looking for people whose lives have been turned around academically and who attribute that turnaround to an extraordinary individual.  If you are such a person, we'd like to hear your story.</font></paragraph></text>
<fib label="Q1" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Your name please: </font><blank label="a" length="22" required="false" alternateLabel="StudentFirst"/><sp/><font face="Arial" size="200" color="000000"><i>(first) </i></font><blank label="b" length="20" required="false" alternateLabel="StudentLast"/><sp/><font face="Arial" size="200" color="000000"><i>(last)</i></font></paragraph></fib>
<fib label="Q2" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email address: </font><blank label="a" length="53" required="false" alternateLabel="StudentEmail"/></paragraph></fib>
<fib label="Q3" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Phone number: </font><blank label="a" length="53" required="false" alternateLabel="StudentPhone"/></paragraph></fib>
<fib label="Q4" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Address: </font><blank label="a" length="53" required="false" alternateLabel="StudentAddress"/></paragraph></fib>
<fib label="Q5" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">                         City:   </font><blank label="a" length="21" required="false" alternateLabel="StudentCity"/><font face="Arial" size="200" color="000000"> State: </font><blank label="b" length="3" required="false" alternateLabel="StudentST"/><font face="Arial" size="200" color="000000"> Zip: </font><blank label="c" length="11" required="false" alternateLabel="StudentZip"/></paragraph></fib>
<text label="T5"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240"><b><i>Your nomination</i></b></font></paragraph></text>
<fib label="Q6" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Please tell us in your own words what made your experience with this teacher so special and life-changing.  Tell us about who you were before you met this teacher, who you became, and how this teacher made such a difference to you. </font><blank label="a" length="79" height="10" required="false" alternateLabel="StudentStory"/></paragraph></fib>
<fib label="Q7" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Specific examples of a teacher's teaching techniques and approaches to students are important to understanding what makes one particularly effective.  Share with us some specific examples of things this teacher did that made him or her such an effective teacher.  </font><blank label="a" length="79" height="10" required="false" alternateLabel="Techniques"/></paragraph></fib>
<text label="T6"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i><u>The Details</u></i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Here are the little details about both you and your former teacher that we need in order to consider this nomination.  Thank you for being as complete as possible.</font></paragraph></text>
<fib label="Q8" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Name of teacher you are nominating: </font><blank label="a" length="79" required="false" alternateLabel="TeacherName"/></paragraph></fib>
<fib label="Q9" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">What subject did he or she teach? </font><blank label="a" length="79" required="false" alternateLabel="TeacherSubject"/></paragraph></fib>
<fib label="Q10" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">What school did you attend when taught by this teacher? </font><blank label="a" length="79" required="false" alternateLabel="School"/></paragraph></fib>
<fib label="Q11" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">School district? </font><blank label="a" length="79" required="false" alternateLabel="District"/></paragraph></fib>
<fib label="Q12" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">In what years did you have this teacher? </font><blank label="a" length="79" required="false" alternateLabel="YearsTaught"/></paragraph></fib>
<mc label="Q13" alternateLabel="StillTeaching?" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">As far as you know, is your nominee still teaching?</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Yes</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">No</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">I'm not sure</font></paragraph></choice></mc>
<mc label="Q14" alternateLabel="StillThere?" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">As far as you know, is your nominee still at your old school?</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Yes</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">No</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">I'm not sure</font></paragraph></choice></mc>
<text label="T7"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i><u>And now a little more about you</u></i></font><font><i>...</i></font></paragraph></text>
<fib label="Q15" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Tell us about your academic life since high school, where you attended, dates, your major, accomplishments, degrees, etc. </font><blank label="a" length="79" height="10" required="false" alternateLabel="Student accomplishments"/></paragraph></fib>
<fib label="Q16" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">If you are no longer in school or spent some time doing other things, please tell us about them too. </font><blank label="a" length="79" height="10" required="false" alternateLabel="StudentProfession"/></paragraph></fib>
<fib label="Q17" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Finally, can you tell us about any special circumstances in your own life that made your academic success surprising or unusual? </font><blank label="a" length="79" height="10" required="false" alternateLabel="SpecialCircumstances"/></paragraph></fib>
<break/>
<text label="T8"><table indent="4620"><row><cell width="1380"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="Home"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/default.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="840"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="About"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/honoring-outstanding-educators-of-america.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="2700"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="News and Information"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/carlston-family-foundation-news/default.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="1335"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="Honorees"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/award-winning-teachers.aspx"/>
</url>
</link>
</u></font></division></cell><cell width="1365"><division indent="0" align="right"><font color="000080"><u><invitation form="Nomination" project="">Nominate</invitation></u></font></division></cell><cell width="1155"><division indent="0" align="right"><font color="000080"><u><link>
<description>
<string value="Contact"/>
</description>
<url>
<string value="http://www.carlstonfoundation.org/contact-carlston-family-foundation/default.aspx"/>
</url>
</link>
</u></font></division></cell></row></table></text>
<text label="T9"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Thank you!  We appreciate the time and effort you put into making this nomination.</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Tim Allen, Executive Director</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Carlston Family Foundation</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></text>
<fib label="Q18" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">May we ask how you heard of the Carlston Family Foundation? </font><blank label="a" length="79" height="3" required="false" alternateLabel="CFFConnection"/></paragraph></fib>
</items>
</form>
</forms>
