ision></cell><cell width="272"></cell><cell width="6165"><division indent="0" align="left"><font><field name="PSendPCDB"/></font></division></cell></row><row><cell width="4363"><division indent="0" align="right"><font>Email contributors in Supporter DB:</font></division></cell><cell width="272"></cell><cell width="6165"><division indent="0" align="left"><font><field name="PSendFinSDB"/></font></division></cell></row><row><cell width="4363"><division indent="0" align="right"><font>Email volunteers in Supporter DB:</font></division></cell><cell width="272"></cell><cell width="6165"><division indent="0" align="left"><font><field name="PSendVolSDB"/></font></division></cell></row><row><cell width="4363"><division indent="0" align="right"><font>Append polling qustions to emails:</font></division></cell><cell width="272"></cell><cell width="6165"><division indent="0" align="left"><font><field name="PAppendPoll"/></font></division></cell></row></table>
