<form name="ChangeFilterPolls" startPoint="false" themePath="lime" process="Post-ChangeFilterPolls" preProcess="Pre-ChangeFilterPolls" blockBackButton="false">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Change Poll Filter Settings</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="normal"><table indent="240"><row><cell width="1800"><division indent="0" align="left"><font color="000080"><b>Filter Settings:</b></font></division></cell><cell width="5655"><division indent="0" align="left"><font color="000080"><field name="Filter"/></font></division></cell></row><row><cell width="1800"></cell><cell width="5655"><division indent="0" align="left"><font color="000080"><field name="FilterSub"/></font></division></cell></row></table><paragraph indent="0" align="left"></paragraph><paragraph indent="0" align="left"><font color="000000"><i>Polling</i></font><font color="000080"><i> filters involve selecting voters based upon their responses to polls sent out via the Communicator.  You may use this section to add one or more filters to those you have already set up or by themselves.</i></font></paragraph><paragraph indent="0" align="left"></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add Poll Filter to existing filters </font><font face="Arial" size="200" color="000000"><i>(only records that match all filters will show)</i></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit current Poll Filter</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Remove current Poll Filter from overall filter</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="ChangeFilterPolls:Q1" value="c"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<mc label="Q2" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Filter records by response to following poll:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Communicator:ShortPollName"/>
<string value=" ("/>
<field name="Record:Communicator:PollQ"/>
<string value=")"/>
</display-expression><value-expression><field name="Record:Communicator:RefName4Poll"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="Communicator" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="ChangeFilterPolls2" startPoint="false" themePath="lime" process="ChangeFilterPolls2" blockBackButton="false">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Change Poll Filter Settings</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Please mark the response or responses you want </i></font><font><b><i>included</i></b></font><font><i> in your next communication:</i></font></paragraph></text>
<mc label="Q1" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><field name="Q"/></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><field name="A1"/></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><field name="A2"/></font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><field name="A3"/></font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><field name="A4"/></font></paragraph></choice></mc>
<mc label="Q2" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include those who failed to respond to poll as well</font></paragraph></choice></mc>
</items>
</form>
<form name="PollR1" startPoint="false" themePath="lime" process="Post-PollR" blockBackButton="false">
<items>
<skipInstructions>
<set field="Temp" arithmeticAsText="false">
<string value="a"/>
</set>
<skip to="__EndOfForm__"/>
</skipInstructions>
</items>
</form>
