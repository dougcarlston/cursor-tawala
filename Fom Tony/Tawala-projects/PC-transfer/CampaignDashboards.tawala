</set>
<set field="TempVal" arithmeticAsText="false">
<string field="LocCode"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="EditDBRecord1:Q3" value="b"/>
</conditions>
<trueSet>
