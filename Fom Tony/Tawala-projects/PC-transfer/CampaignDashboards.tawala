<document name="PollAppend">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="3390"><division indent="0" align="left"><font><b><field name="Ref"/></b></font><sp/><font color="000000"><i>(</i></font><font color="000000"><i><field name="Q"/></i></font><font color="000000">)</font></division></cell><cell width="210"></cell><cell width="1800"><division indent="0" align="left"><font><field name="A1"/></font></division></cell><cell width="1800"><division indent="0" align="left"><font><field name="A2"/></font></division></cell><cell width="1800"><division indent="0" align="left"><font><field name="A3"/></font></division></cell><cell width="1800"><division indent="0" align="left"><font><field name="A4"/></font></division></cell></row><row><cell width="3390"></cell><cell width="210"></cell><cell width="1800"><division indent="0" align="center"><font color="004000"><i><record-count version="3"><form-name>PollData</form-name><conditions><form name="PollData" /><conditions>
<and>
<equals field="Record:PollData:PollID">
<string field="QID"/>
</equals>
<equals field="Record:PollData:VoterResponse">
<string value="a"/>
</equals>
</and>
</conditions></conditions></record-count></i></font></division></cell><cell width="1800"><division indent="0" align="center"><font color="004000"><i><record-count version="3"><form-name>PollData</form-name><conditions><form name="PollData" /><conditions>
<and>
<equals field="Record:PollData:PollID">
<string field="QID"/>
</equals>
<equals field="Record:PollData:VoterResponse">
<string value="b"/>
</equals>
</and>
</conditions></conditions></record-count></i></font></division></cell><cell width="1800"><division indent="0" align="center"><font color="004000"><i><record-count version="3"><form-name>PollData</form-name><conditions><form name="PollData" /><conditions>
<and>
<equals field="Record:PollData:PollID">
<string field="QID"/>
</equals>
<equals field="Record:PollData:VoterResponse">
<string value="c"/>
</equals>
</and>
</conditions></conditions></record-count></i></font></division></cell><cell width="1800"><division indent="0" align="center"><font color="004000"><i><record-count version="3"><form-name>PollData</form-name><conditions><form name="PollData" /><conditions>
<and>
<equals field="Record:PollData:PollID">
<string field="QID"/>
</equals>
<equals field="Record:PollData:VoterResponse">
<string value="d"/>
</equals>
</and>
</conditions></conditions></record-count></i></font></division></cell></row></table>
</xmlData>
</document>
<document name="Data import outline">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Import Data</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>  Check/Add unique ID's</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Constituent Data</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>  Check data</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>  Merge import file to existing</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>     If commercial data - Add empty fields/overwrite non-voter data</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>     If voter data - overwrite all</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Let's have a post import utility where we create tables of cities, ethnicities, etc. so we have full lists of every attribute.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph>
</xmlData>
</document>
<document name="ManageDB">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="320"><b>Manage Database</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="Return to Dashboard"/>
</displayText></invitation></u></font></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2715"></cell><cell width="3075"></cell><cell width="3240"></cell></row><row><cell width="2715"><division indent="0" align="center"><font color="000080"><u><invitation form="Index Table Mgmt" project=""><displayText><string value="Manage Index Tables"/>
</displayText></invitation></u></font></division></cell><cell width="3075"><division indent="0" align="center"><font color="000080"><u><invitation form="ViewEditDB" project=""><displayText><string value="View/Edit records"/>
</displayText></invitation></u></font></division></cell><cell width="3240"><division indent="0" align="center"><font> Delete record(s)</font></division></cell></row><row><cell width="2715"></cell><cell width="3075"><division indent="0" align="center"><font>Import/Merge new records</font></division></cell><cell width="3240"></cell></row><row><cell width="2715"></cell><cell width="3075"></cell><cell width="3240"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="004000"><i>There are </i></font><font color="004000"><b><i><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /></conditions></record-count></i></b></font><font color="004000"><i> records in the database of which </i></font><font color="004000"><b><i><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<isBlank field="Record:DataBase:TableProcessed" />
</conditions></conditions></record-count></i></b></font><sp/><font color="004000"><i> still need to be indexed.</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="004000"><i>Indexing is the process of determining all of the unique values in every fields o make it easier to search and sort  records.  For example, an index of city names will only have a single instances of "Los Angeles" in its records, not one for each vote who lives in LA, as is the case in the main constituent database.</i></font></paragraph>
</xmlData>
</document>
<document name="ViewIndexTables">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="320">View Index Tables</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="45"><row><cell width="3375"><division indent="0" align="left"><font color="000080"><u><invitation form="Index Tables" project=""><displayText><string value="Return to Manage Index Tables"/>
</displayText></invitation></u></font></division></cell><cell width="3150"><division indent="0" align="left"><font color="000080"><u><invitation form="Manage DB" project=""><displayText><string value="Return to Manage Database"/>
</displayText></invitation></u></font></division></cell><cell width="3240"><division indent="0" align="left"><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="Return to Dashboard"/>
</displayText></invitation></u></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2422"><division indent="0" align="left"><font><b>Gender</b></font></division><division indent="0" align="left"><font><simple-list version="2"><simple-list-field>Record:Index Tables:Genders</simple-list-field><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Genders" />
</conditions></conditions></simple-list></font></division></cell><cell width="2422"><division indent="0" align="left"><font><b>Religions</b></font></division><division indent="0" align="left"><font><simple-list version="2"><simple-list-field>Record:Index Tables:Religions</simple-list-field><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Religions" />
</conditions></conditions></simple-list></font></division></cell><cell width="2422"><division indent="0" align="left"><font><b>Ethnicities</b></font></division><division indent="0" align="left"><font><simple-list version="2"><simple-list-field>Record:Index Tables:Ethnicities</simple-list-field><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Ethnicities" />
</conditions></conditions></simple-list></font></division></cell><cell width="2422"><division indent="0" align="left"><font><b>Political Parties</b></font></division><division indent="0" align="left"><font><simple-list version="2"><simple-list-field>Record:Index Tables:Parties</simple-list-field><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Parties" />
</conditions></conditions></simple-list></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>The following can be sorted by clicking on the  heading:</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="Cities"/>
</header><contents><field name="Record:Index Tables:Cities" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Cities" />
</conditions></conditions></itemization-table></font></division></cell><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="Zip Codes"/>
</header><contents><field name="Record:Index Tables:Zips" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Zips" />
</conditions></conditions></itemization-table></font></division></cell></row><row><cell width="5400"><division indent="0" align="left"><sp/></division></cell><cell width="5400"></cell></row><row><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="Area Codes"/>
</header><contents><field name="Record:Index Tables:AreaCodes" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:AreaCodes" />
</conditions></conditions></itemization-table></font></division></cell><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="St House Dists"/>
</header><contents><field name="Record:Index Tables:StateHouseDists" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:StateHouseDists" />
</conditions></conditions></itemization-table></font></division></cell></row><row><cell width="5400"><division indent="0" align="left"><sp/></division></cell><cell width="5400"></cell></row><row><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="Exchanges"/>
</header><contents><field name="Record:Index Tables:Exchanges" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Exchanges" />
</conditions></conditions></itemization-table></font></division></cell><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="Precincts"/>
</header><contents><field name="Record:Index Tables:Precincts" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Precincts" />
</conditions></conditions></itemization-table></font></division></cell></row><row><cell width="5400"><division indent="0" align="left"><sp/></division></cell><cell width="5400"></cell></row><row><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="St Senate Dists"/>
</header><contents><field name="Record:Index Tables:StateSenateDists" /></contents></column><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:StateSenateDists" />
</conditions></conditions></itemization-table></font></division></cell><cell width="5400"><division indent="0" align="left"><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="Congress Dists"/>
