<process name="Post-Database">
<if>
<conditions>
<isBlank field="DataBase:Reg_ID" />
</conditions>
<trueSet>
<get recordList="Record List 10">
<forms>
<form name="Setup"/>
</forms>
</get>
<foreach record="Seed" recordList="Record List 10">
<set field="SeedNo" arithmeticAsText="false">
<add>
<operand field="Seed:Setup:IDSeed"/>
<operand value="1"/>
</add>
</set>
<set field="Seed:Setup:IDSeed" arithmeticAsText="false">
<string field="SeedNo"/>
</set>
</foreach>
<set field="DataBase:Reg_ID" arithmeticAsText="false">
<string field="DataBase:Last Name"/>
<string field="SeedNo"/>
</set>
</trueSet>
</if>
<show form="DataBase"/>
</process>
<process name="Post-PollR">
<show form="PollData"/>
</process>
<process name="post-PollData">
<get recordList="Record List 12">
<forms>
<form name="DataBase"/>
</forms>
<conditions>
<contains field="_InviteeID">
<string field="Record List 12:DataBase:Reg_ID"/>
</contains>
</conditions></get>
<foreach record="SuchPerson" recordList="Record List 12">
<set field="Voter" arithmeticAsText="false">
<string field="SuchPerson:DataBase:Reg_ID"/>
</set>
</foreach>
<get recordList="Record List 13">
<forms>
<form name="Communicator"/>
</forms>
<conditions>
<beginsWith field="_InviteeID">
<string field="Record List 13:Communicator:RefName4Poll"/>
</beginsWith>
</conditions></get>
<foreach record="SuchQuery" recordList="Record List 13">
<set field="PollReferenceNo" arithmeticAsText="false">
<string field="SuchQuery:Communicator:RefName4Poll"/>
</set>
<set field="Message" arithmeticAsText="false">
<string field="SuchQuery:Communicator:Thanks"/>
</set>
</foreach>
<set field="Dupe" arithmeticAsText="false">
<string value="False"/>
</set>
<get recordList="Record List 16">
<forms>
<form name="PollData"/>
</forms>
<conditions>
<and>
<equals field="Record List 16:PollData:VoterID">
<string field="Voter"/>
</equals>
<equals field="Record List 16:PollData:PollID">
<string field="PollNo"/>
</equals>
</and>
</conditions></get>
<foreach record="Result" recordList="Record List 16">
<set field="Dupe" arithmeticAsText="false">
<string value="True"/>
</set>
</foreach>
<if>
<conditions>
<equals field="Dupe">
<string value="False"/>
</equals>
</conditions>
<trueSet>
<set field="PollData:PollID" arithmeticAsText="false">
<string field="PollReferenceNo"/>
</set>
<set field="PollData:VoterID" arithmeticAsText="false">
<string field="Voter"/>
</set>
<set field="PollData:VoterResponse" arithmeticAsText="false">
<string field="Temp"/>
</set>
<comment>Note: The variable "Temp" is set in the Skip commands of Forms PollR1-4</comment>
<show document="Message" reset="false"/>
</trueSet>
<falseSet>
<set field="PollData:VoterID" arithmeticAsText="false">
<string value="Delete"/>
</set>
<set field="Message" arithmeticAsText="false">
<string value="Our records show that you have already answered this poll."/>
</set>
<show document="Message" reset="false"/>
</falseSet>
</if>
<delete><form name="PollData"/><conditions>
<equals field="Record:PollData:VoterID">
<string value="Delete"/>
</equals>
</conditions></delete>
</process>
<process name="Post-ViewPollReports">
<delete><form name="PollData"/><conditions>
<equals field="Record:PollData:VoterID">
<string value="Delete"/>
</equals>
</conditions></delete>
<get recordList="Record List 14">
<forms>
<form name="Communicator"/>
</forms>
<conditions>
<isNotBlank field="Record List 14:Communicator:ShortPollName" />
</conditions></get>
<foreach record="Question" recordList="Record List 14">
<set field="Ref" arithmeticAsText="false">
<string field="Question:Communicator:ShortPollName"/>
</set>
<set field="Q" arithmeticAsText="false">
<string field="Question:Communicator:PollQ"/>
</set>
<set field="A1" arithmeticAsText="false">
<string field="Question:Communicator:R1"/>
</set>
<set field="A2" arithmeticAsText="false">
<string field="Question:Communicator:R2"/>
</set>
<set field="A3" arithmeticAsText="false">
<string field="Question:Communicator:R3"/>
</set>
<set field="A4" arithmeticAsText="false">
<string field="Question:Communicator:R4"/>
</set>
<set field="QID" arithmeticAsText="false">
<string field="Question:Communicator:RefName4Poll"/>
</set>
<append document="Poll Report" appendage="PollAppend"/>
</foreach>
<show document="Poll Report" reset="true"/>
</process>
<process name="Post-PollManagement">
<delete><form name="Communicator"/><conditions>
<equals field="Record:Communicator:RefName4Poll">
<string value="0"/>
</equals>
</conditions></delete>
<if>
<conditions>
<mcEquals field="PollManagement:Q1" value="a"/>
</conditions>
<trueSet>
<show form="ViewPollReports"/>
</trueSet>
</if>
<if>
<conditions>
<or>
<mcEquals field="PollManagement:Q1" value="b"/>
<mcEquals field="PollManagement:Q1" value="c"/>
</or>
</conditions>
<trueSet>
<if>
<conditions>
<mcEquals field="PollManagement:Q1" value="c"/>
</conditions>
<trueSet>
<if>
<conditions>
<mcEquals field="PollManagement:Q3" value="a"/>
</conditions>
<trueSet>
<delete><form name="PollData"/><conditions>
<equals field="Record:PollData:PollID">
<string field="PollManagement:Q2"/>
</equals>
</conditions></delete>
</trueSet>
<falseSet>
<show form="PollManagement"/>
</falseSet>
</if>
</trueSet>
</if>
<set field="From" arithmeticAsText="false">
<string value="Resend"/>
</set>
<edit form="Communicator" submit="modify">
<conditions>
<equals field="Record:Communicator:RefName4Poll">
<string field="PollManagement:Q2"/>
</equals>
</conditions>
</edit>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="PollManagement:Q1" value="d"/>
</conditions>
<trueSet>
<delete><form name="Communicator"/><conditions>
<equals field="Record:Communicator:RefName4Poll">
<string field="PollManagement:Q2"/>
</equals>
</conditions></delete>
<set field="Message" arithmeticAsText="false">
<string value="Poll deleted."/>
</set>
<show document="Message" reset="false"/>
</trueSet>
</if>
<show form="PollManagement"/>
</process>
