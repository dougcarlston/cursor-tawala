<set field="ChosenOne:DataBase:Phone_number" arithmeticAsText="false">
<string field="EditDBRecord1:Num"/>
</set>
</trueSet>
</if>
<comment>Set Phone to "(&lt;&lt;ChosenOne:DataBase:Phone_Area_Code&gt;&gt;)  &lt;&lt;ChosenOne:DataBase:Phone_exchange_code&gt;&gt;-&lt;&lt;ChosenOne:DataBase:Phone_number&gt;&gt;</comment>
<set field="Phone" arithmeticAsText="true">
<string value="("/>
<string field="ChosenOne:DataBase:Phone_area_code"/>
<string value=") "/>
<string field="ChosenOne:DataBase:Phone_exchange_code"/>
<string value="-"/>
<string field="ChosenOne:DataBase:Phone_number"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="EditDBRecord1:Q3" value="f"/>
</conditions>
<trueSet>
<if>
<conditions>
<isNotBlank field="EditDBRecord1:MAddress1" />
</conditions>
<trueSet>
<set field="ChosenOne:DataBase:Maddr1" arithmeticAsText="false">
<string field="EditDBRecord1:MAddress1"/>
</set>
<set field="MailAddress" arithmeticAsText="false">
<string field="ChosenOne:DataBase:Maddr1"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="EditDBRecord1:Maddress2" />
</conditions>
<trueSet>
<set field="ChosenOne:DataBase:Maddr2" arithmeticAsText="false">
<string field="EditDBRecord1:Maddress2"/>
</set>
<set field="MailAddress1" arithmeticAsText="false">
<string field="ChosenOne:DataBase:Maddr2"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="EditDBRecord1:MCity" />
</conditions>
<trueSet>
<set field="ChosenOne:DataBase:mcity" arithmeticAsText="false">
<string field="EditDBRecord1:MCity"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="EditDBRecord1:MState" />
</conditions>
<trueSet>
<set field="ChosenOne:DataBase:mstate" arithmeticAsText="false">
<string field="EditDBRecord1:MState"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="EditDBRecord1:MZIP" />
</conditions>
<trueSet>
<set field="ChosenOne:DataBase:mzip" arithmeticAsText="false">
<string field="EditDBRecord1:MZIP"/>
</set>
</trueSet>
</if>
<set field="MailAddress2" arithmeticAsText="false">
<string field="ChosenOne:DataBase:mcity"/>
<string value=", "/>
<string field="ChosenOne:DataBase:mstate"/>
<string value=" "/>
<string field="ChosenOne:DataBase:mzip"/>
</set>
<set field="Message" arithmeticAsText="false">
<string value="Mailing address changed."/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="EditDBRecord1:EmailChange" />
</conditions>
<trueSet>
<set field="ChosenOne:DataBase:email" arithmeticAsText="false">
<string field="EditDBRecord1:EmailChange"/>
</set>
<comment>Set EmailAdd to EditDBRecord1:EmailChange</comment>
<set field="EmailAdd" arithmeticAsText="false">
<string field="EditDBRecord1:EmailChange"/>
</set>
<set field="Message" arithmeticAsText="false">
<string value="Email address changed."/>
</set>
</trueSet>
</if>
</trueSet>
</if>
</foreach>
<show form="EditDBRecord1"/>
</process>
</processes>
