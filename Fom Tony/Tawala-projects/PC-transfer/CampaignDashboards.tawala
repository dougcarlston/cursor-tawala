<string value="On"/>
</equals>
</conditions>
<trueSet>
<comment>Age Parameter</comment>
<if>
<conditions>
<equals field="PItemAge">
<string value="On"/>
</equals>
</conditions>
<trueSet>
<set field="VoterAge" arithmeticAsText="false">
<sub>
