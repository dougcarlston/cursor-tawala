</displayText></invitation></u></font></division></cell><cell width="2790"><division indent="0" align="center"><font color="000080"><u><invitation form="Manage DB" project=""><displayText><string value="Manage Data"/>
</displayText></invitation></u></font></division></cell><cell width="2160"><division indent="0" align="center"><font color="000080"><u><invitation form="PollManagement" project=""><displayText><string value="Manage Polls"/>
</displayText></invitation></u></font></division></cell><cell width="3025"><division indent="0" align="center"><font color="000080"><u><invitation form="Communicator" project=""><displayText><string value="Communicator"/>
