<skip to="__EndOfForm__"/>
</skipInstructions>
</items>
</form>
<form name="PollManagement" startPoint="false" themePath="lime" process="Post-PollManagement" blockBackButton="false">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Poll Management</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="Return to Dashboard"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Note: Polls are built in the Communicator as part of an email mailing.  To create a poll, </font><font><u><invitation form="Communicator" project=""><displayText><string value="click here."/>
</displayText></invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>This application can only create polls containing a single multiple-choice question with no more than four possible responses.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you wish to review individual responses to a particular poll, that is done from View/Edit Database records.  To go there, </font><font color="000080"><u><invitation form="ViewEditDB" project=""><displayText><string value="click here."/>
</displayText></invitation></u></font></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">View Polls</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Resend Poll without purging current results</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Resend Poll after purging current results</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Delete Poll from records</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="PollManagement:Q1" value="a"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="PollManagement:Q1" value="d"/>
</conditions>
<trueSet>
<set field="Temp" arithmeticAsText="false">
<string value="delete"/>
</set>
</trueSet>
<falseSet>
<set field="Temp" arithmeticAsText="false">
<string value="resend"/>
</set>
</falseSet>
</if>
</skipInstructions>
<mc label="Q2" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Please select the poll you wish to </font><font face="Arial" size="200" color="000000"><field name="Temp"/></font><font face="Arial" size="200" color="000000">:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Communicator:ShortPollName"/>
<string value=" ("/>
<field name="Record:Communicator:PollQ"/>
<string value=")"/>
</display-expression><value-expression><field name="Record:Communicator:RefName4Poll"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="Communicator" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q3" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Are you sure you want to purge all current results?  All past data for this poll will be lost!</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Yes, go ahead</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">No, I changed my mind.</font></paragraph></choice><displayConditions>
<mcEquals field="PollManagement:Q1" value="c"/>
</displayConditions></mc>
</items>
</form>
</forms>
<processes>
<process name="Pre-AdminDash">
<get recordList="Record List 1">
<forms>
<form name="Setup"/>
</forms>
</get>
<foreach record="SetupRecord" recordList="Record List 1">
<set field="Start" arithmeticAsText="false">
<string value="No"/>
</set>
</foreach>
<if>
<conditions>
<doesNotEqual field="Start">
<string value="No"/>
</doesNotEqual>
</conditions>
<trueSet>
<show form="Setup"/>
</trueSet>
</if>
<get recordList="Record List 2">
<forms>
<form name="Setup"/>
</forms>
</get>
<foreach record="Item" recordList="Record List 2">
<set field="AdName" arithmeticAsText="false">
<string field="Item:Setup:AdminName"/>
</set>
<set field="AdEmail" arithmeticAsText="false">
<string field="Item:Setup:AdminEmail"/>
</set>
<set field="AdPhone" arithmeticAsText="false">
<string field="Item:Setup:AdminPhone"/>
</set>
<set field="AdPass" arithmeticAsText="false">
<string field="Item:Setup:AdminPass"/>
</set>
<set field="Candidate" arithmeticAsText="false">
<string field="Item:Setup:Canddate"/>
</set>
<set field="CampName" arithmeticAsText="false">
<string field="Item:Setup:CampaignNm"/>
</set>
<set field="CampPhone" arithmeticAsText="false">
<string field="Item:Setup:CampaignPh"/>
</set>
<set field="CampURL" arithmeticAsText="false">
<string field="Item:Setup:CampaignURL"/>
</set>
<set field="CampStreet" arithmeticAsText="false">
<string field="Item:Setup:CampaignStreet"/>
</set>
<set field="CampCity" arithmeticAsText="false">
<string field="Item:Setup:CampaignCity"/>
</set>
<set field="CampState" arithmeticAsText="false">
<string field="Item:Setup:CampaignST"/>
</set>
<set field="CampZIP" arithmeticAsText="false">
<string field="Item:Setup:CampaignZip"/>
</set>
<set field="ElecName" arithmeticAsText="false">
<string field="Item:Setup:Election"/>
</set>
<set field="ElecDate" arithmeticAsText="true">
<string field="Item:Setup:ElecMo"/>
<string value="/"/>
<string field="Item:Setup:ElecDay"/>
<string value="/"/>
<string field="Item:Setup:ElecYr"/>
</set>
<set field="ElectionYr" arithmeticAsText="false">
<string field="Item:Setup:ElecYr"/>
</set>
<set field="ElectionMo" arithmeticAsText="false">
<string field="Item:Setup:ElecMo"/>
</set>
<set field="ElectionDay" arithmeticAsText="false">
<string field="Item:Setup:ElecDay"/>
</set>
<if>
<conditions>
<mcEquals field="Item:Setup:Mgmt" value="a"/>
</conditions>
<trueSet>
<set field="Manage" arithmeticAsText="false">
<string value="Single Manager &amp; Dashboard"/>
</set>
</trueSet>
<falseSet>
<set field="Manage" arithmeticAsText="false">
<string value="Multiple Managers &amp; Dashboards"/>
</set>
</falseSet>
</if>
</foreach>
<get recordList="Record List 3">
<forms>
<form name="Setup"/>
</forms>
</get>
<foreach record="OptionalQ" recordList="Record List 3">
<if>
<conditions>
<mcContains field="OptionalQ:Setup:Q6" value="a"/>
</conditions>
<trueSet>
<set field="QTitle" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcContains field="OptionalQ:Setup:Q7" value="a"/>
</conditions>
<trueSet>
<set field="QEmail2" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcContains field="OptionalQ:Setup:Q8" value="a"/>
</conditions>
<trueSet>
<set field="QWorkPh" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcContains field="OptionalQ:Setup:Q9" value="a"/>
</conditions>
<trueSet>
<set field="QHomePh" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcContains field="OptionalQ:Setup:Q10" value="a"/>
</conditions>
<trueSet>
<set field="QCellPh" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
