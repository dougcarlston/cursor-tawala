<text label="T16" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Current Address:</b></font><sp/><tab/><font><field name="Address"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font><field name="Address1"/></font><tab/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Change to: </font><font><i>(leave field blank if you don't wish to change it)</i></font></paragraph></text>
<fib label="Q6" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Street: </font><blank label="a" length="20" required="false" alternateLabel="StName"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">City: </font><blank label="b" length="20" required="false" alternateLabel="Cityname"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">State: </font><blank label="c" length="20" required="false" alternateLabel="STName"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Zip: </font><blank label="d" length="20" required="false" alternateLabel="ZipName"></blank></paragraph></fib>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<heading label="H7" alternateLabel="Phone" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Edit single record</font></paragraph></heading>
<text label="T17" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="EditDBRecord1" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T18" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Current phone number:</b></font><sp/><font><field name="Phone"/></font></paragraph></text>
<fib label="Q7" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Change to:  </font><tab/><font face="Arial" size="200" color="000000">(</font><blank label="a" length="5" required="false" alternateLabel="Area"></blank><font face="Arial" size="200" color="000000">)  </font><blank label="b" length="6" required="false" alternateLabel="Exch"></blank><font face="Arial" size="200" color="000000"> - </font><blank label="c" length="8" required="false" alternateLabel="Num"></blank></paragraph></fib>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<heading label="H8" alternateLabel="MailAddrss" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Edit single record</font></paragraph></heading>
<text label="T19" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="EditDBRecord1" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T20" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Current mail address:</b></font><sp/><tab/><font><field name="MailAddress"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font><field name="MailAddress1"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font><field name="MailAddress2"/></font><tab/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/><tab/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Change to:  </font><font><i>(leave field blank if you don't wish to change it)</i></font></paragraph></text>
<fib label="Q8" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Mail Address1: </font><blank label="a" length="20" required="false" alternateLabel="MAddress1"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Mail Address2: </font><blank label="b" length="20" required="false" alternateLabel="Maddress2"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">City: </font><blank label="c" length="20" required="false" alternateLabel="MCity"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">State: </font><blank label="d" length="20" required="false" alternateLabel="MState"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Zip: </font><blank label="e" length="20" required="false" alternateLabel="MZIP"></blank></paragraph></fib>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<heading label="H9" alternateLabel="EmailAdd" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Edit single record</font></paragraph></heading>
<text label="T21" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="EditDBRecord1" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T22" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Current Email address</b></font><font>:</font><font><field name="EmailAdd"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Change to:  </font><font><i>(leave field blank if you don't wish to change it)</i></font></paragraph></text>
<fib label="Q9" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="20" required="false" alternateLabel="EmailChange"><validator><email-validator version="1"><error-message><string value="This email is not valid."/>
</error-message></email-validator></validator></blank></paragraph></fib>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T23" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Add edits for T3, T4, T5 and T6</font></paragraph></text>
</items>
</form>
<form name="Index Table Mgmt" startPoint="false" themePath="lime" process="Post-Index Table Mgmt" blockBackButton="false">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Manage Index Tables</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="cancel and return to Manage Database"/>
</displayText></invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="cancel and return to Dashboard"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you have new data in the database and have not indexed it or if you see the same value appearing in inappropriate places, you should re-index the data.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you see values that don't appear in the data (for example, residences in New York in a California database), you will need to delete the current index tables before proceeding.</font></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Review current Index Tables</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Index any new records in the database and add results to Index Tables</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Delete the current Index Tables and then index all records in the database</font></paragraph></choice></mc>
</items>
</form>
<form name="Index Tables" startPoint="false" themePath="lime" process="Post-Index Tables" blockBackButton="false">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<field name="Genders"/>
<field name="Religions"/>
<field name="Ethnicities"/>
<field name="Parties"/>
<field name="Cities"/>
<field name="Zips"/>
<field name="AreaCodes"/>
<field name="Exchanges"/>
<field name="Precincts"/>
<field name="SD1s"/>
<field name="SD2s"/>
<field name="StateHouseDists"/>
<field name="StateSenateDists"/>
<field name="CongressionalDists"/>
</items>
</form>
<form name="XManageSDB" startPoint="false" themePath="lime" process="Post-ManageSDB" blockBackButton="false">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Manage Supporter Database</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="AdminDash" project=""><displayText><string value="Return to Dashboard"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="error"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Snapshot table showing total contributors to this campaign, total potential contributors (if contributors to other campaigns have been added), and total volunteers</font></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Merge data from import file into Supporter Database</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit or delete record or a group of records</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add, edit or delete contribution </font><font face="Arial" size="200" color="000000"><b>data</b></font><font face="Arial" size="200" color="000000"> in Supporter Database</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add, edit or delete volunteer </font><font face="Arial" size="200" color="000000"><b>field</b></font><font face="Arial" size="200" color="000000"> in Supporter Database</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add, edit or delete volunteer </font><font face="Arial" size="200" color="000000"><b>data</b></font><font face="Arial" size="200" color="000000"> in Supporter Database</font></paragraph></choice></mc>
</items>
</form>
<form name="XListTools" startPoint="false" themePath="lime" process="Post-ListTools" blockBackButton="false">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">List-building Tools</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>There are a number of basic tools for augmenting your voter lists with emails, which makes those lists far more useful to you (and less expensive to communicate with). </font></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Commercial Email lists</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Petitions</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Phone trees</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Facebook, LinkedIn, Plaxo, Twitter fishing</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Other viral techniques</font></paragraph></choice></mc>
</items>
</form>
<form name="Communicator" startPoint="false" themePath="lime" dataEntryOnly="true" process="Post-Communicator" preProcess="Pre-Communicator" blockBackButton="false">
<items>
<skipInstructions>
<if>
<conditions>
<equals field="From">
<string value="SetFilter"/>
</equals>
</conditions>
<trueSet>
<set field="From" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="Communicator:Q1" arithmeticAsText="false">
<string field="SaveQ1"/>
</set>
<skip to="H2"/>
</trueSet>
</if>
</skipInstructions>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Communicator</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Please compose the letter you wish to accompany the poll you are resending.</font></paragraph><displayConditions>
<equals field="From">
<string value="Resend"/>
</equals>
</displayConditions></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send communication to </font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Voters in Constituent Database</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Supporters or volunteers in Supporter Database</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Potential supporters or voters in Import File</font></paragraph></choice></mc>
<skipInstructions>
<set field="SaveQ1" arithmeticAsText="false">
<string field="Communicator:Q1"/>
</set>
<if>
<conditions>
<mcEquals field="Communicator:Q1" value="a"/>
</conditions>
<trueSet>
<set field="ComNav" arithmeticAsText="false">
<string value="Constituent Database"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Communicator:Q1" value="b"/>
</conditions>
<trueSet>
<set field="ComNav" arithmeticAsText="false">
<string value="Supporter Database"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Communicator:Q1" value="c"/>
</conditions>
<trueSet>
<set field="ComNav" arithmeticAsText="false">
<string value="Import File"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcIsBlank field="Communicator:Q1" />
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<heading label="H2" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Send email to </font><font face="Arial" size="360" color="000000"><field name="ComNav"/></font><sp/></paragraph></heading>
<text label="T3" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T4" style="instructional"><table indent="240"><row><cell width="2485"></cell><cell width="200"></cell><cell width="6825"><division indent="0" align="center"><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="change filter settings"/>
</displayText></invitation></u></font></division></cell></row><row><cell width="2485"><division indent="0" align="right"><font color="000080"><i>Current filter settings:</i></font></division></cell><cell width="200"></cell><cell width="6825"><division indent="0" align="left"><font color="000080"><field name="Filter"/></font></division></cell></row><row><cell width="2485"><division indent="0" align="right"><font color="000080"><i>Subfilter:</i></font></division></cell><cell width="200"></cell><cell width="6825"><division indent="0" align="left"><font color="000080"><field name="FilterSub"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000"><i>(</i></font><font color="000080"><i>Current filter would select: </i></font><font color="000080"><i><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<equals field="Record:DataBase:IncludedByFilter?">
<string value="Include"/>
</equals>
</conditions></conditions></record-count></i></font><font color="000080"><i> of </i></font><font color="000080"><i><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /></conditions></record-count></i></font><font color="000080"><i> Constituent Records)</i></font></paragraph><displayConditions>
<mcDoesNotEqual field="Communicator:Q1" value="c"/>
</displayConditions></text>
<mc label="Q2" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send email to everyone in </font><font face="Arial" size="200" color="000000"><field name="ComNav"/></font><sp/></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send email only to those that match filter criteria</font></paragraph></choice></mc>
<fib label="Q3" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>From:</b></font><sp/><font face="Arial" size="200" color="000000"><i>(Name)</i></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="20" required="false" alternateLabel="FromName"></blank></paragraph></fib>
<fib label="Q4" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>From:</b></font><sp/><font face="Arial" size="200" color="000000"><i>(Email)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="FromEmail"></blank></paragraph></fib>
<fib label="Q5" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Subject:</b></font><sp/><blank label="a" length="20" required="false" alternateLabel="Subject"></blank></paragraph></fib>
<mc label="Q6" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Salutation:</b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include first name salutation </font><font face="Arial" size="200" color="000000"><i>(Dear Joe,)</i></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Omit any salutation</font></paragraph></choice></mc>
<fib label="Q7" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Body of Message:</b></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="52" height="10" required="false" alternateLabel="Body"></blank></paragraph></fib>
<fib label="Q8" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Closing:</b></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="52" height="5" required="false" alternateLabel="Close"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></fib>
<mc label="Q9" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add poll to email</font></paragraph></choice></mc>
<mc label="Q10" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add a financial contribution button to email</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<and>
<mcDoesNotContain field="Communicator:Q9">
<string value="a"/>
</mcDoesNotContain>
<mcDoesNotContain field="Communicator:Q10" value="a"/>
</and>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
<if>
<conditions>
<mcDoesNotContain field="Communicator:Q9" value="a"/>
</conditions>
<trueSet>
<skip to="H4"/>
</trueSet>
</if>
</skipInstructions>
<heading label="H3" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Add a poll to message</font></paragraph></heading>
<text label="T5" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SortDashboardReturns" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<fib label="Q11" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Enter a short identifier to permit you to reference this poll question in the future:</b></font><sp/><blank label="a" length="20" required="false" alternateLabel="ShortPollName"></blank></paragraph></fib>
<fib label="Q12" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Enter multiple-choice response poll question:</b></font><sp/><blank label="a" length="52" height="2" required="false" alternateLabel="PollQ"></blank></paragraph></fib>
<fib label="Q13" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Enter up to four possible poll responses:</b></font><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="52" required="false" alternateLabel="R1"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="b" length="52" required="false" alternateLabel="R2"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="c" length="52" required="false" alternateLabel="R3"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="d" length="52" required="false" alternateLabel="R4"></blank></paragraph></fib>
<mc label="Q14" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Place the poll between message body and closing</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Place the poll after message close</font></paragraph></choice></mc>
<fib label="Q15" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Enter content of thank you note to be read after one has taken poll:</b></font><sp/><blank label="a" length="52" height="5" required="false" alternateLabel="Thanks"></blank></paragraph></fib>
<skipInstructions>
<if>
<conditions>
<mcDoesNotContain field="Communicator:Q10" value="a"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<heading label="H4" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Add financial contribution link to message</font></paragraph></heading>
<fib label="Q16" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Enter text to appear immediately before "Contribute" button:</b></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="52" height="10" required="false" alternateLabel="DonationText"></blank></paragraph></fib>
<mc label="Q17" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Place between message body and closing</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Place after message close</font></paragraph></choice></mc>
<field name="RefName4Poll"/>
</items>
</form>
<form name="CommunicatorSend" startPoint="false" themePath="lime" process="Post-CommunicatorSend" blockBackButton="false">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Review Message and Send</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>This what your message will look like:</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="330"><row><cell width="2055"><division indent="0" align="right"><font><b>To:</b></font></division></cell><cell width="272"></cell><cell width="8143"><division indent="0" align="left"><font><i><field name="To"/></i></font><font><i><field name="ComNav"/></i></font></division></cell></row><row><cell width="2055"><division indent="0" align="right"><font><b>From:</b></font></division></cell><cell width="272"></cell><cell width="8143"><division indent="0" align="left"><font><i><field name="Communicator:FromName"/></i></font><font><i> (</i></font><font><i><field name="Communicator:FromEmail"/></i></font><font><i>)</i></font></division></cell></row><row><cell width="2055"><division indent="0" align="right"><font><b>Date:</b></font></division></cell><cell width="272"></cell><cell width="8143"><division indent="0" align="left"><font><i>Today</i></font></division></cell></row><row><cell width="2055"><division indent="0" align="right"><font><b>Subject:</b></font></division></cell><cell width="272"></cell><cell width="8143"><division indent="0" align="left"><font><i><field name="Communicator:Subject"/></i></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="315"><row><cell width="10485"><division indent="0" align="left"><font><field name="DearSir"/></font></division></cell></row><row><cell width="10485"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="10485"><division indent="0" align="left"><font><field name="Communicator:Body"/></font></division></cell></row></table></text>
<text label="T2" style="normal"><table indent="300"><row><cell width="10500"><division indent="0" align="left"><font><b><field name="Communicator:PollQ"/></b></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/><font><field name="Communicator:R1"/></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/><font><field name="Communicator:R2"/></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/><font><field name="Communicator:R3"/></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/><font><field name="Communicator:R4"/></font></division></cell></row></table><displayConditions>
<and>
<mcContains field="Communicator:Q9" value="a"/>
<mcEquals field="Communicator:Q14" value="a"/>
</and>
</displayConditions></text>
<text label="T3" style="normal"><table indent="285"><row><cell width="10515"><division indent="0" align="left"><font><field name="Communicator:DonationText"/></font></division></cell></row><row><cell width="10515"></cell></row><row><cell width="10515"><division indent="0" align="left"><font><i>[Link to online payment page will appear here]</i></font></division></cell></row></table><displayConditions>
<and>
<mcContains field="Communicator:Q10" value="a"/>
<mcEquals field="Communicator:Q17" value="a"/>
</and>
</displayConditions></text>
<text label="T4" style="normal"><table indent="285"><row><cell width="10515"><division indent="0" align="left"><font><field name="Communicator:Close"/></font></division></cell></row></table></text>
<text label="T5" style="normal"><table indent="300"><row><cell width="10500"><division indent="0" align="left"><font><field name="Communicator:PollQ"/></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><font><field name="Communicator:R1"/></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><font><field name="Communicator:R2"/></font></division></cell></row><row><cell width="10500"><division indent="0" align="left"><sp/><sp/><sp/><font><field name="Communicator:R3"/></font></division></cell></row></table><displayConditions>
<and>
<mcContains field="Communicator:Q9" value="a"/>
<mcEquals field="Communicator:Q14" value="b"/>
</and>
</displayConditions></text>
<text label="T6" style="normal"><table indent="285"><row><cell width="10515"><division indent="0" align="left"><font><field name="Communicator:DonationText"/></font></division></cell></row><row><cell width="10515"></cell></row><row><cell width="10515"><division indent="0" align="left"><font><i>[Link to online payment page will appear here]</i></font></division></cell></row></table><displayConditions>
<and>
<mcContains field="Communicator:Q10" value="a"/>
<mcEquals field="Communicator:Q17" value="b"/>
</and>
</displayConditions></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send emails to </font><font face="Arial" size="200" color="000000"><field name="To"/></font><font face="Arial" size="200" color="000000"><field name="ComNav"/></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit email further</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Abandon email</font></paragraph></choice></mc>
</items>
</form>
<form name="SetFilter" startPoint="false" themePath="lime" process="Post-SetFilter" preProcess="Pre-SetFilter" blockBackButton="false">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<field name="CurrentFilter"/>
<field name="CurrentSubFilter"/>
<field name="PersonalFilterStatus"/>
<field name="PersonalFilterSub"/>
<field name="AgeRnge"/>
<field name="AgeMnmm"/>
<field name="Agemxmm"/>
<field name="AgeNone"/>
<field name="SexRnge"/>
<field name="SexNone"/>
<field name="RelRnge"/>
<field name="RelNone"/>
<field name="EthRnge"/>
<field name="EthNone"/>
<field name="PolRange"/>
<field name="PolNone"/>
<field name="GeographicFilterStatus"/>
<field name="GeoFltrSb"/>
<field name="GeoSubSub"/>
<field name="CitiesRnge"/>
<field name="CitiesNone"/>
<field name="ZipRnge"/>
<field name="ZipNone"/>
<field name="ACRnge"/>
<field name="ACNone"/>
<field name="ExchngeRnge"/>
<field name="ExchngeNone"/>
<field name="PrecinctRange"/>
<field name="PrecinctNone"/>
<field name="SD1Range"/>
<field name="SD1None"/>
<field name="SD2Range"/>
<field name="SD2None"/>
<field name="StHouseRange"/>
<field name="StHouseNone"/>
<field name="StSenateRange"/>
<field name="StSenateNone"/>
<field name="USCongressRange"/>
<field name="USCongressNone"/>
