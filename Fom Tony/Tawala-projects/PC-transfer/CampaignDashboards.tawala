<form name="ManageStaffDashboards" startPoint="false" themePath="lime" process="Post-ManageStaffDashboards" blockBackButton="false">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Manage Staff Dashboards</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Use this page to create and manage Dashboards for each person involved with the campaign.  Even if people have identical authority, it is useful for them to use separate Dashboards.  There is no practical limit to the number of Dashboards you may create.</font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Current Staff Dashboards:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="2"><show-print-control>false</show-print-control><show-export-control>false</show-export-control><template-id></template-id><column><header><string value="First"/>
</header><contents><field name="Record:CreateStaffDashboard:SFirst" /></contents></column><column><header><string value="Last"/>
</header><contents><field name="Record:CreateStaffDashboard:SLast" /></contents></column><column><header><string value="Position"/>
</header><contents><field name="Record:CreateStaffDashboard:STitle" /></contents><display-conditions><equals field="QTitle">
<string value="Yes"/>
</equals>
</display-conditions></column><conditions><form name="CreateStaffDashboard" /></conditions></itemization-table></font></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add a staff member and create their Dashboard</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit a staff member's information or permissions</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Review staff permissions</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Delete a staff member's Dashboard</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send staff member(s) their Dashboard links</font></paragraph></choice><choice label="f"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="ManageStaffDashboards:Q1" value="b"/>
</conditions>
<trueSet>
<comment>Edit staff record</comment>
<set field="Action" arithmeticAsText="false">
<string value="Edit"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="ManageStaffDashboards:Q1" value="d"/>
</conditions>
<trueSet>
<comment>Delete staff record</comment>
<set field="Action" arithmeticAsText="false">
<string value="Delete"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<or>
<mcEquals field="ManageStaffDashboards:Q1" value="f"/>
<or>
<mcEquals field="ManageStaffDashboards:Q1" value="c"/>
<mcEquals field="ManageStaffDashboards:Q1" value="a"/>
</or>
</or>
</conditions>
<trueSet>
<comment>Add record, review permissions, return</comment>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="ManageStaffDashboards:Q1" value="e"/>
</conditions>
<trueSet>
<comment>Send email to staff member(s)</comment>
<skip to="T4"/>
</trueSet>
</if>
</skipInstructions>
<text label="T3" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ManageStaffDashboards" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<mc label="Q2" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select staff member to </font><font face="Arial" size="200" color="000000"><field name="Action"/></font><font face="Arial" size="200" color="000000">: </font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:StaffDashboards:STitle"/>
<string value=" - "/>
<field name="Record:StaffDashboards:SFirst"/>
<string value=" "/>
<field name="Record:StaffDashboards:SLast"/>
</display-expression><value-expression><field name="Record:StaffDashboards:StaffID"/>
</value-expression><sort-expression><field name="Record:StaffDashboards:StaffID"/>
</sort-expression><record-selector><form name="CreateStaffDashboard" /></record-selector></dynamic-mcq></data-provider></mc>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T4" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ManageStaffDashboards" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<mc label="Q3" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select staff member(s) to send Dashboard links: </font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:StaffDashboards:STitle"/>
<string value=" - "/>
<field name="Record:StaffDashboards:SFirst"/>
<string value=" "/>
<field name="Record:StaffDashboards:SLast"/>
</display-expression><value-expression><field name="Record:StaffDashboards:StaffID"/>
</value-expression><sort-expression><field name="Record:StaffDashboards:StaffID"/>
</sort-expression><record-selector><form name="CreateStaffDashboard" /></record-selector></dynamic-mcq></data-provider></mc>
<text label="T5" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enter body of email </font><font face="Arial" size="200" color="000000"><i>(the link will be automatically added to your message):</i></font></paragraph></text>
<fib label="Q4" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="20" height="10" required="false" alternateLabel="Body"></blank></paragraph></fib>
<text label="T6" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Enter your closing:</font></paragraph></text>
<fib label="Q5" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="20" height="5" required="false" alternateLabel="Close"></blank></paragraph></fib>
</items>
</form>
<form name="CreateStaffDashboard" startPoint="false" themePath="lime" process="Post-CreateStaffDashboards" preProcess="Pre-CreateStaffDashboards" blockBackButton="false">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000"><field name="Action"/></font><font face="Arial" size="360" color="000000"> Staff Dashboard</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ManageStaffDashboards" project=""><displayText><string value="cancel &amp; return to Manage Dashboards"/>
</displayText></invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="SetupMenu" project=""><displayText><string value="cancel and return to Setup"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Basic Information:</b></font></paragraph></text>
<fib label="Q1" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Name:  </font><blank label="a" length="20" required="false" alternateLabel="SFirst"></blank><sp/><font face="Arial" size="200" color="000000"><i>(first) </i></font><blank label="b" length="20" required="false" alternateLabel="SLast"></blank><sp/><font face="Arial" size="200" color="000000"><i>(last)</i></font></paragraph></fib>
<fib label="Q2" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Title: </font><blank label="a" length="20" required="false" alternateLabel="STitle"></blank></paragraph><displayConditions>
<equals field="QTitle">
<string value="Yes"/>
</equals>
</displayConditions></fib>
<fib label="Q3" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email Address: </font><blank label="a" length="20" required="false" alternateLabel="SEmail"></blank></paragraph></fib>
<fib label="Q4" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Second Email </font><font face="Arial" size="200" color="000000"><i>(optional):</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="SEmail2"></blank></paragraph><displayConditions>
<equals field="QEmail2">
<string value="Yes"/>
</equals>
</displayConditions></fib>
<fib label="Q5" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Work Phone: </font><blank label="a" length="20" required="false" alternateLabel="SWorkPh"></blank></paragraph><displayConditions>
<equals field="QWorkPh">
<string value="Yes"/>
</equals>
</displayConditions></fib>
<fib label="Q6" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Home Phone: </font><blank label="a" length="20" required="false" alternateLabel="SHomePh"></blank></paragraph><displayConditions>
<equals field="QHomePh">
<string value="Yes"/>
</equals>
</displayConditions></fib>
<fib label="Q7" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cell Phone: </font><blank label="a" length="20" required="false" alternateLabel="SCellPh"></blank></paragraph><displayConditions>
<equals field="QCellPh">
<string value="Yes"/>
</equals>
</displayConditions></fib>
<fib label="Q8" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><i>Mailing Address:</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Street or PO: </font><blank label="a" length="20" required="false" alternateLabel="SStreet"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">City: </font><blank label="b" length="20" required="false" alternateLabel="SCity"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">State: </font><blank label="c" length="20" required="false" alternateLabel="SState"></blank></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Zip: </font><blank label="d" length="20" required="false" alternateLabel="SZip"></blank></paragraph><displayConditions>
<equals field="QMail">
<string value="Yes"/>
</equals>
</displayConditions></fib>
<skipInstructions>
<if>
<conditions>
<doesNotContain field="Manage">
<string value="Multiple"/>
</doesNotContain>
</conditions>
<trueSet>
<skip to="T8"/>
</trueSet>
</if>
</skipInstructions>
<text label="T3" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Please mark below the partially restricted permissions you would like </font><font><field name="CreateStaffDashboard:SFirst"/></font><sp/><sp/><font><field name="CreateStaffDashboard:SLast"/></font><font>  to have on his or her Dashboard: </font></paragraph></text>
<text label="T4" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><i>Databases:</i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>View information in Databases</i></font></paragraph></text>
<mc label="Q9" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">View individual records in </font><font face="Arial" size="200" color="000000"><b>Proprietary Constituent Database</b></font></paragraph></choice><displayConditions>
<equals field="PViewPCDB">
<string value="Yes"/>
</equals>
</displayConditions></mc>
<mc label="Q10" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">View individual records in </font><font face="Arial" size="200" color="000000"><b>Supporter Database</b></font></paragraph></choice><displayConditions>
<equals field="PViewSDB">
<string value="Yes"/>
</equals>
</displayConditions></mc>
<text label="T5" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Modify information in Databases</i></font></paragraph></text>
<mc label="Q11" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add, edit or modify </font><font face="Arial" size="200" color="000000"><i>personal data</i></font><font face="Arial" size="200" color="000000"> in </font><font face="Arial" size="200" color="000000"><b>Proprietary Constituent Database</b></font></paragraph></choice><displayConditions>
<equals field="PModPCDBPersonal">
<string value="Yes"/>
