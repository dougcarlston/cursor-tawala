ent="0" align="left"><sp/><sp/></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/></division></cell><cell width="200"></cell><cell width="1380"></cell></row><row><cell width="3715"><division indent="0" align="left"><font><b>Total Records:</b></font></division></cell><cell width="200"></cell><cell width="1035"></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="left"><font><b>Records containing:</b></font></division></cell><cell width="200"></cell><cell width="1380"></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i> # of unique cities/towns:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Cities" />
</conditions></conditions></record-count></font></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="right"><font><i>Email addresses:</i></font></division></cell><cell width="200"></cell><cell width="1380"><division indent="0" align="right"><font><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<isNotBlank field="Record:DataBase:email" />
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i># of unique Zip codes:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Zips" />
</conditions></conditions></record-count></font></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="right"><font><i>Age data:</i></font></division></cell><cell width="200"></cell><cell width="1380"><division indent="0" align="right"><font><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<isNotBlank field="Record:DataBase:Birthdate" />
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i># of unique phone area codes:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:AreaCodes" />
</conditions></conditions></record-count></font></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="right"><font><i>Gender data:</i></font></division></cell><cell width="200"></cell><cell width="1380"><division indent="0" align="right"><font><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<and>
<isNotBlank field="Record:DataBase:gender" />
<and>
<doesNotEqual field="Record:DataBase:gender">
<string value="UNKNOWN"/>
</doesNotEqual>
<doesNotEqual field="Record:DataBase:gender">
<string value="UNK"/>
</doesNotEqual>
</and>
</and>
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i># of unique phone exchanges:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Exchanges" />
</conditions></conditions></record-count></font></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="right"><font><i>Religion data:</i></font></division></cell><cell width="200"></cell><cell width="1380"><division indent="0" align="right"><font><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<and>
<isNotBlank field="Record:DataBase:Religion" />
<doesNotEqual field="Record:DataBase:Religion">
<string value="UNKNOWN"/>
</doesNotEqual>
</and>
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i> # of unique precincts:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:Precincts" />
</conditions></conditions></record-count></font></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="right"><font><i>Ethnicity Data:</i></font></division></cell><cell width="200"></cell><cell width="1380"><division indent="0" align="right"><font><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<and>
<isNotBlank field="Record:DataBase:Ethnicity" />
<doesNotEqual field="Record:DataBase:Ethnicity">
<string value="UNKNOWN"/>
</doesNotEqual>
</and>
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i># of unique SD1's:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:SD1s" />
</conditions></conditions></record-count></font></division></cell><cell width="885"></cell><cell width="3385"><division indent="0" align="right"><font><i>Party registration data:</i></font></division></cell><cell width="200"></cell><cell width="1380"><division indent="0" align="right"><font><record-count version="3"><form-name>DataBase</form-name><conditions><form name="DataBase" /><conditions>
<and>
<isNotBlank field="Record:DataBase:party" />
<doesNotEqual field="Record:DataBase:party">
<string value="UNK"/>
</doesNotEqual>
</and>
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3715"><division indent="0" align="right"><font><i># of unique SD2's:</i></font></division></cell><cell width="200"></cell><cell width="1035"><division indent="0" align="right"><font><record-count version="3"><form-name>Index Tables</form-name><conditions><form name="Index Tables" /><conditions>
<isNotBlank field="Record:Index Tables:SD2s" />
