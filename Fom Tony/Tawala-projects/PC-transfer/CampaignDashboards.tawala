<field name="PollResponses"/>
<field name="PollNR"/>
</items>
</form>
<form name="Apply filter" startPoint="false" themePath="lime" process="Post-ApplyFilter" preProcess="Pre-ApplyFilter" blockBackButton="false">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Apply filter to database</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="cancel operation and return"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="error"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Note that applying the filter to the database takes roughly five seconds per 1,000 records. Note: Polls take far longer, as they are part of a separate database.  Please be patient.</b></font></paragraph></text>
<text label="T3" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press Submit to apply the new filter settings to the database.</font></paragraph></text>
</items>
</form>
<form name="ChangeFilterPersonal" startPoint="false" themePath="lime" process="Post-ChangeFilterPersonal" preProcess="Pre-ChangeFilterPersonal" blockBackButton="false">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Change Personal Filter Settings</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="normal"><table indent="240"><row><cell width="1800"><division indent="0" align="left"><font color="000080"><b>Filter Settings:</b></font></division></cell><cell width="5655"><division indent="0" align="left"><font color="000080"><field name="Filter"/></font></division></cell></row><row><cell width="1800"></cell><cell width="5655"><division indent="0" align="left"><font color="000080"><field name="FilterSub"/></font></division></cell></row></table><paragraph indent="0" align="left"></paragraph><paragraph indent="0" align="left"><font color="000080"><i>Personal filters involve age, gender, religion, ethnicity and political affiliation.  You may use this section to add one or more filters involving any of these personal characteristics.</i></font></paragraph><paragraph indent="0" align="left"></paragraph><paragraph indent="0" align="left"></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add Personal Filter to existing filters </font><font face="Arial" size="200" color="000000"><i>(only records that match all filters will show)</i></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit current Personal Filter</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Remove current Personal Filter from overall filter</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="ChangeFilterPersonal:Q1" value="c"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<text label="T3" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you select more than one subfilter, only those records will be selected that satisfy </font><font><b>all</b></font><font> of the selected subfilter parameters.</font></paragraph></text>
<mc label="Q2" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Filter records by: </font><font face="Arial" size="200" color="000000"><i>(choose as many as you wish)</i></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Age</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Gender</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Religion</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Ethnicity</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Political affiliation</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcIsBlank field="ChangeFilterPersonal:Q2" />
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<text label="T4" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<fib label="Q3" style="leftAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Age:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Minimum age: </font><blank label="a" length="4" required="false" alternateLabel="MinAge"></blank></paragraph><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="a"/>
</displayConditions></fib>
<fib label="Q4" style="leftAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Maximum age: </font><blank label="a" length="4" required="false" alternateLabel="MaxAge"></blank></paragraph><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="a"/>
</displayConditions></fib>
<mc label="Q5" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include voters for whom there is no age data</font></paragraph></choice><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="a"/>
</displayConditions></mc>
<mc label="Q6" alternateLabel="Sex" onlyone="false" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Gender:</b></font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Index Tables:Genders"/>
</display-expression><value-expression><field name="Record:Index Tables:Genders"/>
</value-expression><sort-expression><field name="Record:Index Tables:Genders"/>
</sort-expression><record-selector><form name="Index Tables" /></record-selector></dynamic-mcq></data-provider><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="b"/>
</displayConditions></mc>
<mc label="Q7" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include voters for whom there is no gender data</font></paragraph></choice><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="b"/>
</displayConditions></mc>
<mc label="Q8" alternateLabel="Religion" onlyone="false" required="false" style="multicolumn" columnCount="4"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Religion:</b></font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Index Tables:Religions"/>
</display-expression><value-expression><field name="Record:Index Tables:Religions"/>
</value-expression><sort-expression><field name="Record:Index Tables:Religions"/>
</sort-expression><record-selector><form name="Index Tables" /></record-selector></dynamic-mcq></data-provider><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="c"/>
</displayConditions></mc>
<mc label="Q9" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include voters for whom there is no religion data</font></paragraph></choice><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="c"/>
</displayConditions></mc>
<mc label="Q10" alternateLabel="Ethnicity" onlyone="false" required="false" style="multicolumn" columnCount="4"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Ethnicity:</b></font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Index Tables:Ethnicities"/>
</display-expression><value-expression><field name="Record:Index Tables:Ethnicities"/>
</value-expression><sort-expression><field name="Record:Index Tables:Ethnicities"/>
</sort-expression><record-selector><form name="Index Tables" /></record-selector></dynamic-mcq></data-provider><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="d"/>
</displayConditions></mc>
<mc label="Q11" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include voters for whom there is no ethnicity data</font></paragraph></choice><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="d"/>
</displayConditions></mc>
<mc label="Q12" alternateLabel="Party" onlyone="false" required="false" style="multicolumn" columnCount="4"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Party affiliation:</b></font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Index Tables:Parties"/>
</display-expression><value-expression><field name="Record:Index Tables:Parties"/>
</value-expression><sort-expression><field name="Record:Index Tables:Parties"/>
</sort-expression><record-selector><form name="Index Tables" /></record-selector></dynamic-mcq></data-provider><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="e"/>
</displayConditions></mc>
<mc label="Q13" onlyone="false" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Include voters for whom there is no party affiliation data</font></paragraph></choice><displayConditions>
<mcContains field="ChangeFilterPersonal:Q2" value="e"/>
</displayConditions></mc>
</items>
</form>
<form name="ChangeFilterGeography" startPoint="false" themePath="lime" process="Post-ChangeFilterGeography" preProcess="Pre-ChangeFilterGeography" blockBackButton="false">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Change Geographic Filter Settings</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="SetFilter" project=""><displayText><string value="cancel"/>
</displayText></invitation></u></font></paragraph></text>
<text label="T2" style="normal"><table indent="240"><row><cell width="1800"><division indent="0" align="left"><font><b>Filter Settings:</b></font></division></cell><cell width="5655"><division indent="0" align="left"><font><field name="Filter"/></font></division></cell></row><row><cell width="1800"></cell><cell width="5655"><division indent="0" align="left"><font><field name="FilterSub"/></font></division></cell></row></table><paragraph indent="0" align="left"></paragraph><paragraph indent="0" align="left"><font>Geographic filters involve territories such as cities, zip code districts, area code districts and legislative districts.  You may use this section to add one or more filters involving any of these geographic characteristics.</font></paragraph></text>
<mc label="Q1" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add Geographic Filter to existing files </font><font face="Arial" size="200" color="000000"><i>(only records that match all filters will show)</i></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit current Geographic Filter</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Remove current Geographic Filter from overall filter</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="ChangeFilterGeography:Q1" value="c"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
