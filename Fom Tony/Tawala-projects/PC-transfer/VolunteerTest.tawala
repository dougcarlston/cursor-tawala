<?xml version="1.0" encoding="utf-8" ?>
<project name="VolunteerTest" themePath="default" format="1.10" designerBuild="209">
<forms>
<form name="Registration" startPoint="true" themePath="default" process="Process 1">
<items>
<mc label="Q1" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select which volunteer jobs you would like to have:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Volunteer:Role"/>
</display-expression><value-expression><field name="Record:Volunteer:Role"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="Volunteer" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="Volunteer" startPoint="true" themePath="default">
<items>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Volunteer role:  </font><blank label="a" length="20" required="false" alternateLabel="Role"/></paragraph></fib>
</items>
</form>
</forms>
<processes>
<process name="Process 1">
<if>
<conditions>
<mcContains field="Registration:Q1">
<string value="Coach"/>
</mcContains>
</conditions>
<trueSet>
<show document="CoachSelected" reset="false"/>
</trueSet>
<falseSet>
<show document="NoCoachSelected" reset="false"/>
</falseSet>
</if>
</process>
</processes>
<documents>
<document name="CoachSelected">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Coach selected</font></paragraph>
</xmlData>
</document>
<document name="NoCoachSelected">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Not selected to be a coach.</font></paragraph>
</xmlData>
</document>
</documents>
</project>
