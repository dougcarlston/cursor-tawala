<set field="CC" arithmeticAsText="false">
<string field="CC"/>
<string value=", second client email"/>
</set>
</trueSet>
</if>
<show form="Communicator2"/>
</process>
<process name="Process 25">
<set field="SecondEmail" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="CCEach2Me" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="AgentCopy" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="CC" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcEquals field="Communicator2:Q5" value="b"/>
</conditions>
<trueSet>
<show form="Communicator"/>
</trueSet>
</if>
<if>
<conditions>
<mcDoesNotEqual field="Communicator2:Q5" value="a"/>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Emails not sent out."/>
</set>
<show document="Message" reset="false"/>
<show form="Start"/>
</trueSet>
</if>
<if>
<conditions>
<or>
<mcEquals field="Communicator:Q1" value="a"/>
<mcEquals field="Communicator:Q1" value="b"/>
</or>
</conditions>
<trueSet>
<get recordList="Record List 21">
<forms>
<form name="ClientInfo"/>
</forms>
<conditions>
<equals field="Record List 21:ClientInfo:Record Status">
<string value="Active"/>
</equals>
</conditions></get>
</trueSet>
<falseSet>
<get recordList="Record List 21">
<forms>
<form name="ClientInfo"/>
</forms>
<conditions>
<and>
<equals field="Record List 21:ClientInfo:IncludedRecord">
<string value="Yes"/>
</equals>
<equals field="Record List 21:ClientInfo:Record Status">
<string value="Active"/>
</equals>
</and>
</conditions></get>
</falseSet>
</if>
<set field="Count" arithmeticAsText="false">
<string value="0"/>
</set>
<foreach record="Recipient" recordList="Record List 21">
<if>
<conditions>
<or>
<mcEquals field="Communicator:Q1" value="a"/>
<mcEquals field="Communicator:Q1" value="c"/>
</or>
</conditions>
<trueSet>
<set field="To" arithmeticAsText="false">
<string field="Recipient:ClientInfo:CEmail"/>
</set>
<if>
<conditions>
<mcContains field="Communicator:Q2" value="a"/>
</conditions>
<trueSet>
<set field="AgentCopy" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcContains field="Communicator:Q2" value="b"/>
</conditions>
<trueSet>
<set field="SecondEmail" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Communicator:Q3" value="b"/>
</conditions>
<trueSet>
<set field="CCEach2Me" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
</trueSet>
<falseSet>
<set field="To" arithmeticAsText="false">
<string field="Recipient:ClientInfo:AgentEmail"/>
</set>
</falseSet>
</if>
<set field="DearSir" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<and>
<isNotBlank field="Recipient:ClientInfo:Salutation" />
<equals field="To">
<string field="Recipient:ClientInfo:CEmail"/>
</equals>
</and>
</conditions>
<trueSet>
<set field="DearSir" arithmeticAsText="false">
<string value="Dear "/>
<string field="Recipient:ClientInfo:Salutation"/>
<string value=","/>
</set>
</trueSet>
</if>
<if>
<conditions>
<equals field="To">
<string field="Recipient:ClientInfo:AgentEmail"/>
</equals>
</conditions>
<trueSet>
<set field="DearSir" arithmeticAsText="false">
<string value=" "/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="To" />
</conditions>
<trueSet>
<if>
<conditions>
<equals field="CCEach2Me">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<send>
<to addressField="Communicator2:FromEmail"/>
<from addressField="Communicator2:FromEmail" aliasField="Communicator2:FromName"/>
<subject>Copy of <field name="Communicator2:Subject"/> sent to <field name="To"/></subject>
<body document="Email" reset="false" showHeader="false"/>
</send>
</trueSet>
</if>
<if>
<conditions>
<equals field="AgentCopy">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<send>
<to addressField="Recipient:ClientInfo:AgentEmail"/>
<from addressField="Communicator2:FromEmail" aliasField="Communicator2:FromName"/>
<subject>Copy of Email to <field name="To"/> re: <field name="Communicator2:Subject"/></subject>
<body document="Email" reset="false" showHeader="false"/>
</send>
</trueSet>
</if>
<if>
<conditions>
<or>
<mcEquals field="Communicator:Q1" value="a"/>
<mcEquals field="Communicator:Q1" value="c"/>
</or>
</conditions>
<trueSet>
<append document="Email" appendage="OptOut"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="SecondEmail">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<send>
<to addressField="Recipient:ClientInfo:CEmail2"/>
<from addressField="Communicator2:FromEmail" aliasField="Communicator2:FromName"/>
<subject><field name="Communicator2:Subject"/></subject>
<body document="Email" reset="false" showHeader="false"/>
</send>
</trueSet>
</if>
<send>
<to addressField="To"/>
<from addressField="Communicator2:FromEmail" aliasField="Communicator2:FromName"/>
<subject><field name="Communicator2:Subject"/></subject>
<body document="Email" reset="true" showHeader="false"/>
</send>
<set field="Count" arithmeticAsText="false">
<add>
<operand field="Count"/>
<operand value="1"/>
</add>
</set>
</trueSet>
</if>
</foreach>
<if>
<conditions>
<mcEquals field="Communicator:Q3" value="a"/>
</conditions>
<trueSet>
<send>
<to addressField="Communicator2:FromEmail"/>
<from addressField="Communicator2:FromEmail" aliasField="Communicator2:FromName"/>
<subject>Copy of message: <field name="Communicator2:Subject"/> </subject>
<body document="Email" reset="false" showHeader="false"/>
</send>
</trueSet>
</if>
<set field="Message" arithmeticAsText="false">
<string field="Count"/>
<string value=" email(s) sent out of message: "/>
<string field="Communicator2:Subject"/>
</set>
<show document="Message" reset="false"/>
<show form="Start"/>
</process>
<process name="Process 26">
<show document="FilteredContact" reset="false"/>
</process>
<process name="Process 27">
<show document="FilteredLocation" reset="false"/>
</process>
<process name="Process 28">
<show document="FilteredProp" reset="false"/>
</process>
<process name="Process 29">
<show document="FilteredFin" reset="false"/>
</process>
<process name="Process 30">
<edit form="Filter" submit="modify">
</edit>
</process>
<process name="Process 31">
<get recordList="Record List 24">
<forms>
<form name="Communicator2"/>
</forms>
</get>
<foreach record="Sender" recordList="Record List 24">
<set field="From" arithmeticAsText="false">
<string field="Sender:Communicator2:FromEmail"/>
</set>
</foreach>
<get recordList="Record List 25">
<forms>
<form name="ClientInfo"/>
</forms>
<conditions>
<equals field="_InviteeID">
<string field="Record List 25:ClientInfo:CEmail"/>
</equals>
</conditions></get>
<foreach record="Client" recordList="Record List 25">
<set field="Client:ClientInfo:Record Status" arithmeticAsText="false">
<string value="Inactive"/>
</set>
<set field="To" arithmeticAsText="false">
<string field="Client:ClientInfo:CName"/>
</set>
</foreach>
<show document="OptOutConfirmation" reset="false"/>
<send>
<to addressField="From"/>
<from addressField="_InviteeID" aliasField="To"/>
<subject>Opting Out</subject>
<body document="OptOutNotification" reset="false" showHeader="true"/>
</send>
</process>
