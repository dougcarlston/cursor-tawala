<process name="Process 11">
<comment>First, mark all records as unselected</comment>
<get recordList="Record List 3">
<forms>
<form name="ClientInfo"/>
</forms>
</get>
<foreach record="UnscrubbedRecord" recordList="Record List 3">
<set field="UnscrubbedRecord:ClientInfo:IncludedRecord" arithmeticAsText="false">
<string value="No"/>
</set>
</foreach>
<comment>Then compare each record with current criteria</comment>
<get recordList="Record List 4">
<forms>
<form name="ClientInfo"/>
</forms>
</get>
<foreach record="ScrubbedRecord" recordList="Record List 4">
<set field="FlagTemp" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="FlagMain" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="FlagLocation" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="FlagProp" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="FlagFin" arithmeticAsText="false">
<string value="No"/>
</set>
<comment>First, the Main Parameters</comment>
<if>
<conditions>
<and>
<mcContains field="Filter:Q1" value="a"/>
<mcContains field="ScrubbedRecord:ClientInfo:Q8" value="a"/>
</and>
</conditions>
<trueSet>
<set field="FlagTemp" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<and>
<mcContains field="Filter:Q1" value="b"/>
<mcContains field="ScrubbedRecord:ClientInfo:Q8" value="b"/>
</and>
</conditions>
<trueSet>
<set field="FlagTemp" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<equals field="FlagTemp">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<if>
<conditions>
<or>
<isLessThanOrEqualTo field="Filter:CashBudParam">
<string field="ScrubbedRecord:ClientInfo:EuroCashBudget"/>
</isLessThanOrEqualTo>
<isBlank field="Filter:CashBudParam" />
</or>
</conditions>
<trueSet>
<if>
<conditions>
<or>
<isLessThanOrEqualTo field="Filter:InvestBudParam">
<string field="ScrubbedRecord:ClientInfo:EuroInvestmentMax"/>
</isLessThanOrEqualTo>
<isBlank field="Filter:InvestBudParam" />
</or>
</conditions>
<trueSet>
<set field="FlagMain" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
</trueSet>
</if>
</trueSet>
</if>
<if>
<conditions>
<and>
<isNotBlank field="Filter:InvestBudParam" />
<isGreaterThan field="ScrubbedRecord:ClientInfo:EuroInvestmentMin">
<string field="Filter:InvestBudParam"/>
</isGreaterThan>
</and>
</conditions>
<trueSet>
<set field="FlagMain" arithmeticAsText="false">
<string value="No"/>
