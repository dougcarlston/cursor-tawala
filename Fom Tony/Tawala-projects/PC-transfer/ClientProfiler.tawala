<form name="Communicator" startPoint="false" themePath="tennis" process="Process 24">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Communicator</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>This tool permits one to send personalized emails out to the entire client base or only to those clients whose requirements match the search criteria you have previously selected.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>It also permits communications to be sent to a client's agent instead.</font></paragraph></text>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send an email to all clients</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send an email to all agents</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email only clients that match your search criteria</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email only  agents of clients that match your search criteria</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Review current search criteria</font></paragraph></choice><choice label="f"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return to Main Menu</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<or>
<mcEquals field="Communicator:Q1" value="b"/>
<mcEquals field="Communicator:Q1" value="d"/>
</or>
</conditions>
<trueSet>
<skip to="Q3"/>
</trueSet>
</if>
<if>
<conditions>
<or>
<mcEquals field="Communicator:Q1" value="e"/>
<mcEquals field="Communicator:Q1" value="f"/>
</or>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<mc label="Q2" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email copy to agent</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email copy to second client email address</font></paragraph></choice></mc>
<mc label="Q3" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email single copy of communication to me</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email copy of each communication to me</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Don't copy me</font></paragraph></choice></mc>
</items>
</form>
<form name="Communicator2" startPoint="false" themePath="tennis" dataEntryOnly="true" process="Process 25">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Communicator</font></paragraph></heading>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>To:</b></font><sp/><font><field name="To"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Cc: </b></font><font><field name="CC"/></font></paragraph></text>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>From:</b></font><sp/><font face="Arial" size="200" color="000000"><i>(name)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="FromName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>From:</b></font><sp/><font face="Arial" size="200" color="000000"><i>(email)</i></font><font face="Arial" size="200" color="000000"> </font><blank label="b" length="20" required="false" alternateLabel="FromEmail"/></paragraph></fib>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Subject:</b></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="20" required="false" alternateLabel="Subject"/></paragraph></fib>
<fib label="Q3" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Body of Message:</b></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="53" height="10" required="false" alternateLabel="Body"/></paragraph></fib>
<fib label="Q4" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Closing:</b></font><sp/><blank label="a" length="53" height="5" required="false" alternateLabel="Close"/></paragraph></fib>
<break/>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Your message will look like this:</font></paragraph></text>
<text label="T3"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="525"><row><cell width="1185"><division indent="0" align="left"><font><b>To:</b></font></division></cell><cell width="272"></cell><cell width="8818"><division indent="0" align="left"><font><field name="To"/></font></division></cell></row><row><cell width="1185"><division indent="0" align="left"><font><b>Cc:</b></font></division></cell><cell width="272"></cell><cell width="8818"><division indent="0" align="left"><font><field name="CC"/></font></division></cell></row><row><cell width="1185"><division indent="0" align="left"><font><b>From:</b></font></division></cell><cell width="272"></cell><cell width="8818"><division indent="0" align="left"><font><field name="Communicator2:FromName"/></font><font>  (</font><font><field name="Communicator2:FromEmail"/></font><font>)</font></division></cell></row><row><cell width="1185"><division indent="0" align="left"><font><b>Date:</b></font></division></cell><cell width="272"></cell><cell width="8818"><division indent="0" align="left"><font>Today</font></division></cell></row><row><cell width="1185"><division indent="0" align="left"><sp/></division></cell><cell width="272"></cell><cell width="8818"></cell></row><row><cell width="1185"><division indent="0" align="right"><font><b>Subject:</b></font></division></cell><cell width="272"></cell><cell width="8818"><division indent="0" align="left"><font><field name="Communicator2:Subject"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="510"><row><cell width="10290"><division indent="0" align="left"><font>Dear &lt;Salutation&gt;, </font><font><i>(if included in client record)</i></font></division></cell></row><row><cell width="10290"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="10290"><division indent="0" align="left"><font><field name="Communicator2:Body"/></font></division></cell></row><row><cell width="10290"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="10290"><division indent="0" align="left"><font><field name="Communicator2:Close"/></font></division></cell></row></table></text>
<text label="T4" style="error"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Warning!  </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>This sends </font><font><b>real</b></font><font> emails so don't go any further if you have actual email addresses in the data base unless you intend the recipients to get your message.</font></paragraph></text>
