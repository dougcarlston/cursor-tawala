<text label="T2"><paragraph indent="720" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>1</number-of-columns><column><header>Currencies</header><contents><field name="Record:AddCurrency:NewCurrency" /></contents></column><conditions><form name="AddCurrency" /></conditions></itemization-table></font></paragraph></text>
