<form name="AddPropReqs" startPoint="false" themePath="tennis" process="Process 21">
<items>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Don't try to add and delete at the same time.</font></paragraph></text>
<text label="T2"><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>1</number-of-columns><column><header>Property Requirements</header><contents><field name="Record:AddPropReqs:PropReq" /></contents></column><conditions><form name="AddPropReqs" /></conditions></itemization-table></font></paragraph></text>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add Property Requirement to list: </font><blank label="a" length="20" required="false" alternateLabel="PropReq"/></paragraph></fib>
