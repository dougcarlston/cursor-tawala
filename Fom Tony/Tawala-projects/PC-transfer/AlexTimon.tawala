<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
</items>
</form>
<form name="Setup" startPoint="false" themePath="tennis" process="Process 16" preProcess="Process 17">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Client Profiler - Setup</font></paragraph></heading>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Set password and hint</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Set currency exchange rates</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Set up Location, Property or Financial requirements options</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Go to Main Menu</font></paragraph></choice></mc>
<skipInstructions>
<set field="Message" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcEquals field="Setup:Q1" value="b"/>
</conditions>
<trueSet>
<skip to="H3"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Setup:Q1" value="c"/>
</conditions>
<trueSet>
<skip to="H4"/>
</trueSet>
</if>
<if>
<conditions>
<mcDoesNotEqual field="Setup:Q1" value="a"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<heading label="H2" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Set password and hint</font></paragraph></heading>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="B00000"><b><field name="Message"/></b></font></paragraph></text>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>To change Password or Hint, replace current contents of field:</font></paragraph></text>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Password: </font><blank label="a" length="20" required="false" alternateLabel="NewPass"/></paragraph></fib>
<fib label="Q3" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Repeat  Password: </font><blank label="a" length="20" required="false" alternateLabel="NewPassCopy"/></paragraph></fib>
<fib label="Q4" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">New Hint: </font><blank label="a" length="20" required="false" alternateLabel="Hint"/></paragraph></fib>
<skipInstructions>
<if>
<conditions>
<doesNotEqual field="Setup:NewPass">
<string field="Setup:NewPassCopy"/>
</doesNotEqual>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Copies of new password don&apos;t match"/>
</set>
<skip to="H2"/>
</trueSet>
</if>
<skip to="__EndOfForm__"/>
</skipInstructions>
<heading label="H3" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Set Currency Exchange Rates</font></paragraph></heading>
<text label="T3" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Note: At least one currency must be your base currency, with an exchange rate of 100.  All other currencies will be converted into that base currency for parameter evaluations (although amounts in client records will remain in their base currency).</font></paragraph></text>
<text label="T4"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Current Exchange Rates:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>2</number-of-columns><column><header>Currency</header><contents><field name="Record:AddCurrency:NewCurrency" /></contents></column><column><header>Exchange Rate</header><contents><field name="Record:AddCurrency:ExchangeRate" /></contents></column><conditions><form name="AddCurrency" /></conditions></itemization-table></font></paragraph></text>
<mc label="Q5" alternateLabel="Currency" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select currency whose exchange rate you wish to change:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddCurrency:NewCurrency"/>
</display-expression><value-expression><field name="Record:AddCurrency:NewCurrency"/>
</value-expression><sort-expression><field name="Record:AddCurrency:NewCurrency"/>
</sort-expression><record-selector><form name="AddCurrency" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q6" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Check here to add or delete a currency</font></paragraph></choice></mc>
<fib label="Q7" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Value of 100 Euro (or whatever base currency you select) in chosen currency: </font><font face="Arial" size="200" color="000000"><i>(max of 2 digits to right of decimal)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="XchngRate"/></paragraph></fib>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<heading label="H4" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Setup Location, Property or Financial requirements options</font></paragraph></heading>
<mc label="Q8" onlyone="true" required="false" style="vertical"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add/edit/delete</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Locations - areas</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Locations - countries</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Locations - cities</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Locations - regions</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Property requirements</font></paragraph></choice><choice label="f"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Financial requirements</font></paragraph></choice><choice label="g"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return to Main Menu</font></paragraph></choice></mc>
<field name="Try"/>
</items>
</form>
<form name="Password" startPoint="true" themePath="tennis" process="Process 15">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Client Profiler - Password</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Note: If you have not yet selected a password, leave field blank, and you will be taken to Setup.</font></paragraph></text>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Password: </font><blank label="a" length="20" required="false"/></paragraph></fib>
</items>
</form>
<form name="ClientDataConfirm" startPoint="false" themePath="tennis" process="Process 20">
<items>
<text label="T1"><paragraph indent="0" align="right"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="1800"><division indent="0" align="right"><font><b>Client Name:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><field name="ClientInfo:CName"/></font></division></cell><cell width="2040"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:CEmail"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b> Salutation:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><field name="ClientInfo:Salutation"/></font></division></cell><cell width="2040"><division indent="0" align="right"><font><b>Email2:</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:CEmail2"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Cell Phone:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><field name="ClientInfo:CCell"/></font></division></cell><cell width="2040"><division indent="0" align="right"><font><b>Agent:</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:AgentName"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Land Phone:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><field name="ClientInfo:CLand"/></font></division></cell><cell width="2040"><division indent="0" align="right"><font><b>Agent Email:</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:AgentEmail"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Inquiry Date:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><field name="ClientInfo:CDate"/></font></division></cell><cell width="2040"><division indent="0" align="right"><sp/></division></cell><cell width="315"></cell><cell width="4110"></cell></row><row><cell width="1800"><division indent="0" align="left"><sp/></division></cell><cell width="300"></cell><cell width="2235"></cell><cell width="2040"></cell><cell width="315"></cell><cell width="4110"></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Interests:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><display-mcq-label version="1"><field-name>ClientInfo:Q8</field-name><display>label_only</display></display-mcq-label></font></division></cell><cell width="2040"><division indent="0" align="right"><font><b>Currency:</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:Denom"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Cash Budget:</b></font></division></cell><cell width="300"></cell><cell width="2235"><division indent="0" align="left"><font><field name="ClientInfo:CashBudget"/></font></division></cell><cell width="2040"><division indent="0" align="right"><font><b>Investment Min:</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:MinInvest"/></font></division></cell></row><row><cell width="1800"></cell><cell width="300"></cell><cell width="2235"></cell><cell width="2040"><division indent="0" align="right"><font><b>Investment Max.</b></font></division></cell><cell width="315"></cell><cell width="4110"><division indent="0" align="left"><font><field name="ClientInfo:Maxinvest"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Location Interests:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><display-mcq-label version="1"><field-name>ClientInfo:Areas</field-name><display>label_only</display></display-mcq-label></font><sp/><font><display-mcq-label version="1"><field-name>ClientInfo:Countries</field-name><display>label_only</display></display-mcq-label></font><sp/><font><display-mcq-label version="1"><field-name>ClientInfo:Cities</field-name><display>label_only</display></display-mcq-label></font><sp/><font><display-mcq-label version="1"><field-name>ClientInfo:Regions</field-name><display>label_only</display></display-mcq-label></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Property Requirements:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><display-mcq-label version="1"><field-name>ClientInfo:PropReqs</field-name><display>all_choices</display></display-mcq-label></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="1800"><division indent="0" align="right"><font><b>No. of Beds:</b></font></division></cell><cell width="300"></cell><cell width="4365"><division indent="0" align="left"><font><field name="ClientInfo:NoBeds"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Financial Requirements:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><display-mcq-label version="1"><field-name>ClientInfo:Finreqs</field-name><display>all_choices</display></display-mcq-label></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="1800"><division indent="0" align="right"><font><b>Min % LTV:</b></font></division></cell><cell width="285"></cell><cell width="8715"><division indent="0" align="left"><font><field name="ClientInfo:MinLTV"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Min % Yield:</b></font></division></cell><cell width="285"></cell><cell width="8715"><division indent="0" align="left"><font><field name="ClientInfo:MinYield"/></font></division></cell></row></table></text>
<mc label="Q1" onlyone="true" required="true"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Please select: </font><font face="Arial" size="200" color="000000"><i>(response required)</i></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Save this Client record</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit record further</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Abandon record and return to Main Menu</font></paragraph></choice></mc>
</items>
