<?xml version="1.0" encoding="utf-8" ?>
<project name="AlexTimon" themePath="tennis" format="1.9" designerBuild="202">
<pageHeader><image id="__HEADER__8ca8ac8b1acfeb0" width="340" height="62"/></pageHeader><forms>
<form name="Start" startPoint="false" themePath="tennis" process="Process 1" preProcess="Process 8">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Client Profiler - Main Menu</font></paragraph></heading>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="180" color="298E0D">Prepared for Alex Timon by Doug Carlston</font></paragraph></text>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add/review/edit/delete individual client record</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Review/set/edit criteria to filter client record search</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">View client records</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send communication to clients or agents</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Setup</font></paragraph></choice><choice label="f"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Quit</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcDoesNotEqual field="Start:Q1" value="a"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<text label="T2"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Client List:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>2</number-of-columns><column><header>Name</header><contents><field name="Record:ClientInfo:CName" /></contents></column><column><header>Email</header><contents><field name="Record:ClientInfo:CEmail" /></contents></column><conditions><form name="ClientInfo" /></conditions></itemization-table></font></paragraph></text>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enter part or all of client name </font><font face="Arial" size="200" color="000000"><i>(leave blank to add new client)</i></font><font face="Arial" size="200" color="000000">: </font><blank label="a" length="20" required="false" alternateLabel="ClientString"/></paragraph></fib>
</items>
</form>
<form name="ClientInfo" startPoint="false" themePath="tennis" process="Process 3">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Add/Review/Edit Client Record</font></paragraph></heading>
<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="C40000"><b><field name="Message"/></b></font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Basic Information</u></b></font></paragraph></text>
<fib label="Q1" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Client Name: </font><blank label="a" length="20" required="false" alternateLabel="CName"/></paragraph></fib>
<fib label="Q2" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Salutation for emails: </font><font face="Arial" size="200" color="000000"><i>(leave blank if none to be used) </i></font><sp/><blank label="a" length="20" required="false" alternateLabel="Salutation"/></paragraph></fib>
<fib label="Q3" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email: </font><blank label="a" length="20" required="false" alternateLabel="CEmail"/></paragraph></fib>
<fib label="Q4" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cell Phone: </font><blank label="a" length="20" required="false" alternateLabel="CCell"/><font face="Arial" size="200" color="000000">       Land Line: </font><blank label="b" length="20" required="false" alternateLabel="CLand"/></paragraph></fib>
<fib label="Q5" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Other Email: </font><blank label="a" length="20" required="false" alternateLabel="CEmail2"/></paragraph></fib>
<fib label="Q6" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Introducing agent: </font><blank label="a" length="20" required="false" alternateLabel="AgentName"/><font face="Arial" size="200" color="000000">    Agent Email: </font><blank label="b" length="20" required="false" alternateLabel="AgentEmail"/></paragraph></fib>
<fib label="Q7" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enquiry Date: </font><font face="Arial" size="200" color="000000"><i>(dd/mm/yyyy)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="CDate"/></paragraph></fib>
<mc label="Q8" onlyone="false" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" color="000000"><b><u>Main Parameters</u></b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Commercial</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Residential</font></paragraph></choice></mc>
<text label="T3" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>In the following fields, please do not use commas in your numbers.</font></paragraph></text>
<mc label="Q9" alternateLabel="Denom" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Currency denomination:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddCurrency:NewCurrency"/>
</display-expression><value-expression><field name="Record:AddCurrency:NewCurrency"/>
</value-expression><sort-expression><field name="Record:AddCurrency:NewCurrency"/>
</sort-expression><record-selector><form name="AddCurrency" /></record-selector></dynamic-mcq></data-provider></mc>
<fib label="Q10" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cash Budget</font><font face="Arial" size="200" color="000000"><i> (in client's currency):</i></font><sp/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="20" required="false" alternateLabel="CashBudget"/><font face="Arial" size="200" color="000000"> max</font></paragraph></fib>
<fib label="Q11" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Investment Budget:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="20" required="false" alternateLabel="MinInvest"/><font face="Arial" size="200" color="000000"> min</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="b" length="20" required="false" alternateLabel="Maxinvest"/><font face="Arial" size="200" color="000000"> max</font></paragraph></fib>
<text label="T4"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Requirements - Location</u></b></font></paragraph></text>
<mc label="Q12" alternateLabel="Areas" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">General areas:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddArea:Area"/>
</display-expression><value-expression><field name="Record:AddArea:Area"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="AddArea" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q13" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">To add or delete general areas to list, check this box</font></paragraph></choice></mc>
<mc label="Q14" alternateLabel="Countries" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Specific countries:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddCountries:Country"/>
</display-expression><value-expression><field name="Record:AddCountries:Country"/>
</value-expression><sort-expression><field name="Record:AddCountries:Country"/>
</sort-expression><record-selector><form name="AddCountries" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q15" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">To add or delete specific countries to list, check this box</font></paragraph></choice></mc>
<mc label="Q16" alternateLabel="Cities" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cities:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddCities:City"/>
</display-expression><value-expression><field name="Record:AddCities:City"/>
</value-expression><sort-expression><field name="Record:AddCities:City"/>
</sort-expression><record-selector><form name="AddCities" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q17" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">To add or delete specific cities to list, check this box</font></paragraph></choice></mc>
<mc label="Q18" alternateLabel="Regions" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Regions:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddRegions:Region"/>
</display-expression><value-expression><field name="Record:AddRegions:Region"/>
</value-expression><sort-expression><field name="Record:AddRegions:Region"/>
</sort-expression><record-selector><form name="AddRegions" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q19" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">To add or delete specific regions to list, check this box</font></paragraph></choice></mc>
<text label="T5"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Requirements - Property</u></b></font></paragraph></text>
<mc label="Q20" alternateLabel="PropReqs" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddPropReqs:PropReq"/>
</display-expression><value-expression><field name="Record:AddPropReqs:PropReq"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="AddPropReqs" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q21" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">To add or delete specific property requirements, check this box</font></paragraph></choice></mc>
<fib label="Q22" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">No. of beds: </font><blank label="a" length="20" required="false" alternateLabel="NoBeds"/></paragraph></fib>
<text label="T6"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Requirements - Financial</u></b></font></paragraph></text>
<mc label="Q23" alternateLabel="Finreqs" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddFinReqs:FinReq"/>
</display-expression><value-expression><field name="Record:AddFinReqs:FinReq"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="AddFinReqs" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q24" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">To add or delete specific financial requirements, check this box</font></paragraph></choice></mc>
<fib label="Q25" style="leftAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Minimum  % LTV:     </font><font face="Arial" size="200" color="000000"><i>(if applicable)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="MinLTV"/><font face="Arial" size="200" color="000000">%</font></paragraph></fib>
<fib label="Q26" style="leftAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Minimum % Yield:     </font><font face="Arial" size="200" color="000000"><i>(if applicable)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="MinYield"/><font face="Arial" size="200" color="000000">%</font></paragraph></fib>
<mc label="Q27" onlyone="true" required="true"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Please select: </font><font face="Arial" size="200" color="000000"><i>(response required)</i></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Review and then save Client record</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Leave as is and return to Main Menu</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Abandon (delete) this Client record and return to Main Menu</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="ClientInfo:Q27" value="b"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="ClientInfo:CName" />
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Client name is required."/>
</set>
<skip to="H1"/>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="ClientInfo:CEmail" />
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Email address is required."/>
</set>
<skip to="H1"/>
</trueSet>
</if>
</skipInstructions>
<field name="IncludedRecord"/>
<field name="EuroCashBudget"/>
<field name="EuroInvestmentMin"/>
<field name="EuroInvestmentMax"/>
<field name="Record Status"/>
</items>
</form>
<form name="AddArea" startPoint="false" themePath="tennis" process="Process 2">
<items>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Don't try to add and delete at the same time.</font></paragraph></text>
<text label="T2"><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>1</number-of-columns><column><header>Areas</header><contents><field name="Record:AddArea:Area" /></contents></column><conditions><form name="AddArea" /></conditions></itemization-table></font></paragraph></text>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add area to list:  </font><blank label="a" length="20" required="false" alternateLabel="Area"/></paragraph></fib>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Delete area from list: </font><blank label="a" length="20" required="false" alternateLabel="AreatoDelete"/></paragraph></fib>
<mc label="Q3" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add another region</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return</font></paragraph></choice></mc>
</items>
</form>
<form name="AddCountries" startPoint="false" themePath="tennis" process="Process 4">
<items>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Don't try to add and delete at the same time.</font></paragraph></text>
<text label="T2"><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>1</number-of-columns><column><header>Country</header><contents><field name="Record:AddCountries:Country" /></contents></column><conditions><form name="AddCountries" /></conditions></itemization-table></font></paragraph></text>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add country to list: </font><blank label="a" length="20" required="false" alternateLabel="Country"/></paragraph></fib>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Delete country from list: </font><blank label="a" length="20" required="false" alternateLabel="Country2Delete"/></paragraph></fib>
<mc label="Q3" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add another country</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return</font></paragraph></choice></mc>
</items>
</form>
<form name="AddCities" startPoint="false" themePath="tennis" process="Process 5">
<items>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Don't try to add and delete at the same time.</font></paragraph></text>
<text label="T2"><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>1</number-of-columns><column><header>City</header><contents><field name="Record:AddCities:City" /></contents></column><conditions><form name="AddCities" /></conditions></itemization-table></font></paragraph></text>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add city to list: </font><blank label="a" length="20" required="false" alternateLabel="City"/></paragraph></fib>
