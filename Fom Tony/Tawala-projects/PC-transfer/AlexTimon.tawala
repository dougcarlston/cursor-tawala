</forms>
<processes>
<process name="Process 1">
<delete><form name="ClientInfo"/><conditions>
<equals field="Record:ClientInfo:Record Status">
<string value="Delete"/>
</equals>
</conditions></delete>
<set field="Message" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcEquals field="Start:Q1" value="a"/>
</conditions>
<trueSet>
<if>
<conditions>
<isBlank field="Start:ClientString" />
</conditions>
<trueSet>
<show form="ClientInfo"/>
</trueSet>
<falseSet>
<set field="Flag" arithmeticAsText="false">
<string value="No"/>
</set>
<get recordList="Record List 2">
<forms>
<form name="ClientInfo"/>
</forms>
<conditions>
<contains field="Record List 2:ClientInfo:CName">
<string field="Start:ClientString"/>
</contains>
</conditions></get>
<foreach record="Success" recordList="Record List 2">
<set field="Flag" arithmeticAsText="false">
<string value="Yes"/>
</set>
</foreach>
<if>
<conditions>
<equals field="Flag">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<show form="EditDelRecord"/>
</trueSet>
<falseSet>
<set field="Message" arithmeticAsText="false">
<string value="No records matched that string."/>
</set>
<show document="Message" reset="false"/>
<show form="Start"/>
</falseSet>
</if>
</falseSet>
</if>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Start:Q1" value="b"/>
</conditions>
<trueSet>
<show form="Filter"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Start:Q1" value="c"/>
</conditions>
<trueSet>
<set field="Flag" arithmeticAsText="false">
<string value="No"/>
</set>
<get recordList="Record List 6">
<forms>
<form name="ClientInfo"/>
</forms>
<conditions>
<equals field="Record List 6:ClientInfo:IncludedRecord">
<string value="Yes"/>
</equals>
</conditions></get>
<foreach record="PossibleRecord" recordList="Record List 6">
