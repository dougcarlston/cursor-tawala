<form name="EditDelRecord" startPoint="false" themePath="tennis" process="Process 9">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Edit/Delete Record</font></paragraph></heading>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Mark the record you wish to edit or delete </font><font face="Arial" size="200" color="000000"><i>(leave unmarked if you don't see the name you are looking for)</i></font><font face="Arial" size="200" color="000000">:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:ClientInfo:CName"/>
<string value=" ("/>
<field name="Record:ClientInfo:Record Status"/>
<string value=")"/>
</display-expression><value-expression><field name="Record:ClientInfo:CEmail"/>
</value-expression><sort-expression><field name="Record:ClientInfo:CName"/>
</sort-expression><record-selector><form name="ClientInfo" /><conditions>
<contains field="Record:ClientInfo:CName">
<string field="Start:ClientString"/>
</contains>
</conditions></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q2" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Action to take:</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit this record</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Delete this record</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Make record inactive</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Make record active</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return to Main Menu</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcDoesNotEqual field="EditDelRecord:Q2" value="b"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<heading label="H2" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Delete Record</font></paragraph></heading>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Delete the following record:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>3</number-of-columns><column><header>Name</header><contents><field name="Record:ClientInfo:CName" /></contents></column><column><header>Email</header><contents><field name="Record:ClientInfo:CEmail" /></contents></column><column><header>Status</header><contents><field name="Record:ClientInfo:Record Status" /></contents></column><conditions><form name="ClientInfo" /><conditions>
<mcEquals field="EditDelRecord:Q1">
<string field="Record:ClientInfo:CEmail"/>
</mcEquals>
</conditions></conditions></itemization-table></font></paragraph></text>
<mc label="Q3" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Are you sure?</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Yes</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">No, I changed my mind.</font></paragraph></choice></mc>
</items>
</form>
<form name="Filter" startPoint="false" themePath="tennis" process="Process 11" preProcess="Process 30">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Set Filter Criteria</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Only clients who match a marked category under Main Parameters will be included. </font></paragraph></text>
<mc label="Q1" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b><u>Main Parameters</u></b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Commercial</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Residential</font></paragraph></choice></mc>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cash Budget: </font><blank label="a" length="20" required="false" alternateLabel="CashBudParam"/></paragraph></fib>
<fib label="Q3" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Investment Budget: </font><blank label="a" length="20" required="false" alternateLabel="InvestBudParam"/></paragraph></fib>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Clients who match ANY category in any  location parameter will be included.</font></paragraph></text>
<text label="T3"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Location Parameters</u></b></font></paragraph></text>
<mc label="Q4" alternateLabel="AreaParam" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Areas</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddArea:Area"/>
</display-expression><value-expression><field name="Record:AddArea:Area"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="AddArea" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q5" alternateLabel="CountryParam" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Countries</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddCountries:Country"/>
</display-expression><value-expression><field name="Record:AddCountries:Country"/>
</value-expression><sort-expression><field name="Record:AddCountries:Country"/>
</sort-expression><record-selector><form name="AddCountries" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q6" alternateLabel="CityParam" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cities</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddCities:City"/>
</display-expression><value-expression><field name="Record:AddCities:City"/>
</value-expression><sort-expression><field name="Record:AddCities:City"/>
</sort-expression><record-selector><form name="AddCities" /></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q7" alternateLabel="RegionParam" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Regions</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddRegions:Region"/>
</display-expression><value-expression><field name="Record:AddRegions:Region"/>
</value-expression><sort-expression><field name="Record:AddRegions:Region"/>
</sort-expression><record-selector><form name="AddRegions" /></record-selector></dynamic-mcq></data-provider></mc>
<text label="T4" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Only Clients who match one of the location parameters AND one of the parameters in  Property Requirements will be included.  However, if no Property Requirements parameters are marked, the section will be ignored.</font></paragraph></text>
<text label="T5"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Property Requirements Parameters</u></b></font></paragraph></text>
<mc label="Q8" alternateLabel="PropParams" onlyone="false" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddPropReqs:PropReq"/>
</display-expression><value-expression><field name="Record:AddPropReqs:PropReq"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="AddPropReqs" /></record-selector></dynamic-mcq></data-provider></mc>
<fib label="Q9" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">No. of beds: </font><blank label="a" length="20" required="false" alternateLabel="MinBedsParam"/></paragraph></fib>
<text label="T6" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Only Clients who match one one of the location parameters, one of the Property Requirements and one of the Financial Requirements Parameters will be included.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>However if all of the Financial Requirements or Property Requirements parameters are left blank, that section will be ignored.</font></paragraph></text>
<text label="T7"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><u>Financial Requirements Parameters</u></b></font></paragraph></text>
<mc label="Q10" alternateLabel="FinParams" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:AddFinReqs:FinReq"/>
</display-expression><value-expression><field name="Record:AddFinReqs:FinReq"/>
</value-expression><sort-expression></sort-expression><record-selector><form name="AddFinReqs" /></record-selector></dynamic-mcq></data-provider></mc>
<fib label="Q11" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Minimum %LTV: </font><font face="Arial" size="200" color="000000"><i>(if applicable)</i></font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="20" required="false" alternateLabel="LTVParam"/><font face="Arial" size="200" color="000000">%</font></paragraph></fib>
<fib label="Q12" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Minimum Yield: </font><font face="Arial" size="200" color="000000"><i>(if applicable)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="MinYldParam"/><font face="Arial" size="200" color="000000"> %</font></paragraph></fib>
</items>
</form>
<form name="SearchRecords" startPoint="false" themePath="tennis" process="Process 12">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">View Client Records</font></paragraph></heading>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">See all active client records</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">See records matching current search criteria</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">See inactive client records</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Return to Main Menu</font></paragraph></choice></mc>
</items>
</form>
