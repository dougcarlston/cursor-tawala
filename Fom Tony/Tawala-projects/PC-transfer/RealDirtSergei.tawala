<process name="Post-AdminPlayerReg">
<set field="From" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcEquals field="AdminPlayerRegistration:Q1" value="a"/>
</conditions>
<trueSet>
<set field="Bounceback" arithmeticAsText="false">
<string value="RegisterPlayer"/>
</set>
<show form="Registration"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="AdminPlayerRegistration:Q1" value="b"/>
</conditions>
<trueSet>
<if>
<conditions>
<or>
<isBlank field="AdminPlayerRegistration:EmailAddress" />
<or>
<doesNotContain field="AdminPlayerRegistration:EmailAddress">
<string value="."/>
</doesNotContain>
<or>
<contains field="AdminPlayerRegistration:EmailAddress">
<string value=" "/>
</contains>
<or>
<doesNotContain field="AdminPlayerRegistration:EmailAddress">
<string value="@"/>
</doesNotContain>
<contains field="AdminPlayerRegistration:EmailAddress">
<string value=","/>
</contains>
</or>
</or>
</or>
</or>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="No valid email address detected."/>
</set>
<show document="Message" reset="false"/>
<show form="AdminPlayerRegistration"/>
</trueSet>
<falseSet>
<comment>Send link to Registration Form to someone</comment>
<send>
<to addressField="AdminPlayerRegistration:EmailAddress"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject>Dirt Bowl Registration</subject>
<body document="RegFormLink" reset="false"/>
</send>
<set field="Message" arithmeticAsText="false">
<string value="The link to Dirt Bowl has been emailed."/>
</set>
<show document="Message" reset="false"/>
<show form="RegFormManagement"/>
</falseSet>
</if>
</trueSet>
</if>
