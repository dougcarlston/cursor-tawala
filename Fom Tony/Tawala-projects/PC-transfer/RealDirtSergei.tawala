<string value=" "/>
<string field="Coach:LastName"/>
</set>
<if>
<conditions>
<isBlank field="Coach:CoachId" />
</conditions>
<trueSet>
<comment>-- New record</comment>
<set field="Coach:CoachId" arithmeticAsText="false">
<string value="0"/>
</set>
<get recordList="PreviousCoaches">
<forms>
<form name="Coach"/>
</forms>
</get>
<foreach record="Record" recordList="PreviousCoaches">
<if>
<conditions>
<isLessThanOrEqualTo field="Coach:CoachId">
<string field="Record:Coach:CoachId"/>
</isLessThanOrEqualTo>
</conditions>
<trueSet>
<set field="Coach:CoachId" arithmeticAsText="false">
<add>
<operand field="Record:Coach:CoachId"/>
<operand value="1"/>
</add>
</set>
</trueSet>
</if>
</foreach>
</trueSet>
<falseSet>
<comment>-- The record has been edited</comment>
<get recordList="AllTeamsForThisCoach">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="AllTeamsForThisCoach:Team:CoachId">
<string field="Coach:CoachId"/>
</equals>
</conditions></get>
<foreach record="SuchTeam" recordList="AllTeamsForThisCoach">
<set field="SuchTeam:Team:CoachFullName" arithmeticAsText="false">
<string field="Coach:FullName"/>
</set>
</foreach>
</falseSet>
</if>
<if>
<conditions>
<isBlank field="_InviteeID" />
</conditions>
<trueSet>
<comment>-- This is admin adding/editing the record</comment>
<show form="TeamAndCoachMenu"/>
</trueSet>
<falseSet>
<comment>-- The coach editing his record</comment>
<show form="CoachDashboard"/>
</falseSet>
</if>
</process>
<process name="Post-CoachToTeamAssignment">
<get recordList="CoachRecords">
<forms>
<form name="Coach"/>
</forms>
<conditions>
<equals field="CoachRecords:Coach:CoachId">
<string field="CoachToTeamAssignment:CoachId"/>
</equals>
</conditions></get>
<foreach record="Record" recordList="CoachRecords">
<get recordList="TeamRecords">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="TeamRecords:Team:TeamId">
<string field="CoachToTeamAssignment:TeamId"/>
</equals>
</conditions></get>
<foreach record="FoundTeam" recordList="TeamRecords">
<set field="FoundTeam:Team:CoachId" arithmeticAsText="false">
<string field="Record:Coach:CoachId"/>
</set>
<set field="FoundTeam:Team:CoachFullName" arithmeticAsText="false">
<string field="Record:Coach:FullName"/>
</set>
</foreach>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-EditCoach">
<edit form="Coach" submit="modify">
<conditions>
<equals field="Record:Coach:CoachId">
<string field="EditCoach:CoachId"/>
</equals>
</conditions>
</edit>
<comment>-- If the coach is not selected this statement will get executed</comment>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-DeleteTeam">
<delete><form name="Team"/><conditions>
<equals field="Record:Team:TeamId">
<string field="DeleteTeam:TeamId"/>
</equals>
</conditions></delete>
<get recordList="Player List">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<equals field="Player List:Registration:TeamId">
<string field="DeleteTeam:TeamId"/>
</equals>
</conditions></get>
<foreach record="Team Player Record" recordList="Player List">
<set field="Team Player Record:Registration:TeamId" arithmeticAsText="false">
<string value=" "/>
</set>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-DeleteCoach">
<delete><form name="Coach"/><conditions>
<equals field="Record:Coach:CoachId">
<string field="DeleteCoach:CoachId"/>
</equals>
</conditions></delete>
<get recordList="CoachesTeams">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="CoachesTeams:Team:CoachId">
<string field="DeleteCoach:CoachId"/>
</equals>
</conditions></get>
<foreach record="SuchTeam" recordList="CoachesTeams">
<set field="SuchTeam:Team:CoachId" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="SuchTeam:Team:CoachFullName" arithmeticAsText="false">
<string value=" "/>
</set>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-UnassignCoachFromTeam">
<get recordList="TeamList">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="TeamList:Team:TeamId">
<string field="UnassignCoachFromTeam:TeamId"/>
</equals>
</conditions></get>
<foreach record="SuchTeam" recordList="TeamList">
<set field="SuchTeam:Team:CoachId" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="SuchTeam:Team:CoachFullName" arithmeticAsText="false">
<string value=" "/>
</set>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-EditMyRegistrationRecord">
<edit form="Registration" submit="modify">
<conditions>
<equals field="Record:Registration:RegID">
<string field="_InviteeID"/>
</equals>
</conditions>
</edit>
<comment>-- In case the record wasn't found</comment>
<show document="NoPlayerDash" reset="false"/>
</process>
<process name="Pre-Coach">
<if>
<conditions>
<isNotBlank field="_InviteeID" />
</conditions>
<trueSet>
<comment>-- This is the case of coaches editing their records</comment>
<edit form="Coach" submit="modify">
<conditions>
<equals field="Record:Coach:CoachId">
<string field="_InviteeID"/>
</equals>
</conditions>
</edit>
</trueSet>
</if>
</process>
<process name="Post-CoachCommunicator">
<if>
<conditions>
<equals field="Count">
<string value="1"/>
</equals>
</conditions>
<trueSet>
<set field="ToField" arithmeticAsText="false">
<string field="TeamNames"/>
</set>
</trueSet>
<falseSet>
<set field="ToField" arithmeticAsText="false">
<string value=" "/>
</set>
<get recordList="Record List 73">
<forms>
<form name="Team"/>
</forms>
<conditions>
<mcContains field="CoachCommunicator:Q5">
<string field="Record List 73:Team:TeamId"/>
</mcContains>
</conditions></get>
<foreach record="SelectedTeam" recordList="Record List 73">
<if>
<conditions>
<isBlank field="ToField" />
</conditions>
<trueSet>
<set field="ToField" arithmeticAsText="true">
<string field="SelectedTeam:Team:TeamId"/>
</set>
</trueSet>
<falseSet>
<set field="ToField" arithmeticAsText="true">
<string field="SelectedTeam:Team:TeamId"/>
<string value=" / "/>
<string field="ToField"/>
</set>
</falseSet>
</if>
</foreach>
</falseSet>
</if>
<set field="DearSir" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcEquals field="CoachCommunicator:Q2" value="a"/>
</conditions>
<trueSet>
<set field="DearSir" arithmeticAsText="false">
<string value="Dear Jimmy,"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="CoachCommunicator:Q2" value="b"/>
</conditions>
<trueSet>
<set field="DearSir" arithmeticAsText="false">
<string value="Dear Wilbur,"/>
</set>
</trueSet>
</if>
<show form="CoachCommunicatorSend"/>
</process>
<process name="Post-CoachCommunicatorSend">
<if>
<conditions>
<mcEquals field="CoachCommunicatorSend:Q1" value="b"/>
</conditions>
<trueSet>
<show form="CoachCommunicator"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="CoachCommunicatorSend:Q1" value="c"/>
</conditions>
<trueSet>
<show form="CoachDashboard"/>
</trueSet>
</if>
<if>
<conditions>
<mcDoesNotEqual field="CoachCommunicatorSend:Q1" value="a"/>
</conditions>
<trueSet>
<show form="CoachCommunicatorSend"/>
</trueSet>
</if>
<set field="MessageBody" arithmeticAsText="false">
<string field="CoachCommunicator:Body"/>
</set>
<set field="MessageClose" arithmeticAsText="false">
<string field="CoachCommunicator:Close"/>
</set>
<set field="DearSir" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="Count" arithmeticAsText="false">
<string value="0"/>
</set>
<get recordList="Record List 74">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<mcContains field="CoachCommunicator:Q5">
<string field="Record List 74:Registration:TeamId"/>
</mcContains>
</conditions></get>
<foreach record="TeamPlayer" recordList="Record List 74">
<if>
<conditions>
<mcEquals field="CoachCommunicator:Q2" value="a"/>
</conditions>
<trueSet>
<set field="DearSir" arithmeticAsText="false">
<string value="Dear "/>
<string field="TeamPlayer:Registration:FirstName"/>
<string value=","/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="CoachCommunicator:Q2" value="b"/>
</conditions>
<trueSet>
<set field="DearSir" arithmeticAsText="false">
<string value="Dear "/>
<string field="TeamPlayer:Registration:ParentFirstName"/>
<string value=","/>
</set>
</trueSet>
</if>
<set field="Count" arithmeticAsText="false">
<add>
<operand field="Count"/>
<operand value="1"/>
</add>
</set>
<send>
<to addressField="TeamPlayer:Registration:ParentEmail"/>
<from addressField="CoachsEmail" aliasField="CoachID"/>
<subject><field name="CoachCommunicator:Subject"/></subject>
<body document="Letter" reset="false"/>
</send>
</foreach>
<set field="Message" arithmeticAsText="false">
<string value="Email sent to "/>
<string field="Count"/>
<string value=" players."/>
</set>
<show document="Message" reset="false"/>
<show form="CoachDashboard"/>
</process>
<process name="Post-AddGroupRegistrationPlayer">
<get recordList="TeamAndCoachList">
<forms>
<form name="Team"/>
<form name="Coach"/>
</forms>
<conditions>
<and>
<equals field="TeamAndCoachList:Team:TeamId">
<string field="GroupRegistration:TeamId"/>
</equals>
<equals field="TeamAndCoachList:Team:CoachId">
<string field="TeamAndCoachList:Coach:CoachId"/>
</equals>
</and>
</conditions></get>
<foreach record="SuchCoach" recordList="TeamAndCoachList">
<set field="Coach" arithmeticAsText="false">
<string field="SuchCoach:Coach:FullName"/>
</set>
</foreach>
<set field="From" arithmeticAsText="false">
<string value="AddPlayerToGroupRegistration"/>
</set>
<show form="Registration"/>
</process>
<process name="Post-TeamEdit">
<edit form="Team" submit="modify">
<conditions>
<equals field="Record:Team:TeamId">
<string field="EditTeam:TeamId"/>
</equals>
</conditions>
</edit>
<comment>-- This will trigger in case the team wasn't selected</comment>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-AddPlayerToExistingGroupRegistration">
<if>
<conditions>
<mcIsBlank field="AddPlayerToExistingGroupRegistration:GroupRegistrationId" />
</conditions>
<trueSet>
<show form="GroupRegistration"/>
</trueSet>
</if>
<get recordList="Group Registrations">
<forms>
<form name="GroupRegistration"/>
</forms>
<conditions>
<equals field="Group Registrations:GroupRegistration:GroupRegistrationId">
<string field="AddPlayerToExistingGroupRegistration:GroupRegistrationId"/>
</equals>
</conditions></get>
<foreach record="SuchRegistration" recordList="Group Registrations">
<set field="Team" arithmeticAsText="false">
<string field="SuchRegistration:GroupRegistration:TeamId"/>
</set>
</foreach>
<set field="GroupRegistationId" arithmeticAsText="false">
<string field="AddPlayerToExistingGroupRegistration:GroupRegistrationId"/>
</set>
<show form="AddPlayerToGroupRegistration"/>
</process>
</processes>
<documents>
<document name="AdminDashboard">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="10095"><division indent="0" align="center"><font face="Times New Roman" size="360"><b><field name="AdminName"/></b></font><font face="Times New Roman" size="360"><b>'s Dirt Bowl Administrator Dashboard</b></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="210"></cell><cell width="1140"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="AdminSiteMap" project="">Site Map</invitation></u></font></division></cell><cell width="1170"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="Preseason" project="">Pre-Season</invitation></u></font></division></cell><cell width="1380"><division indent="0" align="center"><font face="Arial" size="200" color="000080"><u><invitation form="ShowContactFields" project="">Player Info</invitation></u></font></division></cell><cell width="2115"><division indent="0" align="center"><font face="Arial" size="200" color="000080"><u><invitation form="TeamAndCoachMenu" project="">Teams and Coaches</invitation></u></font></division></cell><cell width="1650"><division indent="0" align="center"><font face="Arial" size="200" color="000080"><u><invitation form="ShowTeamRosters" project="">Team Rosters</invitation></u></font></division></cell><cell width="1725"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="Communicator" project="">Communicator</invitation></u></font></division></cell><cell width="526"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="Tools" project="">Tools</invitation></u></font></division></cell><cell width="200"></cell></row><row><cell width="210"></cell><cell width="1140"></cell><cell width="1170"></cell><cell width="1380"></cell><cell width="2115"></cell><cell width="1650"></cell><cell width="1725"></cell><cell width="526"></cell><cell width="200"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2340"><division indent="0" align="left"><font><b>Basic Info:</b></font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><font face="Arial" size="200" color="0000A0"><u><invitation form="AdminSetup" project="">edit</invitation></u></font></division></cell><cell width="4695"><division indent="0" align="center"><font><b>Pre-Season Items Status:     </b></font></division></cell><cell width="765"></cell></row><row><cell width="2340"><division indent="0" align="right"><font>League:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="League"/></font></division></cell><cell width="4695"><division indent="0" align="right"><font>Jerseys ordered:</font></division></cell><cell width="765"><division indent="0" align="right"><font face="Arial" size="200" color="000000"><field name="UniFlag"/></font></division></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Season:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="SeasonYr"/></font></division></cell><cell width="4695"><division indent="0" align="right"><font>Team &amp; Coach info complete:</font></division></cell><cell width="765"><division indent="0" align="right"><font face="Arial" size="200" color="000000"><field name="TeamFlag"/></font></division></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminName"/></font></division></cell><cell width="4695"><division indent="0" align="right"><font>All Launch Countdown items completed:</font></division></cell><cell width="765"><division indent="0" align="right"><font face="Arial" size="200" color="000000"><field name="LaunchDone"/></font></division></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator Email:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminEmail"/></font></division></cell><cell width="4695"></cell><cell width="765"></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator Phone:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminsPhone"/></font></division></cell><cell width="4695"></cell><cell width="765"></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator Address:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminAdrss"/></font></division></cell><cell width="4695"></cell><cell width="765"></cell></row><row><cell width="2340"></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminsCity"/></font><font>, </font><font><field name="AdminState"/></font><sp/><font><field name="AdminsZIP"/></font></division></cell><cell width="4695"></cell><cell width="765"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="3735"><division indent="0" align="left"><font><b>Options:</b></font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="center"><font face="Arial" size="180" color="0000A0"><u><invitation form="AdminSetup" project="">edit</invitation></u></font></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="center"><font><b>Statistics:</b></font></division></cell><cell width="720"></cell></row><row><cell width="3735"><division indent="0" align="right"><font>Email Notification Options       </font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="right"><sp/></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Recruiting List:</font></division></cell><cell width="720"><division indent="0" align="right"><font face="Arial" size="200"><record-count version="3"><form-name>RecruitmentDB</form-name><conditions><form name="RecruitmentDB" /><conditions>
<and>
<isNotBlank field="Record:RecruitmentDB:FirstName" />
<isNotBlank field="Record:RecruitmentDB:Email" />
</and>
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3735"><division indent="0" align="right"><font><i>Upon each new registration:</i></font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="left"><font face="Arial" size="200"><field name="FlagA"/></font></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Registrations:</font></division></cell><cell width="720"><division indent="0" align="right"><font face="Arial" size="200"><record-count version="3"><form-name>Registration</form-name><conditions><form name="Registration" /></conditions></record-count></font></division></cell></row><row><cell width="3735"><division indent="0" align="right"><font><i>Upon each bulk mailing:</i></font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="left"><font face="Arial" size="200"><field name="FlagB"/></font></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Waivers turned in:</font></division></cell><cell width="720"><division indent="0" align="right"><font face="Arial" size="200"><record-count version="3"><form-name>Registration</form-name><conditions><form name="Registration" /><conditions>
<isNotBlank field="Record:Registration:WaiverReceived" />
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3735"></cell><cell width="255"></cell><cell width="510"></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Payment received:</font></division></cell><cell width="720"><division indent="0" align="right"><font face="Arial" size="200"><record-count version="3"><form-name>Registration</form-name><conditions><form name="Registration" /><conditions>
<isNotBlank field="Record:Registration:PaymentReceived" />
</conditions></conditions></record-count></font></division></cell></row></table>
