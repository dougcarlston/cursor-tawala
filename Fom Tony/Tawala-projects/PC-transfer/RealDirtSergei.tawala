</document>
<document name="PlayerDashboard">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="10800"><division indent="0" align="center"><font face="Times New Roman" size="360"><b><field name="PlayerFirst"/></b></font><sp/><sp/><font face="Times New Roman" size="360"><b><field name="PlayerLast"/></b></font><font face="Times New Roman" size="360"><b>'s Dirt Bowl Player Dashboard</b></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2010"></cell><cell width="4590"><division indent="0" align="left"><font face="Arial" size="200" color="000080"><u><invitation form="EditMyRegistrationRecord" project="">View/Edit Registration &amp; Waiver</invitation></u></font></division></cell><cell width="795"></cell><cell width="1695"><division indent="0" align="left"><font face="Arial" size="200" color="000080"><u><link><description><string value="Schedule"/></description><url><string value="http://www.dirtbowl.com/Site/Welcome.html"/></url></link></u></font></division></cell><cell width="1695"></cell></row><row><cell width="2010"></cell><cell width="4590"><division indent="0" align="left"><sp/></division></cell><cell width="795"></cell><cell width="1695"></cell><cell width="1695"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2430"><division indent="0" align="right"><font><b>Your Team:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="Team"/></font></division></cell><cell width="2910"><division indent="0" align="right"><font>Payment Status:</font></division></cell><cell width="272"></cell><cell width="2218"><division indent="0" align="left"><font><field name="PaymentStatusMessage"/></font></division></cell></row><row><cell width="2430"><division indent="0" align="right"><font><b>League:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="League"/></font></division></cell><cell width="2910"></cell><cell width="272"></cell><cell width="2218"></cell></row><row><cell width="2430"><division indent="0" align="right"><font><b>Season:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="SeasonYr"/></font></division></cell><cell width="2910"></cell><cell width="272"></cell><cell width="2218"></cell></row><row><cell width="2430"></cell><cell width="272"></cell><cell width="2698"></cell><cell width="2910"></cell><cell width="272"></cell><cell width="2218"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2415"><division indent="0" align="right"><font><b>Coach:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="Coach"/></font></division></cell><cell width="272"></cell><cell width="2818"><division indent="0" align="right"><font><b>Dirt Bowl Athletic Director</b></font></division></cell><cell width="200"></cell><cell width="2245"><division indent="0" align="left"><font><field name="AdminName"/></font></division></cell></row><row><cell width="2415"><division indent="0" align="right"><font><b>Coach's Phone:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="CoachsPhone"/></font></division></cell><cell width="272"></cell><cell width="2818"><division indent="0" align="right"><font><b>Dirt Bowl Phone:</b></font></division></cell><cell width="200"></cell><cell width="2245"><division indent="0" align="left"><font><field name="AdminsPhone"/></font></division></cell></row><row><cell width="2415"><division indent="0" align="right"><font><b>Alternate Phone:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="CoachsPhone1"/></font></division></cell><cell width="272"></cell><cell width="2818"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="200"></cell><cell width="2245"><division indent="0" align="left"><font><field name="AdminAdrss"/></font></division></cell></row><row><cell width="2415"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="CoachsEmail"/></font></division></cell><cell width="272"></cell><cell width="2818"></cell><cell width="200"></cell><cell width="2245"><division indent="0" align="left"><font><field name="AdminsCity"/></font><font>, </font><font><field name="AdminState"/></font><sp/><font><field name="AdminsZIP"/></font></division></cell></row></table>
</xmlData>
</document>
<document name="PostRegistrationLetterWithPaymentInstructions">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="Registration:FirstName"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Thank you for registering for this season's Dirt Bowl.  This email is to acknowledge </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>your registration.  However, don't forget -- your registration is not complete until your</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>$</font><font><field name="SignupFeeForIndividual"/></font><font> payment and your medical waiver have been received.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Both the payment and the waiver can be mailed to the following address:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>Dirt Bowl</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><field name="AdminAdrss"/></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><field name="AdminsCity"/></font><sp/><font><field name="AdminState"/></font><font>, </font><font><field name="AdminsZIP"/></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you need any information about the season, you can always look at our Web site </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>at http://www.dirtbowl.com.  For dealing with personal information like reviewing or </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>changing your registration info, checking your team roster or schedule and the like, </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>use the link below.  This is your personal link.  Do not share it with others.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Here it is:  </font><font color="000080"><u><invitation form="PlayerDash" project="" private="true"><authenticationTokenValue><string field="Registration:RegID"/>
</authenticationTokenValue>Player's Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>To save this link, click on it.  A Dirt Bowl Web page will come up, your personal page. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Saving this link depends upon which browser you use:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>If you use Internet Explorer, click on "Favorites" in the Menu Bar at top and </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>then "Add to Favorites."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>If you use Firefox, click on "Bookmarks" in the Menu Bar at top and then </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>"Bookmark this Page."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>If you use Safari, click on "Bookmarks" and then "Add Bookmarks."</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You'll get your team roster and schedule by email once they've been completed, but </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>they will also always be available to you on your Dashboard.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>I'm looking forward to seeing you at the Dirt Bowl games this season!</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Yours,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="AdminName"/></font></paragraph>
</xmlData>
</document>
<document name="AdminRegNotification">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>A registration form has been received for </font><font><field name="Registration:FirstName"/></font><sp/><font><field name="Registration:LastName"/></font><font>. Here is the registration info:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="735"><row><cell width="2205"><division indent="0" align="right"><font><b>Player's Name:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:FirstName"/></font><sp/><font><field name="Registration:LastName"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Date of Birth:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:RegAgeMo"/></font><font>/</font><font><field name="Registration:RegAgeDay"/></font><font>/</font><font><field name="Registration:RegAgeYr"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Sex:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:Sex"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Parent's Name:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:ParentFirstName"/></font><sp/><font><field name="Registration:ParentLastName"/></font></division></cell></row><row><cell width="2205"></cell><cell width="330"></cell><cell width="7530"></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:Address"/></font></division></cell></row><row><cell width="2205"></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:City"/></font><font>, CA </font><font><field name="Registration:Zip"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:ParentEmail"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Home Phone:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:ParentHomePhone"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Work Phone:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:ParentWorkPhone"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Mobile:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:ParentMobilePhone"/></font></division></cell></row><row><cell width="2205"></cell><cell width="330"></cell><cell width="7530"></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Friends Requested:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:Friend:a"/></font><sp/><sp/><sp/><font><field name="Registration:Friend:b"/></font><sp/><sp/><sp/><font><field name="Unknown Field"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Shirt Size:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font color="000000"><field name="Registration:UniformSize"/></font></division></cell></row><row><cell width="2205"></cell><cell width="330"></cell><cell width="7530"></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Medical Plan Name:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:MedPlanName"/></font></division></cell></row><row><cell width="2205"><division indent="0" align="right"><font><b>Plan Number:</b></font></division></cell><cell width="330"></cell><cell width="7530"><division indent="0" align="left"><font><field name="Registration:MedPlanNumber"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">In case of loss, here is the link to </font><font color="000000"><field name="Registration:FirstName"/></font><font color="000000">'s private </font><font color="000080"><u><invitation form="PlayerDash" project="" private="true"><authenticationTokenValue><string field="Registration:RegID"/>
</authenticationTokenValue>Player Dashboard</invitation></u></font><font color="000000">.</font></paragraph>
</xmlData>
</document>
<document name="PlayerDashboardReminder">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="PlayerFirst"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Your personal Dirt Bowl link is </font><font color="000080"><u><invitation form="PlayerRegLink" project="" private="true"><authenticationTokenValue><string field="PlayerID"/>
</authenticationTokenValue>here</invitation></u></font><font>.  Clicking on this link will take you to </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>your private Dirt Bowl Player Dashboard.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">To save this link, click on it.  A Dirt Bowl Web page will come up, your personal page. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">Saving this link depends upon which brower you use:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Internet Explorer, click on "Favorites" in the Menu Bar at top and </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">then "Add to Favorites."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Firefox, click on "Bookmarks" in the Menu Bar at top and then </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">"Bookmark this Page."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Safari, click on "Bookmarks" and then "Add Bookmarks."</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Be sure to save this link in a safe place.  You can use it to review or </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>change your registration and to see personal information, such as your </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>team assignment and team roster, season schedule and the like.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>For general information about Dirt Bowl, you can always go to: </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>http://www.dirtbowl.com.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Yours,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="AdminName"/></font></paragraph>
</xmlData>
</document>
<document name="Message">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i><field name="Message"/></i></b></font></paragraph>
</xmlData>
</document>
<document name="Roster Selection Criteria">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240"><b>Registration Records - Team Rosters</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="RegFormManagement" project="">Back to Registration Management</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ShowWaiverPaymentFields" project="">Waivers &amp; Payments</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowRosterCriteria" project="">Team Rosters</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowContactFields" project="">Contact Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowMedicalFields" project="">Medical Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowAllFields" project="">All Fields</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>7</number-of-columns><column><header>Team</header><contents><field name="Record:Team:TeamId" /></contents></column><column><header>First</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Age</header><contents><field name="Record:Registration:PlayerAge" /></contents></column><column><header>Sex</header><contents><field name="Record:Registration:Sex" /></contents></column><column><header>Uniform</header><contents><field name="Record:Registration:UniformSize" /></contents></column><column><header>Friends</header><contents><field name="Record:Registration:FriendsList" /></contents></column><conditions><form name="Team" /><form name="Registration" /><conditions>
<equals field="Record:Registration:TeamId">
<string field="Record:Team:TeamId"/>
</equals>
</conditions></conditions></itemization-table></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="RegFormManagement" project="">Back to Registration Management</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ShowWaiverPaymentFields" project="">Waivers &amp; Payments</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowRosterCriteria" project="">Team Rosters</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowContactFields" project="">Contact Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowMedicalFields" project="">Medical Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowAllFields" project="">All Fields</invitation></u></font></paragraph>
</xmlData>
