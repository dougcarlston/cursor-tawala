<document name="Contact Fields">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240"><b>Registration Records - Contact Info</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="RegFormManagement" project="">Back to Registration Management</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ShowWaiverPaymentFields" project="">Waivers &amp; Payments</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowRosterCriteria" project="">Team Rosters</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowContactFields" project="">Contact Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowMedicalFields" project="">Medical Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowAllFields" project="">All Fields</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>10</number-of-columns><column><header>First</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Parent</header><contents><field name="Record:Registration:ParentFirstName" /></contents></column><column><header>Home</header><contents><field name="Record:Registration:ParentHomePhone" /></contents></column><column><header>Work</header><contents><field name="Record:Registration:ParentWorkPhone" /></contents></column><column><header>Mobile</header><contents><field name="Record:Registration:ParentMobilePhone" /></contents></column><column><header>Address</header><contents><field name="Record:Registration:Address" /></contents></column><column><header>City</header><contents><field name="Record:Registration:City" /></contents></column><column><header>Zip</header><contents><field name="Record:Registration:Zip" /></contents></column><column><header>Email</header><contents><field name="Record:Registration:ParentEmail" /></contents></column><conditions><form name="Registration" /></conditions></itemization-table></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="RegFormManagement" project="">Back to Registration Management</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ShowWaiverPaymentFields" project="">Waivers &amp; Payments</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowRosterCriteria" project="">Team Rosters</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowContactFields" project="">Contact Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowMedicalFields" project="">Medical Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowAllFields" project="">All Fields</invitation></u></font></paragraph>
</xmlData>
</document>
<document name="Medical Info">
<xmlData>
