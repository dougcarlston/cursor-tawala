<form name="CoachCommunicator" startPoint="false" themePath="dirtbowl2" dataEntryOnly="true" process="Post-CoachCommunicator">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Communicator</font></paragraph></heading>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Subject: </font><blank label="a" length="57" required="false" alternateLabel="Subject"/></paragraph></fib>
<mc label="Q2" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Choice of Salutation</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Player's first name </font><font face="Arial" size="200" color="000000"><i>("Dear Jimmy")</i></font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Parent's first name </font><font face="Arial" size="200" color="000000"><i>("Dear Wilbur")</i></font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Don't create a personalized salutation</font></paragraph></choice></mc>
<fib label="Q3" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enter the body of your message:  </font><blank label="a" length="57" height="10" required="false" alternateLabel="Body"/></paragraph></fib>
<fib label="Q4" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enter your closing:  </font><blank label="a" length="57" height="5" required="false" alternateLabel="Close"/></paragraph></fib>
<skipInstructions>
<if>
<conditions>
<equals field="Count">
<string value="1"/>
</equals>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<mc label="Q5" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send to Players of the following team(s):</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Team:TeamId" /></display-expression><value-expression><field name="Record:Team:TeamId" /></value-expression><record-selector><form name="Team" /><conditions>
<equals field="Record:Team:CoachId">
<string field="_InviteeID"/>
</equals>
</conditions></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="CoachCommunicatorSend" startPoint="false" themePath="dirtbowl2" process="Post-CoachCommunicatorSend">
<items>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Here is what your email will look like:</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="705"><row><cell width="10095"><division indent="0" align="left"><font><b>To: </b></font><font><field name="ToField"/></font></division></cell></row><row><cell width="10095"><division indent="0" align="left"><font><b>From: </b></font><font><field name="Coach"/></font><font> (</font><font><field name="CoachsEmail"/></font><font>)</font></division></cell></row><row><cell width="10095"><division indent="0" align="left"><font><b>Date: </b></font><font>Today</font></division></cell></row><row><cell width="10095"></cell></row><row><cell width="10095"><division indent="0" align="left"><font><b>Subject: </b></font><font><field name="CoachCommunicator:Subject"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="705"><row><cell width="10095"><division indent="0" align="left"><font><field name="DearSir"/></font></division></cell></row><row><cell width="10095"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="10095"><division indent="0" align="left"><font><field name="Communicator:Body"/></font></division></cell></row><row><cell width="10095"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="10095"><division indent="0" align="left"><font><field name="Communicator:Close"/></font></division></cell></row></table></text>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select:</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send the email out</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit the email</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Abandon email and return to Coach's Dashboard</font></paragraph></choice></mc>
</items>
</form>
<form name="AddPlayerToGroupRegistration" startPoint="false" themePath="dirtbowl2" process="Post-AddGroupRegistrationPlayer">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Add player to group registration</font></paragraph></heading>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="Preseason" project="">Back to Preseason Menu</invitation></u></font></paragraph></text>
<text label="T2"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>List of players added to the group registration for </font><font><field name="Team"/></font><font>:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>3</number-of-columns><column><header>First Name</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last Name</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Email</header><contents><field name="Record:Registration:ParentEmail" /></contents></column><conditions><form name="Registration" /><conditions>
<equals field="Record:Registration:GroupRegistrationId">
<string field="GroupRegistationId"/>
</equals>
</conditions></conditions></itemization-table></font></paragraph></text>
<fib label="Q1" style="rightAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">First Name: </font><blank label="a" length="20" required="true" alternateLabel="FirstName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Last Name: </font><blank label="b" length="20" required="true" alternateLabel="LastName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Parents' Email: </font><blank label="c" length="20" required="true" alternateLabel="Parents&apos; Email"/></paragraph></fib>
</items>
</form>
<form name="EditTeam" startPoint="false" themePath="dirtbowl2" process="Post-TeamEdit">
<items>
<mc label="Q1" alternateLabel="TeamId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the team to edit:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Team:TeamId" /></display-expression><value-expression><field name="Record:Team:TeamId" /></value-expression><record-selector><form name="Team" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="AddPlayerToExistingGroupRegistration" startPoint="false" themePath="dirtbowl2" process="Post-AddPlayerToExistingGroupRegistration">
<items>
<mc label="Q1" alternateLabel="GroupRegistrationId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the group registration to add a player</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Team:TeamId" /></display-expression><value-expression><field name="Record:GroupRegistration:GroupRegistrationId" /></value-expression><record-selector><form name="Team" /><form name="GroupRegistration" /><conditions>
<equals field="Record:Team:TeamId">
<string field="Record:GroupRegistration:TeamId"/>
</equals>
</conditions></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
</forms>
<processes>
<process name="Post-Registration">
<if>
<conditions>
<isGreaterThan field="Registration:RegAgeMo">
<string value="8"/>
</isGreaterThan>
</conditions>
<trueSet>
<set field="Registration:PlayerAge" arithmeticAsText="false">
<sub>
<operand field="SeasonYr"/>
<operand field="Registration:RegAgeYr"/>
</sub>
</set>
</trueSet>
<falseSet>
<set field="Registration:PlayerAge" arithmeticAsText="false">
<sub>
<sub>
<operand field="SeasonYr"/>
<operand field="Registration:RegAgeYr"/>
</sub>
<operand value="1"/>
</sub>
</set>
</falseSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="a"/>
</conditions>
<trueSet>
<set field="Registration:Sex" arithmeticAsText="false">
<string value="Boy"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="b"/>
</conditions>
<trueSet>
<set field="Registration:Sex" arithmeticAsText="false">
<string value="Girl"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="a"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Youth L"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="b"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult S"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="c"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult M"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="d"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult L"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="e"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult XL"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="Registration:RegID" />
</conditions>
<trueSet>
<get recordList="Record List 18">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="RegNo" recordList="Record List 18">
<set field="RegNo:AdminSetup:PlayerIDGenerator" arithmeticAsText="false">
<add>
<operand field="RegNo:AdminSetup:PlayerIDGenerator"/>
<operand value="1"/>
</add>
</set>
<set field="PlayerID" arithmeticAsText="false">
<string value="player"/>
<string field="RegNo:AdminSetup:PlayerIDGenerator"/>
</set>
<set field="Registration:RegID" arithmeticAsText="false">
<string field="PlayerID"/>
</set>
</foreach>
</trueSet>
</if>
<set field="Registration:Birthday" arithmeticAsText="true">
<string field="Registration:RegAgeMo"/>
<string value="/"/>
<string field="Registration:RegAgeDay"/>
<string value="/"/>
<string field="Registration:RegAgeYr"/>
</set>
<set field="Registration:FriendsList" arithmeticAsText="false">
<string field="Registration:Friend:a"/>
<string value="   "/>
<string field="Registration:Friend:b"/>
<string value="   "/>
<string field="Registration:Friend:c"/>
</set>
<set field="PlayerFirst" arithmeticAsText="false">
<string field="Registration:FirstName"/>
</set>
<set field="PlayerLast" arithmeticAsText="false">
<string field="Registration:LastName"/>
</set>
<if>
<conditions>
<equals field="From">
<string value="AdminRegMgmt"/>
</equals>
</conditions>
<trueSet>
<show form="RegFormManagement"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="RegistrationAudit"/>
</equals>
</conditions>
<trueSet>
<set field="Registration:BadEmail?" arithmeticAsText="false">
<string value=" "/>
</set>
<show form="AuditFormLoop"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="AddPlayerToGroupRegistration"/>
</equals>
</conditions>
<trueSet>
<set field="Registration:GroupRegistrationId" arithmeticAsText="false">
<string field="GroupRegistationId"/>
</set>
<set field="Registration:TeamId" arithmeticAsText="false">
<string field="Team"/>
</set>
<set field="Registration:PaymentReceived" arithmeticAsText="false">
<string value="Yes"/>
</set>
<set field="Registration:FirstName" arithmeticAsText="false">
<string field="AddPlayerToGroupRegistration:FirstName"/>
</set>
<set field="Registration:LastName" arithmeticAsText="false">
<string field="AddPlayerToGroupRegistration:LastName"/>
</set>
<set field="Registration:ParentEmail" arithmeticAsText="false">
<string field="AddPlayerToGroupRegistration:Parents&apos; Email"/>
</set>
<send>
<to addressField="AddPlayerToGroupRegistration:Parents&apos; Email"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject><field name="League"/> Registration</subject>
<body document="InvitationToCompleteRegistration" reset="false"/>
</send>
<show form="AddPlayerToGroupRegistration"/>
</trueSet>
</if>
<show form="RegStep2"/>
</process>
<process name="Post-RegStep2">
<if>
<conditions>
<isBlank field="Registration:LinkToPlayerDashboardSent" />
</conditions>
<trueSet>
<comment>-- Means that this is not the user editing his/her record from the player dashboard,</comment>
