<conditions>
<mcEquals field="AdminPlayerRegistration:Q1" value="c"/>
</conditions>
<trueSet>
<show form="GroupRegistration"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="AdminPlayerRegistration:Q1" value="d"/>
</conditions>
<trueSet>
<show form="RegFormManagement"/>
</trueSet>
</if>
<show form="AdminPlayerRegistration"/>
