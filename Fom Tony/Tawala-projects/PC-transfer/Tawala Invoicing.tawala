<?xml version="1.0" encoding="utf-8" ?>
<project name="Tawala Invoicing" themePath="mvsc" format="1.10" designerBuild="204">
<pageHeader><image id="__HEADER__8cab9fa34d14ca0" width="581" height="74"/></pageHeader><styles fibItemStyle="leftAlignLabelsJustified" /><forms>
<form name="Start" startPoint="true" themePath="mvsc" process="Post-Start">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Tawala Services Invoicing</font></paragraph></heading>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Create Invoice</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Show client account</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Show all Invoices</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Show unpaid Invoices</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Show all paid Invoices</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<and>
<mcDoesNotEqual field="Start:Q1" value="a"/>
<mcDoesNotEqual field="Start:Q1" value="b"/>
</and>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Type part or all of the </font><font face="Arial" size="200" color="000000"><b>Client Organization Name</b></font><font face="Arial" size="200" color="000000"> to check our current files: </font><blank label="a" length="20" required="false" alternateLabel="SearchCrit"/></paragraph></fib>
<break/>
<mc label="Q3" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">The following existing clients match your criteria.  If there are no matches, press Submit to create a new client record.</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:CreateInvoice:Client"/>
<string value=" ("/>
<field name="Record:CreateInvoice:ContactName"/>
<string value=")"/>
</display-expression><value-expression><field name="Record:CreateInvoice:Client"/>
</value-expression><sort-expression><field name="Record:CreateInvoice:Client"/>
</sort-expression><record-selector><form name="CreateInvoice" /><conditions>
<and>
<contains field="Record:CreateInvoice:Client">
<string field="Start:SearchCrit"/>
</contains>
<equals field="Record:CreateInvoice:PrimaryRecord">
<string value="Yes"/>
</equals>
</and>
</conditions></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="CreateInvoice" startPoint="false" themePath="mvsc" process="Post-CreateInvoice" preProcess="Pre-CreateInvoice">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Create Invoice</font></paragraph></heading>
<fib label="Q1" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Client: </font><font face="Arial" size="200" color="000000"><i>(e.g. Mill Valley Dirt Bowl)</i></font><sp/><blank label="a" length="20" required="false" alternateLabel="Client"/></paragraph></fib>
<fib label="Q2" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Application Name: </font><font face="Arial" size="200" color="000000"><i>(e.g. SportsDashboards) </i></font><blank label="a" length="20" required="false" alternateLabel="AppName"/></paragraph></fib>
<fib label="Q3" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Billing Date: </font><blank label="a" length="20" required="false" alternateLabel="Date"/></paragraph></fib>
<fib label="Q4" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Contact Name: </font><blank label="a" length="20" required="false" alternateLabel="ContactName"/></paragraph></fib>
<fib label="Q5" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Contact Email: </font><blank label="a" length="20" required="false" alternateLabel="ContactEmail"/></paragraph></fib>
<fib label="Q6" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="3168"/></tabPositions><font face="Arial" size="200" color="000000">Contact Address: </font><tab/><sp/><sp/><sp/><sp/><sp/><sp/><blank label="a" length="48" required="false" alternateLabel="ContactAddress"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="3168"/></tabPositions><font face="Arial" size="200" color="000000">City: </font><tab/><sp/><sp/><sp/><sp/><sp/><sp/><blank label="b" length="20" required="false" alternateLabel="ContactCity"/><font face="Arial" size="200" color="000000">    State: </font><blank label="c" length="3" required="false" alternateLabel="ContactST"/><font face="Arial" size="200" color="000000">     Zip: </font><blank label="d" length="6" required="false" alternateLabel="ContactZip"/></paragraph></fib>
<fib label="Q7" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Amount Billed: $ </font><blank label="a" length="20" required="false" alternateLabel="BillableAmt"/></paragraph></fib>
<fib label="Q8" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Description: </font><blank label="a" length="20" required="false" alternateLabel="Description"/></paragraph></fib>
<break/>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Here is what your invoice will look like:</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="330"><row><cell width="2715"><division indent="0" align="right"><font><b>From:</b></font></division></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font>Tawala Systems, Inc.</font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font>120 Locust Ave.</font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font>San Rafael, CA 94901</font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"></cell></row><row><cell width="2715"><division indent="0" align="right"><font><b>To:</b></font></division></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font><field name="CreateInvoice:ContactName"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font><field name="CreateInvoice:Client"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font><field name="CreateInvoice:ContactAddress"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font><field name="CreateInvoice:ContactCity"/></font><font>, </font><font><field name="CreateInvoice:ContactST"/></font><sp/><font><field name="CreateInvoice:ContactZip"/></font><sp/></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font><field name="CreateInvoice:ContactEmail"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="2715"><division indent="0" align="right"><font><b>Date:</b></font></division></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><sp/><font><field name="CreateInvoice:Date"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"></cell></row><row><cell width="2715"><division indent="0" align="right"><font><b>Invoice Number:</b></font></division></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"><division indent="0" align="left"><font><field name="Invoice"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"><division indent="0" align="left"><sp/></division></cell><cell width="5505"></cell></row><row><cell width="2715"><division indent="0" align="right"><font><b>Description:</b></font></division></cell><cell width="300"></cell><cell width="5505"><division indent="0" align="left"><font color="000000"><field name="CreateInvoice:AppName"/></font><font> - </font><font><field name="CreateInvoice:Description"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"></cell><cell width="5505"></cell></row><row><cell width="2715"><division indent="0" align="right"><font><b>Amount Due:</b></font></division></cell><cell width="300"></cell><cell width="5505"><division indent="0" align="left"><font>$</font><font><field name="CreateInvoice:BillableAmt"/></font></division></cell></row><row><cell width="2715"></cell><cell width="300"></cell><cell width="5505"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="330"><row><cell width="8505"><division indent="0" align="left"><font>Invoice immediately due and payable.  Please pay via Paypal link below only.</font></division></cell></row><row><cell width="8505"><division indent="0" align="left"><sp/></division></cell></row><row><cell width="8505"><division indent="0" align="left"><font>Thank you very much,</font></division><division indent="0" align="left"><font>Tawala Systems</font></division></cell></row><row><cell width="8505"><division indent="0" align="left"><sp/><sp/><sp/></division></cell></row><row><cell width="8505"><division indent="0" align="left"><font>Address any questions regarding this invoice to </font><font color="000080"><u>billing@tawala.com</u></font><font>.</font></division></cell></row></table></text>
<mc label="Q9" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send out this invoice</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit the invoice</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Cancel this invoice and return to Main Menu</font></paragraph></choice></mc>
<skipInstructions>
<if>
<conditions>
<mcEquals field="CreateInvoice:Q9" value="b"/>
</conditions>
<trueSet>
<skip to="H1"/>
</trueSet>
</if>
</skipInstructions>
<field name="Status"/>
<field name="OnlinePaymentAmt"/>
<field name="InvoiceNumber"/>
<field name="PrimaryRecord"/>
</items>
</form>
<form name="CreateInvoiceNo" startPoint="false" themePath="mvsc" process="Post-CreateInvoiceNo" preProcess="Pre-CreateInvoiceNo">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<field name="InvoiceNo"/>
</items>
</form>
<form name="PaymentFailure" startPoint="false" themePath="mvsc" process="Post-PaymentFailure">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
</items>
</form>
<form name="Thanks" startPoint="false" themePath="mvsc" process="Post-Thanks">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
</items>
</form>
<form name="PayBill" startPoint="false" themePath="mvsc" process="Process 8">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<field name="Invoice"/>
<field name="Amount"/>
</items>
</form>
</forms>
<processes>
<process name="Post-Start">
<if>
<conditions>
<mcEquals field="Start:Q1" value="a"/>
</conditions>
<trueSet>
<show form="CreateInvoiceNo"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Start:Q1" value="b"/>
</conditions>
<trueSet>
<if>
<conditions>
<mcIsBlank field="Start:Q3" />
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="No client chosen."/>
</set>
<show document="Message" reset="false"/>
<show form="Start"/>
</trueSet>
</if>
<show document="ClientHistory" reset="false"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Start:Q1" value="c"/>
</conditions>
<trueSet>
<show document="ShowAll" reset="false"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Start:Q1" value="d"/>
</conditions>
<trueSet>
<show document="UnpaidBills" reset="false"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Start:Q1" value="e"/>
</conditions>
<trueSet>
<show document="PaidBills" reset="false"/>
</trueSet>
</if>
</process>
<process name="Pre-CreateInvoice">
<set field="Primary" arithmeticAsText="false">
<string value="Yes"/>
</set>
<if>
<conditions>
<mcIsNotBlank field="Start:Q3" />
</conditions>
<trueSet>
<get recordList="Record List 1">
<forms>
<form name="CreateInvoice"/>
</forms>
<conditions>
<mcEquals field="Start:Q3">
<string field="Record List 1:CreateInvoice:Client"/>
</mcEquals>
</conditions></get>
<foreach record="SuchClient" recordList="Record List 1">
<set field="CreateInvoice:Client" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:Client"/>
</set>
<set field="CreateInvoice:ContactName" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:ContactName"/>
</set>
<set field="CreateInvoice:ContactEmail" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:ContactEmail"/>
</set>
<set field="CreateInvoice:ContactAddress" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:ContactAddress"/>
</set>
<set field="CreateInvoice:ContactCity" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:ContactCity"/>
</set>
<set field="CreateInvoice:ContactST" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:ContactST"/>
</set>
<set field="CreateInvoice:ContactZip" arithmeticAsText="false">
<string field="SuchClient:CreateInvoice:ContactZip"/>
</set>
<set field="Primary" arithmeticAsText="false">
<string value="No"/>
</set>
</foreach>
</trueSet>
</if>
</process>
<process name="Post-CreateInvoiceNo">
<set field="CreateInvoiceNo:InvoiceNo" arithmeticAsText="false">
<add>
<operand field="CreateInvoiceNo:InvoiceNo"/>
<operand value="1"/>
</add>
</set>
<set field="Invoice" arithmeticAsText="false">
<string field="CreateInvoiceNo:InvoiceNo"/>
</set>
<show form="CreateInvoice"/>
</process>
<process name="Pre-CreateInvoiceNo">
<edit form="CreateInvoiceNo" submit="modify">
</edit>
</process>
<process name="Post-CreateInvoice">
<if>
<conditions>
<equals field="Primary">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<set field="CreateInvoice:PrimaryRecord" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<set field="CreateInvoice:InvoiceNumber" arithmeticAsText="false">
<string field="Invoice"/>
</set>
<if>
<conditions>
<mcEquals field="CreateInvoice:Q9" value="a"/>
</conditions>
<trueSet>
<send>
<to addressField="CreateInvoice:ContactEmail"/>
<from addressLiteral="billing@tawala.com" aliasLiteral="Tawala Systems Accounting"/>
<cc addressLiteral="invoice@billing.com"/>
<subject>Invoice for Services</subject>
<body document="Invoice Message" reset="false" showHeader="true"/>
</send>
<set field="CreateInvoice:Status" arithmeticAsText="false">
<string value="Invoice Sent"/>
</set>
<set field="Message" arithmeticAsText="false">
<string value="Invoice "/>
<string field="Invoice"/>
<string value=" to "/>
<string field="CreateInvoice:Client"/>
<string value=" in amount of $"/>
<string field="CreateInvoice:BillableAmt"/>
<string value=" has been sent."/>
</set>
<show document="Message" reset="false"/>
<show form="Start"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="CreateInvoice:Q9" value="c"/>
</conditions>
<trueSet>
<set field="CreateInvoice:Status" arithmeticAsText="false">
<string value="Cancelled"/>
</set>
<set field="Message" arithmeticAsText="false">
<string value="Invoice "/>
<string field="Invoice"/>
<string value=" to "/>
<string field="CreateInvoice:Client"/>
<string value=" in amount of $"/>
<string field="CreateInvoice:BillableAmt"/>
<string value=" has been cancelled."/>
</set>
<show document="Message" reset="false"/>
<show form="Start"/>
</trueSet>
</if>
<show form="CreateInvoice"/>
</process>
<process name="Post-PaymentFailure">
<show document="FailedPay" reset="false"/>
</process>
<process name="Post-Thanks">
<show document="Thankyou" reset="false"/>
</process>
<process name="Process 8">
<get recordList="Record List 2">
<forms>
<form name="CreateInvoice"/>
</forms>
<conditions>
<equals field="_InviteeID">
<string field="Record List 2:CreateInvoice:InvoiceNumber"/>
</equals>
</conditions></get>
<foreach record="SuchInvoice" recordList="Record List 2">
<set field="ClientName" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:Client"/>
</set>
<set field="CName" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:ContactName"/>
</set>
<set field="CAddress" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:ContactAddress"/>
</set>
<set field="CCity" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:ContactCity"/>
</set>
<set field="CST" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:ContactST"/>
</set>
<set field="CZIP" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:ContactZip"/>
</set>
<set field="CEmail" arithmeticAsText="false">
<string value="\"/>
<string field="SuchInvoice:CreateInvoice:ContactEmail"/>
</set>
<set field="CDate" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:Date"/>
</set>
<set field="Invoice" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:InvoiceNumber"/>
</set>
<set field="CApp" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:AppName"/>
</set>
<set field="CDes" arithmeticAsText="false">
<string value="\"/>
<string field="SuchInvoice:CreateInvoice:Description"/>
</set>
<set field="Amt" arithmeticAsText="false">
<string field="SuchInvoice:CreateInvoice:BillableAmt"/>
</set>
</foreach>
</process>
</processes>
<documents>
<document name="Invoice">
<xmlData>
