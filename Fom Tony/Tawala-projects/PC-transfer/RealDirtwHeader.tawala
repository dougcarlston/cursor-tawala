</conditions></get>
<foreach record="Record" recordList="CoachRecords">
<get recordList="TeamRecords">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="TeamRecords:Team:TeamId">
<string field="CoachToTeamAssignment:TeamId"/>
</equals>
</conditions></get>
<foreach record="FoundTeam" recordList="TeamRecords">
<set field="FoundTeam:Team:CoachId" arithmeticAsText="false">
<string field="Record:Coach:CoachId"/>
</set>
<set field="FoundTeam:Team:CoachFullName" arithmeticAsText="false">
<string field="Record:Coach:FullName"/>
</set>
</foreach>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-EditCoach">
<edit form="Coach" submit="modify">
<conditions>
<equals field="Record:Coach:CoachId">
<string field="EditCoach:CoachId"/>
</equals>
</conditions>
</edit>
<comment>-- If the coach is not selected this statement will get executed</comment>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-DeleteTeam">
<delete><form name="Team"/><conditions>
<equals field="Record:Team:TeamId">
<string field="DeleteTeam:TeamId"/>
</equals>
</conditions></delete>
<get recordList="Player List">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<equals field="Player List:Registration:TeamId">
<string field="DeleteTeam:TeamId"/>
</equals>
</conditions></get>
<foreach record="Team Player Record" recordList="Player List">
<set field="Team Player Record:Registration:TeamId" arithmeticAsText="false">
<string value=" "/>
</set>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-DeleteCoach">
<delete><form name="Coach"/><conditions>
<equals field="Record:Coach:CoachId">
<string field="DeleteCoach:CoachId"/>
</equals>
</conditions></delete>
<get recordList="CoachesTeams">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="CoachesTeams:Team:CoachId">
<string field="DeleteCoach:CoachId"/>
</equals>
</conditions></get>
<foreach record="SuchTeam" recordList="CoachesTeams">
<set field="SuchTeam:Team:CoachId" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="SuchTeam:Team:CoachFullName" arithmeticAsText="false">
<string value=" "/>
</set>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-UnassignCoachFromTeam">
<get recordList="TeamList">
<forms>
<form name="Team"/>
</forms>
<conditions>
<equals field="TeamList:Team:TeamId">
<string field="UnassignCoachFromTeam:TeamId"/>
</equals>
</conditions></get>
<foreach record="SuchTeam" recordList="TeamList">
<set field="SuchTeam:Team:CoachId" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="SuchTeam:Team:CoachFullName" arithmeticAsText="false">
<string value=" "/>
</set>
</foreach>
<show form="TeamAndCoachMenu"/>
</process>
<process name="Post-EditMyRegistrationRecord">
<edit form="Registration" submit="modify">
<conditions>
<equals field="Record:Registration:RegID">
<string field="_InviteeID"/>
</equals>
</conditions>
</edit>
<comment>-- In case the record wasn't found</comment>
<show document="NoPlayerDash" reset="false"/>
</process>
<process name="Pre-Coach">
<if>
<conditions>
<isNotBlank field="_InviteeID" />
</conditions>
<trueSet>
<comment>-- This is the case of coaches editing their records</comment>
<edit form="Coach" submit="modify">
<conditions>
<equals field="Record:Coach:CoachId">
<string field="_InviteeID"/>
</equals>
</conditions>
</edit>
</trueSet>
</if>
</process>
</processes>
<documents>
<document name="AdminDashboard">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="10095"><division indent="0" align="center"><font face="Times New Roman" size="360"><b><field name="AdminName"/></b></font><font face="Times New Roman" size="360"><b>'s Dirt Bowl Administrator Dashboard</b></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="210"></cell><cell width="1335"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="AdminSiteMap" project="">Site Map</invitation></u></font></division></cell><cell width="1590"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="Preseason" project="">Pre-Season</invitation></u></font></division></cell><cell width="1361"><division indent="0" align="center"><font face="Arial" size="200" color="000080"><u><invitation form="ShowContactFields" project="">Player Info</invitation></u></font></division></cell><cell width="1924"><division indent="0" align="center"><font face="Arial" size="200" color="000080"><u><invitation form="TeamAndCoachMenu" project="">Teams and Coaches</invitation></u></font></division></cell><cell width="1455"><division indent="0" align="center"><font face="Arial" size="200" color="000080"><u><invitation form="ShowTeamRosters" project="">Team Rosters</invitation></u></font></division></cell><cell width="1515"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="Communicator" project="">Communicator</invitation></u></font></division></cell><cell width="526"><division indent="0" align="center"><font face="Arial" size="200" color="0000A0"><u><invitation form="Tools" project="">Tools</invitation></u></font></division></cell><cell width="200"></cell></row><row><cell width="210"></cell><cell width="1335"></cell><cell width="1590"></cell><cell width="1361"></cell><cell width="1924"></cell><cell width="1455"></cell><cell width="1515"></cell><cell width="526"></cell><cell width="200"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2340"><division indent="0" align="left"><font><b>Basic Info:</b></font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><font face="Arial" size="200" color="0000A0"><u><invitation form="AdminSetup" project="">edit</invitation></u></font></division></cell><cell width="4695"><division indent="0" align="center"><font><b>Pre-Season Items Status:     </b></font></division></cell><cell width="750"></cell></row><row><cell width="2340"><division indent="0" align="right"><font>League:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="League"/></font></division></cell><cell width="4695"><division indent="0" align="right"><font>Uniforms ordered:</font></division></cell><cell width="750"><division indent="0" align="center"><font face="Arial" size="200" color="000000"><field name="UniFlag"/></font></division></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Season:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font face="Arial" size="200" color="000000"><field name="SeasonYr"/></font></division></cell><cell width="4695"><division indent="0" align="right"><font>Team &amp; Coach info complete:</font></division></cell><cell width="750"><division indent="0" align="center"><font face="Arial" size="200" color="000000"><field name="TeamFlag"/></font></division></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminName"/></font></division></cell><cell width="4695"><division indent="0" align="right"><font>All Launch Countdown items completed:</font></division></cell><cell width="750"><division indent="0" align="center"><font face="Arial" size="200" color="000000"><field name="LaunchDone"/></font></division></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator Email:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminEmail"/></font></division></cell><cell width="4695"></cell><cell width="750"></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator Phone:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminsPhone"/></font></division></cell><cell width="4695"></cell><cell width="750"></cell></row><row><cell width="2340"><division indent="0" align="right"><font>Administrator Address:</font></division></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font><field name="AdminAdrss"/></font></division></cell><cell width="4695"></cell><cell width="750"></cell></row><row><cell width="2340"></cell><cell width="240"></cell><cell width="2340"><division indent="0" align="left"><font face="Arial" size="200"><field name="AdminsCity"/></font><font face="Arial" size="200">, </font><font face="Arial" size="200"><field name="AdminState"/></font><sp/><font face="Arial" size="200"><field name="AdminsZIP"/></font></division></cell><cell width="4695"></cell><cell width="750"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="3735"><division indent="0" align="left"><font><b>Options:</b></font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="center"><font face="Arial" size="180" color="0000A0"><u><invitation form="AdminSetup" project="">edit</invitation></u></font></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="center"><font><b>Statistics:</b></font></division></cell><cell width="365"></cell><cell width="790"></cell></row><row><cell width="3735"><division indent="0" align="right"><font>Email Notification Options       </font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="right"><sp/></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Recruiting List:</font></division></cell><cell width="365"></cell><cell width="790"><division indent="0" align="left"><font face="Arial" size="200"><record-count version="3"><form-name>RecruitmentDB</form-name><conditions><form name="RecruitmentDB" /><conditions>
<and>
<isNotBlank field="Record:RecruitmentDB:FirstName" />
<isNotBlank field="Record:RecruitmentDB:Email" />
</and>
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3735"><division indent="0" align="right"><font><i>Upon each new registration:</i></font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="left"><font face="Arial" size="200"><field name="FlagA"/></font></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Registrations:</font></division></cell><cell width="365"></cell><cell width="790"><division indent="0" align="left"><font face="Arial" size="200"><record-count version="3"><form-name>Registration</form-name><conditions><form name="Registration" /></conditions></record-count></font></division></cell></row><row><cell width="3735"><division indent="0" align="right"><font><i>Upon each bulk mailing:</i></font></division></cell><cell width="255"></cell><cell width="510"><division indent="0" align="left"><font face="Arial" size="200"><field name="FlagB"/></font></division></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Waivers turned in:</font></division></cell><cell width="365"></cell><cell width="790"><division indent="0" align="left"><font face="Arial" size="200"><record-count version="3"><form-name>Registration</form-name><conditions><form name="Registration" /><conditions>
<isNotBlank field="Record:Registration:WaiverReceived" />
</conditions></conditions></record-count></font></division></cell></row><row><cell width="3735"></cell><cell width="255"></cell><cell width="510"></cell><cell width="510"></cell><cell width="4635"><division indent="0" align="right"><font>Payment received:</font></division></cell><cell width="365"></cell><cell width="790"><division indent="0" align="left"><font face="Arial" size="200"><record-count version="3"><form-name>Registration</form-name><conditions><form name="Registration" /><conditions>
<isNotBlank field="Record:Registration:PaymentReceived" />
