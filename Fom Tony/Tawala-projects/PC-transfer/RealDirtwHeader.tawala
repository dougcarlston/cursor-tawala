<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="B30000"><i><field name="Message"/></i></font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="center"><font face="Arial" size="220" color="CC0000"><b><field name="League"/></b></font></paragraph><paragraph indent="0" align="center"><font face="Arial" size="220" color="CC0000"><b><field name="SeasonYr"/></b></font><font face="Arial" size="220" color="CC0000"><b> Summer Basketball League: Games Only</b></font></paragraph><paragraph indent="0" align="center"><font face="Arial" size="180" color="CC0000"><b>Boys and Girls</b></font></paragraph><paragraph indent="0" align="center"></paragraph><paragraph indent="0" align="center"><font face="Arial" size="160" color="000000"><b>YOU ARE INVITED to participate in the Annual "Dirt Bowl" Basketball League and Tournament!</b></font></paragraph><paragraph indent="0" align="center"><font face="Arial" size="160" color="000000"><b>Information below.  If you are age 8-13, please join us!</b></font></paragraph></text>
<text label="T3" style="normal"><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><image id="image2" width="266" height="119"><metafileHeader fileType="1" headerSize="9" version="768" fileSize="47653" numOfObjects="0" maxRecordSize="47631" numOfParams="0" />
</image></font></paragraph></text>
<text label="T4" style="normal"><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200">Athletic Director: Kerry Huffman</font></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="006A00"><b>Sign up as a team or individually.  If you sign up individually, you will be placed on a team.</b></font></paragraph></text>
<text label="T5" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="15"><row><cell width="2010"><division indent="0" align="left"><font color="000000"><b>Registration</b></font></division></cell><cell width="2025"><division indent="0" align="right"><font face="Arial" color="000000">Send check to: </font></division></cell><cell width="2835"><division indent="0" align="left"><sp/><font face="Arial" size="220" color="CE0000"><b>Dirt Bowl</b></font></division></cell><cell width="3585"><division indent="0" align="center"><font face="Arial" size="220" color="000000"><b>||  Due Date: April 28, 2008 ||</b></font></division></cell></row><row><cell width="2010"></cell><cell width="2025"><division indent="0" align="center"><sp/></division></cell><cell width="2835"><division indent="0" align="left"><font face="Arial" size="200" color="000000"><field name="AdminAdrss"/></font></division></cell><cell width="3585"><division indent="0" align="center"><font face="Arial" size="200" color="000000">=====================</font></division></cell></row><row><cell width="2010"></cell><cell width="2025"></cell><cell width="2835"><division indent="0" align="left"><font face="Arial" size="200" color="000000"><field name="AdminsCity"/></font><font face="Arial" size="200" color="000000">, </font><font face="Arial" size="200" color="000000"><field name="AdminState"/></font><sp/><font face="Arial" size="200" color="000000"><field name="AdminsZIP"/></font></division></cell><cell width="3585"></cell></row><row><cell width="2010"></cell><cell width="2025"></cell><cell width="2835"></cell><cell width="3585"><division indent="0" align="left"><font color="CE0000">Cost per player:  </font><sp/><sp/><sp/><sp/><sp/><sp/><sp/><font color="CE0000"><b> $90</b></font></division></cell></row><row><cell width="2010"></cell><cell width="2025"></cell><cell width="2835"></cell><cell width="3585"></cell></row><row><cell width="2010"></cell><cell width="2025"></cell><cell width="2835"></cell><cell width="3585"><division indent="0" align="left"><font color="CE0000">Make checks out to:</font><font color="000000"> Dirt Bowl</font></division></cell></row></table></text>
<fib label="Q1"><paragraph indent="0" align="left"><tabPositions><tabStop position="4896"/><tabStop position="8496"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4896"/><tabStop position="8496"/></tabPositions><tab/><font face="Arial" size="200" color="000000"><i>[First]</i></font><tab/><font face="Arial" size="200" color="000000"><i>[Last]</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Name of Registrant: </b></font><tab/><blank label="a" length="18" required="false" alternateLabel="FirstName"/><tab/><blank label="b" length="18" required="false" alternateLabel="LastName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Date of Birth: </b></font><font face="Arial" size="200" color="000000"><i>(mm/dd/yyyy)</i></font><tab/><blank label="c" length="5" required="false" alternateLabel="RegAgeMo"/><font face="Arial" size="200" color="000000">/</font><blank label="d" length="5" required="false" alternateLabel="RegAgeDay"/><font face="Arial" size="200" color="000000">/</font><blank label="e" length="8" required="false" alternateLabel="RegAgeYr"/></paragraph></fib>
<mc label="Q2" alternateLabel="SexMCQ" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Sex of Registrant:</b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Boy</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Girl</font></paragraph></choice></mc>
<fib label="Q3"><paragraph indent="0" align="left"><tabPositions><tabStop position="4896"/><tabStop position="8496"/></tabPositions><tab/><font face="Arial" size="200" color="000000"><i>[First]</i></font><tab/><font face="Arial" size="200" color="000000"><i>[Last]</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Parent Name: </b></font><tab/><blank label="a" length="18" required="false" alternateLabel="ParentFirstName"/><tab/><blank label="b" length="18" required="false" alternateLabel="ParentLastName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Address: </font><tab/><blank label="c" length="39" required="false" alternateLabel="Address"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">City:</font><tab/><blank label="d" length="39" required="false" alternateLabel="City"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Zip:</font><tab/><blank label="e" length="39" required="false" alternateLabel="Zip"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b><u>Parent's</u></b></font><font face="Arial" size="200" color="000000"><b> Email:</b></font><tab/><blank label="f" length="39" required="false" alternateLabel="ParentEmail"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Parent's Email (again):</b></font><tab/><blank label="g" length="39" required="false"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="180" color="000000"><i>(All communications will be by email only)</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Parent Phone Numbers (for emergencies):</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Home:</font><tab/><blank label="h" length="18" required="false" alternateLabel="ParentHomePhone"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Work::</font><tab/><blank label="i" length="18" required="false" alternateLabel="ParentWorkPhone"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Mobile:</font><tab/><blank label="j" length="18" required="false" alternateLabel="ParentMobilePhone"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph></fib>
<fib label="Q4" alternateLabel="Friend" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Name of friend(s) you would like on your team: </b></font><tab/><blank label="a" length="39" required="false"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000">                                                                     </font><blank label="b" length="39" required="false"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000">                                                                     </font><blank label="c" length="39" required="false"/></paragraph></fib>
<mc label="Q5" alternateLabel="ShirtSize" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>What is your shirt size?</b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Small</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Medium</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Large</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Extra large</font></paragraph></choice></mc>
<text label="T6" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000"><b>Medical Information</b></font></paragraph></text>
<fib label="Q6" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Plan Name: </b></font><tab/><blank label="a" length="39" required="false" alternateLabel="MedPlanName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Plan Number: </b></font><tab/><blank label="b" length="39" required="false" alternateLabel="MedPlanNumber"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Child's Physician:</b></font><tab/><blank label="c" length="39" required="false" alternateLabel="DocName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Physician Phone:</b></font><tab/><blank label="d" length="39" required="false" alternateLabel="DocPhone"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Physician Address:</b></font><tab/><blank label="e" length="39" required="false" alternateLabel="DocAddress"/></paragraph></fib>
<text label="T7" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><i>Please review the above information carefully, then press Submit to send in your application. </i></font></paragraph></text>
<skipInstructions>
<if>
<conditions>
<or>
<doesNotEqual field="Registration:ParentEmail">
<string field="Registration:Q3:g"/>
</doesNotEqual>
<isBlank field="Registration:ParentEmail" />
</or>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Email address is blank or two copies of Email fail to match."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<or>
<isBlank field="Registration:FirstName" />
<isBlank field="Registration:LastName" />
</or>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please enter Registrant&apos;s First and Last names in the spaces provided."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<and>
<mcDoesNotEqual field="Registration:SexMCQ" value="a"/>
<mcDoesNotEqual field="Registration:SexMCQ" value="b"/>
</and>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please mark Registrant&apos;s sex."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<isLessThan field="Registration:RegAgeYr">
<string value="100"/>
</isLessThan>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please enter year of birth as a four digit number (e.g. &quot;1995&quot;)."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
</skipInstructions>
<field name="TeamId"/>
<field name="PaymentReceived"/>
<field name="WaiverReceived"/>
<field name="Sex"/>
<field name="RegID"/>
<field name="UniformSize"/>
<field name="Birthday"/>
<field name="PlayerAge"/>
<field name="FriendsList"/>
<field name="BadEmail?"/>
<field name="PhoneNotification"/>
</items>
</form>
<form name="RegStep2" startPoint="false" themePath="dirtbowl2" process="Post-RegStep2">
<items>
<skipInstructions>
<if>
<conditions>
<equals field="Registration:PaymentReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<if>
<conditions>
<equals field="Registration:WaiverReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<skip to="EverythingIsReceived"/>
</trueSet>
<falseSet>
<skip to="OnlyWaiverIsNeeded"/>
</falseSet>
</if>
</trueSet>
<falseSet>
<if>
<conditions>
<equals field="Registration:WaiverReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<skip to="OnlyPaymentIsNeeded"/>
</trueSet>
</if>
</falseSet>
</if>
</skipInstructions>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Part 1 of your registration has been received.</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You still need to submit:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>A) A signed medical waiver; and</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>B) Your payment of $90</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press </font><font><b>Submit</b></font><font> to create a personalized copy of the waiver, suitable for printing.  </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Please print the next page, sign it and mail it to the address shown on the Waiver.  Then continue to Part 3 by selecting the link at the bottom of the page for payment options.</font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="240" color="000000"><b>*NOTE: No child will be allowed to participate without a signed waiver and payment.</b></font></paragraph></text>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T3" alternateLabel="OnlyWaiverIsNeeded" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You still need to submit:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>A) A signed medical waiver.</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press </font><font><b>Submit</b></font><font> to create a personalized copy of the waiver, suitable for printing.  </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Please print the next page, sign it and mail it to the address shown on the Waiver.</font></paragraph></text>
<text label="T4" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="240" color="000000"><b>*NOTE: No child will be allowed to participate without a signed waiver and payment.</b></font></paragraph></text>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T5" alternateLabel="OnlyPaymentIsNeeded" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You still need to submit:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">A</font><font>) Your payment of $90</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press </font><font><b>Submit</b></font><font> to get to the page with payment options.</font></paragraph></text>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T6" alternateLabel="EverythingIsReceived"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>We have received both your payment and waiver. Thank you!</font></paragraph></text>
</items>
</form>
