</set>
<show document="Message" reset="false"/>
<set field="TeamCountNotify" arithmeticAsText="false">
<string value="Yes"/>
</set>
</falseSet>
</if>
</falseSet>
</if>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="SeasonLaunchMgmt:Q1" value="b"/>
</conditions>
<trueSet>
<set field="Count" arithmeticAsText="false">
<string value="0"/>
</set>
