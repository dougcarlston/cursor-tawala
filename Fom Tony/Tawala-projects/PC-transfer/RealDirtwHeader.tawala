<form name="Team" startPoint="false" themePath="dirtbowl2" process="Post-Team">
<items>
<fib label="Q1" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Team Name:  </font><blank label="a" length="20" required="false" alternateLabel="TeamId"/></paragraph></fib>
<field name="CoachId"/>
<field name="CoachFullName"/>
</items>
</form>
<form name="Coach" startPoint="false" themePath="dirtbowl2" process="Post-Coach" preProcess="Pre-Coach">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Coach Contact Information</font></paragraph></heading>
<fib label="Q1" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">First Name:  </font><blank label="a" length="20" required="false" alternateLabel="FirstName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Last Name:  </font><blank label="b" length="20" required="false" alternateLabel="LastName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email: </font><blank label="c" length="22" required="false" alternateLabel="Email"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Phone: </font><blank label="d" length="20" required="false" alternateLabel="Phone1"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Alternate Phone: </font><blank label="e" length="19" required="false" alternateLabel="Phone2"/></paragraph></fib>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000"><b>Address:</b></font></paragraph></text>
<fib label="Q2" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Street:  </font><blank label="a" length="20" required="false" alternateLabel="Street"/></paragraph></fib>
<fib label="Q3" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">City: </font><blank label="a" length="20" required="false" alternateLabel="City"/></paragraph></fib>
<fib label="Q4" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">State: </font><blank label="a" length="6" required="false" alternateLabel="State"/></paragraph></fib>
<fib label="Q5" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Zip: </font><blank label="a" length="6" required="false" alternateLabel="ZIP"/></paragraph></fib>
<field name="CoachId"/>
<field name="FullName"/>
</items>
</form>
<form name="CoachToTeamAssignment" startPoint="false" themePath="dirtbowl2" process="Post-CoachToTeamAssignment">
<items>
<mc label="Q1" alternateLabel="TeamId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the team:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Team:TeamId" /></display-expression><value-expression><field name="Record:Team:TeamId" /></value-expression><record-selector><form name="Team" /><conditions>
<isBlank field="Record:Team:CoachId" />
</conditions></record-selector></dynamic-mcq></data-provider></mc>
<mc label="Q2" alternateLabel="CoachId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Coach:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Coach:FullName" /></display-expression><value-expression><field name="Record:Coach:CoachId" /></value-expression><record-selector><form name="Coach" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="EditCoach" startPoint="false" themePath="dirtbowl2" process="Post-EditCoach">
<items>
<mc label="Q1" alternateLabel="CoachId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the coach to edit:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Coach:FullName" /></display-expression><value-expression><field name="Record:Coach:CoachId" /></value-expression><record-selector><form name="Coach" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="DeleteTeam" startPoint="false" themePath="dirtbowl2" process="Post-DeleteTeam">
<items>
<mc label="Q1" alternateLabel="TeamId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the team to delete:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Team:TeamId" /></display-expression><value-expression><field name="Record:Team:TeamId" /></value-expression><record-selector><form name="Team" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="DeleteCoach" startPoint="false" themePath="dirtbowl2" process="Post-DeleteCoach">
<items>
<mc label="Q1" alternateLabel="CoachId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the coach to delete:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Coach:FullName" /></display-expression><value-expression><field name="Record:Coach:CoachId" /></value-expression><record-selector><form name="Coach" /></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="UnassignCoachFromTeam" startPoint="false" themePath="dirtbowl2" process="Post-UnassignCoachFromTeam">
<items>
<mc label="Q1" alternateLabel="TeamId" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select the team to un-assign the coach from:</font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Team:TeamId" /></display-expression><value-expression><field name="Record:Team:TeamId" /></value-expression><record-selector><form name="Team" /><conditions>
<isNotBlank field="Record:Team:CoachId" />
</conditions></record-selector></dynamic-mcq></data-provider></mc>
</items>
</form>
<form name="EditMyRegistrationRecord" startPoint="false" themePath="dirtbowl2" process="Post-EditMyRegistrationRecord" preProcess="RetrieveAdminSetupVariables">
<items>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
</items>
</form>
</forms>
<processes>
<process name="Post-Registration">
<set field="Registration:PlayerAge" arithmeticAsText="false">
<sub>
<operand field="SeasonYr"/>
<operand field="Registration:RegAgeYr"/>
</sub>
</set>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="a"/>
</conditions>
<trueSet>
<set field="Registration:Sex" arithmeticAsText="false">
<string value="Boy"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="b"/>
</conditions>
<trueSet>
<set field="Registration:Sex" arithmeticAsText="false">
<string value="Girl"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="a"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="S"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="b"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="M"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="c"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="L"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="d"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="XL"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="Registration:RegID" />
</conditions>
<trueSet>
<get recordList="Record List 18">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="RegNo" recordList="Record List 18">
<set field="RegNo:AdminSetup:PlayerIDGenerator" arithmeticAsText="false">
<add>
<operand field="RegNo:AdminSetup:PlayerIDGenerator"/>
<operand value="1"/>
</add>
</set>
<set field="PlayerID" arithmeticAsText="false">
<string value="player"/>
<string field="RegNo:AdminSetup:PlayerIDGenerator"/>
</set>
<set field="Registration:RegID" arithmeticAsText="false">
<string field="PlayerID"/>
</set>
</foreach>
</trueSet>
</if>
<set field="Registration:Birthday" arithmeticAsText="true">
<string field="Registration:RegAgeMo"/>
<string value="/"/>
<string field="Registration:RegAgeDay"/>
<string value="/"/>
<string field="Registration:RegAgeYr"/>
</set>
<set field="Registration:FriendsList" arithmeticAsText="false">
<string field="Registration:Friend:a"/>
<string value="   "/>
<string field="Registration:Friend:b"/>
<string value="   "/>
<string field="Registration:Friend:c"/>
</set>
<set field="PlayerFirst" arithmeticAsText="false">
<string field="Registration:FirstName"/>
</set>
<set field="PlayerLast" arithmeticAsText="false">
<string field="Registration:LastName"/>
</set>
<if>
<conditions>
<equals field="From">
<string value="AdminRegMgmt"/>
</equals>
</conditions>
<trueSet>
<show form="RegFormManagement"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="RegistrationAudit"/>
</equals>
</conditions>
<trueSet>
<set field="Registration:BadEmail?" arithmeticAsText="false">
<string value=" "/>
</set>
<show form="AuditFormLoop"/>
</trueSet>
</if>
<show form="RegStep2"/>
</process>
<process name="Post-Submit">
<if>
<conditions>
<equals field="From">
<string value="PlayerDash"/>
</equals>
</conditions>
<trueSet>
<set field="From" arithmeticAsText="false">
<string value=" "/>
</set>
<show form="PlayerDash"/>
</trueSet>
</if>
<show form="Null Form"/>
</process>
<process name="Post-RegStep2">
<if>
<conditions>
<isBlank field="_InviteeID" />
</conditions>
<trueSet>
<comment>-- Means that this is not the user editing his/her record from the player dashboard,</comment>
<comment>-- but either the first time registrant or the admin creating the record,</comment>
<send>
<to addressField="Registration:ParentEmail"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject>Your Dirt Bowl Registration</subject>
<body document="SaveThisLink" reset="false"/>
</send>
<get recordList="Record List 19">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="Selection" recordList="Record List 19">
<if>
<conditions>
<mcContains field="Selection:AdminSetup:Q5" value="a"/>
</conditions>
<trueSet>
<comment>-- This is needed to prevent a weird bug that causes designer to crash</comment>
<set field="PlayerFullName" arithmeticAsText="false">
<string field="Registration:FirstName"/>
<string value=" "/>
<string field="Registration:LastName"/>
</set>
<send>
<to addressField="AdminEmail"/>
<from aliasLiteral="Dirt Bowl Automated Email Server"/>
<subject>Registrations received for <field name="PlayerFullName"/></subject>
<body document="AdminRegNotifiction" reset="false"/>
</send>
</trueSet>
</if>
</foreach>
</trueSet>
</if>
<if>
<conditions>
<equals field="Bounceback">
<string value="RegisterPlayer"/>
</equals>
</conditions>
<trueSet>
<show form="SecondSubmit"/>
</trueSet>
</if>
<if>
<conditions>
<doesNotEqual field="Registration:WaiverReceived">
<string value="Yes"/>
</doesNotEqual>
</conditions>
<trueSet>
<show document="Waiver" reset="false"/>
<if>
<conditions>
<doesNotEqual field="Registration:PaymentReceived">
<string value="Yes"/>
</doesNotEqual>
</conditions>
<trueSet>
<show document="NavigationToPayment" reset="false"/>
</trueSet>
</if>
</trueSet>
<falseSet>
<if>
<conditions>
<equals field="Registration:PaymentReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<show form="PlayerDash"/>
</trueSet>
<falseSet>
<show form="OnlinePayment"/>
</falseSet>
</if>
</falseSet>
</if>
</process>
<process name="Post-AdminDash">
<set field="Skip" arithmeticAsText="false">
<string value="No"/>
</set>
<get recordList="Record List 1">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="Record" recordList="Record List 1">
<set field="Skip" arithmeticAsText="false">
<string value="Yes"/>
</set>
<set field="AdminName" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminsName"/>
</set>
<set field="AdminEmail" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminsEmail"/>
</set>
<set field="AdminsPhone" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminPhone"/>
</set>
<set field="AdminAdrss" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminAddress"/>
</set>
<set field="AdminsCity" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminCity"/>
</set>
<set field="AdminState" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminST"/>
</set>
<set field="AdminsZIP" arithmeticAsText="false">
<string field="Record:AdminSetup:AdminZip"/>
</set>
<set field="League" arithmeticAsText="false">
<string field="Record:AdminSetup:LeagueName"/>
