<document name="PlayerAssgnmtLetter">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="PlayerFirst"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="PlayerAssignmentEmail:Body"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Your team this season is </font><font><field name="Team"/></font><font>, and your coach is </font><font><field name="Coach"/></font><font>.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You can find important contact information for your coach, your teammates</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>and the League on your </font><font color="000080"><u><invitation form="PlayerDash" project="" private="true"><authenticationTokenValue><string field="PlayerID"/>
</authenticationTokenValue>Dirt Bowl Player Dashboard</invitation></u></font><font>.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="PlayerAssignmentEmail:Close"/></font></paragraph>
</xmlData>
</document>
<document name="CoachSetupLetter">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="PlayerFirst"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="CoachRosterNotice:Body"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You will be the coach for </font><font><field name="Team"/></font><font>  in this season's Dirt Bowl League.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You can find important contact information for your team and the League on </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>your personal </font><font color="000080"><u><invitation form="CoachDashboard" project="" private="true"><authenticationTokenValue><string field="CoachID"/>
</authenticationTokenValue>Dirt Bowl Coach Dashboard</invitation></u></font><font>.  The Dashboard will also permit </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>you to communicate easily with your team members and keep track of various </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>responsibilities during the season.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Once again, in order to gain access to your coaching tools for this season's </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dirt Bowl, click on this link:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="CoachDashboard" project="" private="true"><authenticationTokenValue><string field="CoachID"/>
</authenticationTokenValue>Dirt Bowl Coach Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="CoachRosterNotice:Close"/></font></paragraph>
</xmlData>
</document>
<document name="NoCoachDash">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i>Your Coach Dashboard has not been found.</i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i>Please notify the Dirt Bowl administrator, </i></b></font><font color="AE0000"><b><i><field name="AdminName"/></i></b></font><font color="AE0000"><b><i>, </i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i>at </i></b></font><font color="AE0000"><b><i><field name="AdminEmail"/></i></b></font><font color="AE0000"><b><i>, so that this problem can be tracked</i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i>down and fixed.</i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i>Our apologies.</i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="AE0000"><b><i>The Tawala Development Team</i></b></font></paragraph>
</xmlData>
</document>
<document name="CoachDashReminder">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="DearSir"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Your Coach's Dashboard for coaching the Dirt Bowl team, </font><font><field name="Team"/></font><font>, </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>is </font><font color="000080"><u><invitation form="CoachDashboard" project="" private="true"><authenticationTokenValue><string field="CoachID"/>
</authenticationTokenValue>here</invitation></u></font><font>.  Clicking on this link will take you to your </font><font><field name="Team"/></font><font> Dirt Bowl </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Coach Dashboard, which contains tools that allow you to keep track of </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>information about your team and to communicate with your players.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">To save this link, click on it.  A Dirt Bowl Web page will come up. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">Saving this link depends upon which brower you use:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Internet Explorer, click on "Favorites" in the Menu Bar at top and </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">then "Add to Favorites."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Firefox, click on "Bookmarks" in the Menu Bar at top and then </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">"Bookmark this Page."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Safari, click on "Bookmarks" and then "Add Bookmarks."</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Be sure to save this link in a safe place.  You can use it to review or </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>change your registration and to see personal information, such as your </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>team assignment and team roster, season schedule and the like.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>For general information about Dirt Bowl, you can always go to: </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>http://www.dirtbowl.com.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Once again, your Dashboard link is:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="CoachDashboard" project="" private="true"><authenticationTokenValue><string field="CoachID"/>
</authenticationTokenValue>Dirt Bowl Coach Dashboard</invitation></u></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Yours,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="AdminName"/></font></paragraph>
</xmlData>
</document>
<document name="CoachRosterList">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240"><b><field name="Team"/></b></font><font size="240"><b> Roster List</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>8</number-of-columns><column><header>First</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Home Phone</header><contents><field name="Record:Registration:ParentHomePhone" /></contents></column><column><header>Parent Work</header><contents><field name="Record:Registration:ParentWorkPhone" /></contents></column><column><header>Mobile</header><contents><field name="Record:Registration:ParentMobilePhone" /></contents></column><column><header>Email</header><contents><field name="Record:Registration:ParentEmail" /></contents></column><column><header>Birthday</header><contents><field name="Record:Registration:Birthday" /></contents></column><column><header>Size</header><contents><field name="Record:Registration:UniformSize" /></contents></column><conditions><form name="Registration" /><conditions>
<equals field="Record:Registration:TeamId">
<string field="CurrentTeamId"/>
</equals>
</conditions></conditions></itemization-table></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph>
</xmlData>
</document>
<document name="OnlinePaymentInstructions">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Please pay $</font><font><field name="SignupFeeForIndividual"/></font><font>. You will see the following charge on your credit card bill:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>"DIRT BOWL REGISTRATION" .</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><paypal-single-item-button version="1"><button-type>pay-logo</button-type><item><field name="OnlinePayment:PaymentDescription" /></item><amount><field name="OnlinePayment:AmountRequested" /></amount><successful-payment-return-form-name>PlayerDash</successful-payment-return-form-name><cancelled-payment-return-form-name>IndividualPaymentCanceled</cancelled-payment-return-form-name><status-field>Record:OnlinePayment:Status</status-field><amount-field>Record:OnlinePayment:AmountPaid</amount-field><style-option>paypal</style-option></paypal-single-item-button></font></paragraph>
</xmlData>
</document>
<document name="TeamAssignment">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Use "Drag and Drop to sort Players into teams:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><categorizer version="1"><category-names>Record:Team:TeamId</category-names><category-ids>Record:Team:TeamId</category-ids><category-storage-field>Record:Registration:TeamId</category-storage-field><navigate-to>Team Rosters</navigate-to><number-of-columns>5</number-of-columns><column><header>First</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Age</header><contents><field name="Record:Registration:PlayerAge" /></contents></column><column><header>Sex</header><contents><field name="Record:Registration:Sex" /></contents></column><column><header>Friends</header><contents><field name="Record:Registration:FriendsList" /></contents></column><conditions><form name="Team" /><form name="Registration" /><form name="Team Rosters" /><conditions>
<and>
<equals field="Record:Registration:PaymentReceived">
<string value="Yes"/>
</equals>
<equals field="Record:Registration:WaiverReceived">
<string value="Yes"/>
</equals>
</and>
</conditions></conditions></categorizer></font></paragraph>
</xmlData>
</document>
<document name="NavigationToPayment">
<xmlData>
<paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000080"><u><invitation form="OnlinePayment" project="" private="true"><authenticationTokenValue><string field="Registration:RegID"/>
</authenticationTokenValue>Continue to payment instructions</invitation></u></font></paragraph>
</xmlData>
</document>
<document name="PaymentByCheckInstructions">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>To pay by check please mail a check for $</font><font><field name="SignupFeeForIndividual"/></font><font> to:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font>Dirt Bowl</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font><field name="AdminAdrss"/></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font><field name="AdminsCity"/></font><font>, </font><font><field name="AdminState"/></font><sp/><font><field name="AdminsZIP"/></font></paragraph>
</xmlData>
</document>
<document name="OnlinePaymentCancelledConfirmation">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>It looks like you were unable to pay online or decided to pay by check. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Some additional verbiage and the link to the player's dashboard can go here....</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph>
</xmlData>
</document>
<document name="ReadyToSignUpTeamLetterToCoach">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="CoachFirstName"/></font><font>:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Everything is ready for you to sign up players to </font><font><field name="GroupRegistration:TeamId"/></font><font> team for the upcoming Dirt Bowl Season. Just follow the "Group Registration" link on </font><font color="000080"><u><invitation form="CoachDashboard" project="" private="true"><authenticationTokenValue><string field="GroupRegistration:CoachId"/>
</authenticationTokenValue>your dashboard</invitation></u></font><sp/><font>and use the instruction there to finish the setup.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Best regards,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>The Dirt Bowl Team</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph>
</xmlData>
</document>
<document name="TeamAndCoachMenu">
<xmlData>
<paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font size="360" color="000000">Team and Coach Menu</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="1536"></cell><cell width="1536"><division indent="0" align="left"><font color="000080"><u><invitation form="Team" project="">Add a team</invitation></u></font></division></cell><cell width="1536"></cell><cell width="1536"><division indent="0" align="left"><font color="000080"><u><invitation form="Coach" project="">Add a coach</invitation></u></font></division></cell><cell width="1536"></cell><cell width="2745"><division indent="0" align="left"><font color="000080"><u><invitation form="CoachToTeamAssignment" project="">Assign coach to team</invitation></u></font></division></cell><cell width="327"></cell></row><row><cell width="1536"></cell><cell width="1536"><division indent="0" align="left"><font color="000080"><u><invitation form="DeleteTeam" project="">Delete a team</invitation></u></font></division></cell><cell width="1536"></cell><cell width="1536"><division indent="0" align="left"><font color="000080"><u><invitation form="EditCoach" project="">Edit a coach</invitation></u></font></division></cell><cell width="1536"></cell><cell width="2745"><division indent="0" align="left"><font color="000080"><u><invitation form="UnassignCoachFromTeam" project="">Un-assign coach from team</invitation></u></font></division></cell><cell width="327"></cell></row><row><cell width="1536"></cell><cell width="1536"></cell><cell width="1536"></cell><cell width="1536"><division indent="0" align="left"><font color="000080"><u><invitation form="DeleteCoach" project="">Delete a coach</invitation></u></font></division></cell><cell width="1536"></cell><cell width="2745"></cell><cell width="327"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font size="240" color="000000"><b>Teams:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font><itemization-table version="1"><number-of-columns>2</number-of-columns><column><header>Name</header><contents><field name="Record:Team:TeamId" /></contents></column><column><header>Coach Name</header><contents><field name="Record:Team:CoachFullName" /></contents></column><conditions><form name="Team" /></conditions></itemization-table></font></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font size="240" color="000000"><b>Coaches:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><tab/><font color="000000"><itemization-table version="1"><number-of-columns>3</number-of-columns><column><header>First Name</header><contents><field name="Record:Coach:FirstName" /></contents></column><column><header>Last Name</header><contents><field name="Record:Coach:LastName" /></contents></column><column><header>Email</header><contents><field name="Record:Coach:Email" /></contents></column><conditions><form name="Coach" /></conditions></itemization-table></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph>
</xmlData>
</document>
<document name="PlayerTeamRoster">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="right"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b><field name="Team"/></b></font><font><b> Player Roster:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>4</number-of-columns><column><header>First</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Home Phone</header><contents><field name="Record:Registration:ParentHomePhone" /></contents></column><column><header>Email</header><contents><field name="Record:Registration:ParentEmail" /></contents></column><conditions><form name="Registration" /><conditions>
<equals field="Record:Registration:TeamId">
<string field="PlayerTeamId"/>
</equals>
</conditions></conditions></itemization-table></font></paragraph>
</xmlData>
</document>
<document name="BackToCoachDashLink">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="CoachDashboard" project="">Back to Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph>
</xmlData>
</document>
</documents>
