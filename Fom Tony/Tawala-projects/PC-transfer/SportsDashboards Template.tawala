</set>
<if>
<conditions>
<mcEquals field="AddRecruitFromReg:Q1" value="a"/>
</conditions>
<trueSet>
<comment>Add all non-dupe registered players</comment>
<set field="From" arithmeticAsText="false">
<string value="a"/>
</set>
<show form="RecruitmentDB"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="AddRecruitFromReg:Q1" value="b"/>
</conditions>
<trueSet>
<comment>Add all non-dupe registered players below a certain age</comment>
<set field="From" arithmeticAsText="false">
<string value="b"/>
</set>
<show form="RecruitmentDB"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="AddRecruitFromReg:Q1" value="c"/>
</conditions>
<trueSet>
<comment>Add all registered players, regardless</comment>
<set field="From" arithmeticAsText="false">
<string value="c"/>
</set>
<show form="RecruitmentDB"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="AddRecruitFromReg:Q1" value="d"/>
</conditions>
<trueSet>
<set field="From" arithmeticAsText="false">
<string value="d"/>
</set>
<show form="CompareNMark"/>
</trueSet>
</if>
</process>
<process name="Pre-CompareNMark">
<set field="Match" arithmeticAsText="false">
<string value="No"/>
</set>
<get recordList="Record List 122">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<and>
<doesNotEqual field="Record List 122:Registration:Recruiting">
<string value="No"/>
</doesNotEqual>
<doesNotEqual field="Record List 122:Registration:Recruiting">
<string value="Added"/>
</doesNotEqual>
</and>
</conditions></get>
<foreach record="SuchMatch" recordList="Record List 122">
<if>
<conditions>
<equals field="Match">
<string value="No"/>
</equals>
</conditions>
<trueSet>
<get recordList="Record List 123">
<forms>
<form name="RecruitmentDB"/>
</forms>
<conditions>
<equals field="Record List 123:RecruitmentDB:RecruitmentId">
<string field="SuchMatch:Registration:Recruiting"/>
</equals>
</conditions></get>
<foreach record="Success" recordList="Record List 123">
<set field="Match" arithmeticAsText="false">
<string value="Yes"/>
</set>
<set field="RecruitPFirst" arithmeticAsText="false">
<string field="Success:RecruitmentDB:FirstName"/>
</set>
<set field="RecruitPLast" arithmeticAsText="false">
<string field="Success:RecruitmentDB:LastName"/>
</set>
<set field="RecruitParentFirst" arithmeticAsText="false">
<string field="Success:RecruitmentDB:ParentFirst"/>
</set>
<set field="RecruitEmail" arithmeticAsText="false">
<string field="Success:RecruitmentDB:Email"/>
</set>
<set field="RecruitEmail2" arithmeticAsText="false">
<string field="Success:RecruitmentDB:Email2"/>
</set>
<set field="RecruitPhone" arithmeticAsText="false">
<string field="Success:RecruitmentDB:Phone"/>
</set>
<set field="RecruitID" arithmeticAsText="false">
<string field="Success:RecruitmentDB:RecruitmentId"/>
</set>
</foreach>
</trueSet>
</if>
<if>
<conditions>
<equals field="Match">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<set field="Match" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="PlayerFirst" arithmeticAsText="false">
<string field="SuchMatch:Registration:FirstName"/>
</set>
<set field="PlayerLast" arithmeticAsText="false">
<string field="SuchMatch:Registration:LastName"/>
</set>
<set field="ParentFirstName" arithmeticAsText="false">
<string field="SuchMatch:Registration:ParentFirstName"/>
</set>
<set field="ParentEmail" arithmeticAsText="false">
<string field="SuchMatch:Registration:ParentEmail"/>
</set>
<set field="ParentEmail2" arithmeticAsText="false">
<string field="SuchMatch:Registration:ParentEmail2"/>
</set>
<set field="Phone1" arithmeticAsText="false">
<string field="SuchMatch:Registration:Phone1"/>
</set>
<set field="RecruitMatch" arithmeticAsText="false">
<string field="SuchMatch:Registration:Recruiting"/>
</set>
</trueSet>
</if>
</foreach>
</process>
</processes>
