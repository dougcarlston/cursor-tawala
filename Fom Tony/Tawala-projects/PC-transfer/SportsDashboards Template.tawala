</link>
</u></font></division></cell></row><row><cell width="825"></cell><cell width="2255"></cell><cell width="1540"></cell><cell width="2460"></cell><cell width="1605"></cell><cell width="1155"></cell><cell width="940"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2430"><division indent="0" align="right"><font><b>Your Team:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="Team"/></font></division></cell><cell width="3165"><division indent="0" align="right"><font>Payment Status:</font></division></cell><cell width="210"></cell><cell width="2025"><division indent="0" align="left"><font><field name="PaymentStatusMessage"/></font></division></cell></row><row><cell width="2430"><division indent="0" align="right"><font><b>Division:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="PlayerDivision"/></font></division></cell><cell width="3165"><division indent="0" align="right"><font color="000000">Waiver Status:</font></division></cell><cell width="210"></cell><cell width="2025"><division indent="0" align="left"><font color="000000"><field name="WaiverStatusMessage"/></font></division></cell></row><row><cell width="2430"><division indent="0" align="right"><font><b>League:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="League"/></font></division></cell><cell width="3165"></cell><cell width="210"></cell><cell width="2025"></cell></row><row><cell width="2430"><division indent="0" align="right"><font><b>Season:</b></font></division></cell><cell width="272"></cell><cell width="2698"><division indent="0" align="left"><font><field name="SeasonYr"/></font></division></cell><cell width="3165"></cell><cell width="210"></cell><cell width="2025"></cell></row><row><cell width="2430"></cell><cell width="272"></cell><cell width="2698"></cell><cell width="3165"></cell><cell width="210"></cell><cell width="2025"></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2415"><division indent="0" align="right"><font><b>Coach:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="Coach"/></font></division></cell><cell width="3345"><division indent="0" align="right"><font><b>Dirt Bowl Athletic Director:</b></font></division></cell><cell width="210"></cell><cell width="2010"><division indent="0" align="left"><font><field name="AdminName"/></font></division></cell></row><row><cell width="2415"><division indent="0" align="right"><font><b>Coach's Phone:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="CoachsPhone"/></font></division></cell><cell width="3345"><division indent="0" align="right"><font><b>Dirt Bowl Phone:</b></font></division></cell><cell width="210"></cell><cell width="2010"><division indent="0" align="left"><font><field name="AdminsPhone"/></font></division></cell></row><row><cell width="2415"><division indent="0" align="right"><font><b>Alternate Phone:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="CoachsPhone1"/></font></division></cell><cell width="3345"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="210"></cell><cell width="2010"><division indent="0" align="left"><font><field name="AdminEmail"/></font></division></cell></row><row><cell width="2415"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="272"></cell><cell width="2548"><division indent="0" align="left"><font><field name="CoachsEmail"/></font></division></cell><cell width="3345"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="210"></cell><cell width="2010"><division indent="0" align="left"><font><field name="AdminAdrss"/></font></division></cell></row><row><cell width="2415"></cell><cell width="272"></cell><cell width="2548"></cell><cell width="3345"></cell><cell width="210"></cell><cell width="2010"><division indent="0" align="left"><font><field name="AdminsCity"/></font><font>, </font><font><field name="AdminState"/></font><sp/><sp/><font><field name="AdminsZIP"/></font><sp/></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Flash Message from </b></font><font><b><field name="Coach"/></b></font><font><b>:</b></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font face="Arial" size="220" color="004000"><field name="FlashMessage"/></font></paragraph>
</xmlData>
</document>
<document name="PostRegistrationLetterWithPaymentInstructions">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="Registration:FirstName"/></font><font> and Parents of </font><font><field name="Registration:FirstName"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You have successfully registered for this season's </font><font><field name="League"/></font><font>.  </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Don't forget to send in your signed Medical Waiver. No player can practice or play </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>until their Medical Waiver has been received. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you haven't already paid online, please send a check for $</font><font><field name="SignupFeeForIndividual"/></font><font> payable to "</font><font><field name="League"/></font><font>".</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Both the payment and the waiver can be mailed to the following address:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><field name="League"/></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><field name="AdminAdrss"/></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font><field name="AdminsCity"/></font><sp/><font><field name="AdminState"/></font><font>, </font><font><field name="AdminsZIP"/></font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>If you need any information about the season, you can always look at our Web site.  For dealing </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>with personal information like reviewing or changing your registration info, checking your team </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>roster or schedule and the like, use the link below.  This is your personal link.  Do not share it with </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>others. (You can also get to our Web site from it.)</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Here it is:  </font><font color="000080"><u><invitation form="PlayerDash" project="" private="true"><authenticationTokenValue><string field="Registration:RegID"/>
</authenticationTokenValue>Player's Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>To save this link, click on it.  A </font><font><field name="League"/></font><font> Web page will come up, your personal page. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Saving this link depends upon which browser you use:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>If you use Internet Explorer, click on "Favorites" in the Menu Bar at top and </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>then "Add to Favorites."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>If you use Firefox, click on "Bookmarks" in the Menu Bar at top and then </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>"Bookmark this Page."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font>If you use Safari, click on "Bookmarks" and then "Add Bookmarks."</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You'll get your team roster and schedule by email once they've been completed, but </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>they will also always be available to you on your Dashboard.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>I'm looking forward to seeing you at the </font><font><field name="League"/></font><font> games this season!</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Yours,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="AdminName"/></font></paragraph>
</xmlData>
</document>
<document name="AdminRegNotification">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>A registration form has been received for </font><font><field name="Registration:FirstName"/></font><sp/><font><field name="Registration:LastName"/></font><font>. Here is the registration info:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="735"><row><cell width="2455"><division indent="0" align="right"><font><b>Player's Name:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:FirstName"/></font><sp/><font><field name="Registration:LastName"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Date of Birth:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:RegAgeMo"/></font><font>/</font><font><field name="Registration:RegAgeDay"/></font><font>/</font><font><field name="Registration:RegAgeYr"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Sex:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:Sex"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Name of School:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:School"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Parent's Name:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:ParentFirstName"/></font><sp/><font><field name="Registration:ParentLastName"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="200"></cell><cell width="7410"></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:Address"/></font></division></cell></row><row><cell width="2455"></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:City"/></font><font>, CA </font><font><field name="Registration:Zip"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:ParentEmail"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Additional Email:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:ParentEmail2"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Phone 1:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:Phone1"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Phone 2:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:Phone2"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Phone 3:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:Phone3"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="200"></cell><cell width="7410"></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Division Requested:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:DivRequest"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Previous Division:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:LastDiv"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="200"></cell><cell width="7410"></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Parent willing to coach:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="ParentWillingToCoach"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Player willing to umpire:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="PlayerWillingToUmpire"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="200"></cell><cell width="7410"></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Preferred Coach:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:PreferredCoach"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Preferred Teammantes:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:Friend:a"/></font><sp/><sp/><sp/><font><field name="Registration:Friend:b"/></font><sp/><sp/><font><field name="Registration:Friend:c"/></font><sp/></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Jersey Size:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:UniformSize"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="200"></cell><cell width="7410"></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Medical Plan Name:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:MedPlanName"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Plan Number:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:MedPlanNumber"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Doctor's Name:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:DocName"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Phone:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:DocPhone"/></font></division></cell></row><row><cell width="2455"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="200"></cell><cell width="7410"><division indent="0" align="left"><font><field name="Registration:DocAddress"/></font></division></cell></row></table><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">In case of loss, here is the link to </font><font color="000000"><field name="Registration:FirstName"/></font><font color="000000">'s private </font><font color="000080"><u><invitation form="PlayerDash" project="" private="true"><authenticationTokenValue><string field="Registration:RegID"/>
</authenticationTokenValue>Player Dashboard</invitation></u></font><font color="000000">.</font></paragraph>
</xmlData>
</document>
<document name="PlayerDashboardReminder">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Dear </font><font><field name="PlayerFirst"/></font><font> and Parents of </font><font><field name="PlayerFirst"/></font><font>,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Your personal </font><font><field name="League"/></font><font> link is </font><font color="000080"><u><invitation form="PlayerDash" project="" private="true"><authenticationTokenValue><string field="PlayerID"/>
</authenticationTokenValue>here</invitation></u></font><font>.  Clicking on this link will take you to </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>your private </font><font><field name="League"/></font><font> Player Dashboard.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">To save this link, click on it.  A </font><font color="000000"><field name="League"/></font><font color="000000"> Web page will come up, your personal page. </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000">Saving this link depends upon which brower you use:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Internet Explorer, click on "Favorites" in the Menu Bar at top and </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">then "Add to Favorites."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Firefox, click on "Bookmarks" in the Menu Bar at top and then </font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">"Bookmark this Page."</font></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font color="000000">If you use Safari, click on "Bookmarks" and then "Add Bookmarks."</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Be sure to save this link in a safe place.  You can use it to review or </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>change your registration and to see personal information, such as your </font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>team assignment and team roster, season schedule and the like.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Yours,</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><field name="AdminName"/></font></paragraph>
</xmlData>
</document>
<document name="Message">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="280" color="AE0000"><b><i><field name="Message"/></i></b></font></paragraph>
</xmlData>
</document>
<document name="Roster Selection Criteria">
<xmlData>
<paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240"><b>Registration Records - Team Rosters</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="RegFormMgmt" project="">Back to Registration Management</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="ShowWaiverPaymentFields" project="">Waivers &amp; Payments</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowRosterCriteria" project="">Team Rosters</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowContactFields" project="">Contact Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowMedicalFields" project="">Medical Info</invitation></u></font><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="ShowAllFields" project="">All Fields</invitation></u></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><itemization-table version="1"><number-of-columns>9</number-of-columns><column><header>Division</header><contents><field name="Record:Registration:DivRequest" /></contents></column><column><header>Previous Division</header><contents><field name="Record:Registration:LastDiv" /></contents></column><column><header>Team</header><contents><field name="Record:Team:TeamId" /></contents></column><column><header>First</header><contents><field name="Record:Registration:FirstName" /></contents></column><column><header>Last</header><contents><field name="Record:Registration:LastName" /></contents></column><column><header>Age</header><contents><field name="Record:Registration:PlayerAge" /></contents></column><column><header>Jersey</header><contents><field name="Record:Registration:UniformSize" /></contents></column><column><header>Waiver</header><contents><field name="Record:Registration:WaiverReceived" /></contents></column><column><header>Paid</header><contents><field name="Record:Registration:PaymentReceived" /></contents></column><conditions><form name="Registration" /><form name="Team" /><conditions>
<equals field="Record:Registration:TeamId">
