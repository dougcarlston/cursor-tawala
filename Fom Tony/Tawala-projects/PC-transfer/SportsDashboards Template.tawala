<mc label="Q5" alternateLabel="DivRequest" onlyone="true" required="false" style="multicolumn"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Please indicate the division in which you'd like to play: </font><font face="Arial" size="200" color="000000"><i>(To learn more about divisions, click here)</i></font></paragraph></question><data-provider><dynamic-mcq version="1"><display-expression><field name="Record:Divisions:DivNames"/>
</display-expression><value-expression><field name="Record:Divisions:DivisionID"/>
