<text label="T1" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="280" color="B30000"><b><i><field name="Message"/></i></b></font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="center"><font face="Arial" size="220" color="CC0000"><b><field name="League"/></b></font><font face="Arial" size="200" color="000000"> - </font><font face="Arial" size="220" color="CC0000"><b><field name="SeasonYr"/></b></font></paragraph><paragraph indent="0" align="center"><font face="Arial" size="220" color="CC0000"><b><field name="RegFormHeaderText"/></b></font></paragraph><paragraph indent="0" align="center"><font face="Arial" size="180" color="CC0000"><b><field name="RegFormSubHeaderText"/></b></font></paragraph><paragraph indent="0" align="center"></paragraph><paragraph indent="0" align="center"><font face="Arial" size="160" color="000000"><b><field name="RegFormDescriptionText"/></b></font></paragraph></text>
<text label="T3" style="normal"><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200">Athletic Director: </font><font face="Arial" size="200"><field name="AdminName"/></font></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="006A00"><b>Sign up as a team or individually.  If you sign up individually, you will be placed on a team.</b></font></paragraph></text>
<text label="T4" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="2160"><division indent="0" align="left"><font color="000000"><b>Registration:</b></font></division></cell><cell width="1785"></cell><cell width="3315"><division indent="0" align="left"><font color="C10000"><b><field name="League"/></b></font></division></cell><cell width="3810"><division indent="0" align="left"><font color="C10000">Due date:</font><sp/><font color="C10000"><b><field name="RegistrationDeadline"/></b></font></division></cell></row><row><cell width="2160"></cell><cell width="1785"></cell><cell width="3315"><division indent="0" align="left"><font><field name="AdminAdrss"/></font></division></cell><cell width="3810"></cell></row><row><cell width="2160"></cell><cell width="1785"></cell><cell width="3315"><division indent="0" align="left"><font><field name="AdminsCity"/></font><font>, </font><font><field name="AdminState"/></font><sp/><sp/><font><field name="AdminsZIP"/></font></division></cell><cell width="3810"></cell></row><row><cell width="2160"></cell><cell width="1785"></cell><cell width="3315"></cell><cell width="3810"><division indent="0" align="left"><font color="FF0000">Cost per player: </font><font color="FF0000"><b>$</b></font><font color="FF0000"><b><field name="SignupFeeForIndividual"/></b></font><sp/></division></cell></row><row><cell width="2160"></cell><cell width="1785"></cell><cell width="3315"><division indent="0" align="left"><font size="320" color="FF0000"><field name="PaymentStatus"/></font></division></cell><cell width="3810"></cell></row></table></text>
<fib label="Q1" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="4896"/><tabStop position="8496"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4896"/><tabStop position="8496"/></tabPositions><tab/><font face="Arial" size="200" color="000000"><i>[First]</i></font><tab/><font face="Arial" size="200" color="000000"><i>[Last]</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Name of Registrant: </b></font><tab/><blank label="a" length="18" required="false" alternateLabel="FirstName"/><tab/><blank label="b" length="18" required="false" alternateLabel="LastName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Date of Birth: </b></font><font face="Arial" size="200" color="000000"><i>(mm/dd/yyyy)</i></font><tab/><blank label="c" length="5" required="false" alternateLabel="RegAgeMo"/><font face="Arial" size="200" color="000000">/</font><blank label="d" length="5" required="false" alternateLabel="RegAgeDay"/><font face="Arial" size="200" color="000000">/</font><blank label="e" length="8" required="false" alternateLabel="RegAgeYr"/></paragraph></fib>
