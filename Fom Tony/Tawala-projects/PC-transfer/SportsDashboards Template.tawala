lse" alternateLabel="ParentEmail"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Parent Email (again):</b></font><tab/><blank label="g" length="39" required="false" alternateLabel="ParentEmailConfirm"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="180" color="000000"><b>Additional Parent Email </b></font><font face="Arial" size="180" color="000000">(optional)</font><font face="Arial" size="180" color="000000"><b>:</b></font><tab/><blank label="h" length="39" required="false" alternateLabel="ParentEmail2"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="180" color="000000"><b>Additional</b></font><font face="Arial" size="200" color="000000"><b> Parent Email (again):</b></font><tab/><blank label="i" length="39" required="false" alternateLabel="ParentEmail2Confirm"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="180" color="000000"><i>(All communications will be by email only)</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000"><b>Parent Phone Numbers (for emergencies):</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Phone 1:</font><tab/><blank label="j" length="18" required="false" alternateLabel="Phone1"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Phone 2:</font><tab/><blank label="k" length="18" required="false" alternateLabel="Phone2"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/><tabStop position="6192"/></tabPositions><font face="Arial" size="200" color="000000">Phone 3:</font><tab/><blank label="l" length="18" required="false" alternateLabel="Phone3"/></paragraph></fib>
