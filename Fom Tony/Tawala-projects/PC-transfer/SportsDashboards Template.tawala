<mc label="Q10" alternateLabel="ShirtSize" onlyone="true" required="false" style="horizontal"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>What is your jersey size?</b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Youth large</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Adult small</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Adult medium</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Adult large</font></paragraph></choice><choice label="e"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Adult extra large</font></paragraph></choice></mc>
<text label="T7" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Medical Information:</b></font></paragraph></text>
<fib label="Q11" style="freeform"><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Plan Name: </b></font><tab/><blank label="a" length="39" required="false" alternateLabel="MedPlanName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Plan Number: </b></font><tab/><blank label="b" length="39" required="false" alternateLabel="MedPlanNumber"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Child's Physician:</b></font><tab/><blank label="c" length="39" required="false" alternateLabel="DocName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Physician Phone:</b></font><tab/><blank label="d" length="39" required="false" alternateLabel="DocPhone"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="4031"/></tabPositions><font face="Arial" size="200" color="000000"><b>Physician Address:</b></font><tab/><blank label="e" length="39" required="false" alternateLabel="DocAddress"/></paragraph></fib>
<skipInstructions>
<if>
<conditions>
<or>
<doesNotEqual field="Registration:ParentEmail">
<string field="Registration:ParentEmailConfirm"/>
</doesNotEqual>
<isBlank field="Registration:ParentEmail" />
</or>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Email address is blank or two copies of email fail to match."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<isNotBlank field="Registration:ParentEmail2" />
</conditions>
<trueSet>
<if>
<conditions>
<doesNotEqual field="Registration:ParentEmail2">
<string field="Registration:ParentEmail2Confirm"/>
</doesNotEqual>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Two copies of additional email fail to match."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
</trueSet>
</if>
<if>
<conditions>
<or>
<isBlank field="Registration:FirstName" />
<isBlank field="Registration:LastName" />
</or>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please enter Registrant&apos;s First and Last names in the spaces provided."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<and>
<mcDoesNotEqual field="Registration:SexMCQ" value="a"/>
<mcDoesNotEqual field="Registration:SexMCQ" value="b"/>
</and>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please mark Registrant&apos;s sex."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<mcIsBlank field="Registration:ShirtSize" />
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please indicate your jersey size."/>
</set>
<set field="Jersey" arithmeticAsText="false">
<string value="Youth large"/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="a"/>
</conditions>
<trueSet>
<set field="Sx" arithmeticAsText="false">
<string value="Boy"/>
</set>
</trueSet>
<falseSet>
<set field="Sx" arithmeticAsText="false">
<string value="Girl"/>
</set>
</falseSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="a"/>
</conditions>
<trueSet>
<set field="Jersey" arithmeticAsText="false">
<string value="Youth large"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="b"/>
</conditions>
<trueSet>
<set field="Jersey" arithmeticAsText="false">
<string value="Adult small"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="c"/>
</conditions>
<trueSet>
<set field="Jersey" arithmeticAsText="false">
<string value="Adult medium"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="d"/>
</conditions>
<trueSet>
<set field="Jersey" arithmeticAsText="false">
<string value="Adult large"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="e"/>
</conditions>
<trueSet>
<set field="Jersey" arithmeticAsText="false">
<string value="Adult extra large"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<or>
<isLessThan field="Registration:RegAgeYr">
<string value="100"/>
</isLessThan>
<isBlank field="Registration:RegAgeYr" />
</or>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Please enter year of birth as a four digit number (e.g. &quot;1995&quot;)."/>
</set>
<skip to="T1"/>
</trueSet>
</if>
<set field="ParentWillingToCoach" arithmeticAsText="false">
<string value="No"/>
</set>
<if>
<conditions>
<mcContains field="Registration:WillingToCoachOrUmpire" value="a"/>
</conditions>
<trueSet>
<set field="ParentWillingToCoach" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<set field="PlayerWillingToUmpire" arithmeticAsText="false">
<string value="No"/>
</set>
<if>
<conditions>
<mcContains field="Registration:WillingToCoachOrUmpire" value="b"/>
</conditions>
<trueSet>
<set field="PlayerWillingToUmpire" arithmeticAsText="false">
<string value="Yes"/>
</set>
</trueSet>
</if>
<set field="Message" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="Registration:InfoCorrect" arithmeticAsText="false">
<string value=" "/>
</set>
</skipInstructions>
<text label="T8" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240" color="A00000"><b><i>Please review the information below carefully.</i></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="390"><row><cell width="3165"><division indent="0" align="right"><font><b>Name:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:FirstName"/></font><sp/><font><field name="Registration:LastName"/></font><sp/></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Date of Birth:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:RegAgeMo"/></font><font>/</font><font><field name="Registration:RegAgeDay"/></font><font>/</font><font><field name="Registration:RegAgeYr"/></font><sp/></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Sex:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Sx"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Name of School:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:School"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Parent's Name:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:ParentFirstName"/></font><sp/><font><field name="Registration:ParentLastName"/></font><sp/></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:Address"/></font></division><division indent="0" align="left"><font><field name="Registration:City"/></font><font>, CA </font><font><field name="Registration:Zip"/></font><sp/></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Parent's Email(s):</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:ParentEmail"/></font><sp/><font><field name="Registration:ParentEmail2"/></font><sp/></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Phone1:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:Phone1"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Phone2:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:Phone2"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Phone3:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:Phone3"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="330"></cell><cell width="6915"></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Division Info:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><i>(Will be blank if divisions not in use)</i></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Division requested:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:DivRequest"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Previous division:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:LastDiv"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="330"></cell><cell width="6915"></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Parent is willing to coach:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="ParentWillingToCoach"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Player is willing to umpire:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="PlayerWillingToUmpire"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="330"></cell><cell width="6915"></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Preferred Coach:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:PreferredCoach"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Preferred Teammates:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:Friend:a"/></font><sp/><sp/><font><field name="Registration:Friend:b"/></font><sp/><sp/><sp/><font><field name="Registration:Friend:c"/></font><sp/></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Jersey Size:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><display-mcq-label version="1"><field-name>Registration:ShirtSize</field-name><display>label_only</display></display-mcq-label></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><sp/><sp/><sp/></division></cell><cell width="330"></cell><cell width="6915"></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Medical Plan:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:MedPlanName"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Plan Number:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:MedPlanNumber"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Doctor's Name:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:DocName"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Phone:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:DocPhone"/></font></division></cell></row><row><cell width="3165"><division indent="0" align="right"><font><b>Address:</b></font></division></cell><cell width="330"></cell><cell width="6915"><division indent="0" align="left"><font><field name="Registration:DocAddress"/></font></division></cell></row></table></text>
<text label="T9"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="240" color="A00000"><b><i><field name="Message"/></i></b></font></paragraph></text>
<mc label="Q12" alternateLabel="InfoCorrect" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Select an option and click Submit.</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Correct or change the above information.</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">The above information is correct. Continue to the next step.</font></paragraph></choice></mc>
<skipInstructions>
<set field="Message" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcEquals field="Registration:InfoCorrect" value="a"/>
</conditions>
<trueSet>
<skip to="T2"/>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:InfoCorrect" value="c"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
<if>
<conditions>
<mcDoesNotEqual field="Registration:InfoCorrect" value="b"/>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Select an option below and click Submit."/>
</set>
<set field="Registration:InfoCorrect" arithmeticAsText="false">
<string value=" "/>
</set>
<skip to="T8"/>
</trueSet>
</if>
</skipInstructions>
<field name="TeamId"/>
<field name="PaymentReceived"/>
<field name="WaiverReceived"/>
<field name="Sex"/>
<field name="RegID"/>
<field name="UniformSize"/>
<field name="Birthday"/>
<field name="PlayerAge"/>
<field name="FriendsList"/>
<field name="BadEmail?"/>
<field name="GroupRegistrationId"/>
<field name="LinkToPlayerDashboardSent"/>
<field name="CoachVolunteer"/>
<field name="PaidAmount"/>
<field name="PaymentMethod"/>
<field name="Recruiting"/>
</items>
</form>
<form name="RegStep2" startPoint="false" themePath="dirtbowl2" process="Post-RegStep2">
<items>
<skipInstructions>
<if>
<conditions>
<equals field="BouncebackFlag">
<string value="AdminRegisteringPlayer"/>
</equals>
</conditions>
<trueSet>
<comment>-- Admin is registering a player; this ultimately passes him right through back to the admin menu</comment>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="Registration:PaymentReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<if>
<conditions>
<equals field="Registration:WaiverReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<skip to="EverythingIsReceived"/>
</trueSet>
<falseSet>
<skip to="OnlyWaiverIsNeeded"/>
</falseSet>
</if>
</trueSet>
<falseSet>
<if>
<conditions>
<equals field="Registration:WaiverReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<skip to="OnlyPaymentIsNeeded"/>
</trueSet>
</if>
</falseSet>
</if>
</skipInstructions>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Step 1 of your registration has been completed.</font></paragraph></heading>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You still need to complete:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Step 2:</b></font><font>  Submit your payment of $</font><font><field name="SignupFeeForIndividual"/></font><font>, and</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Step 3:</b></font><font> Click the link to your personal Dirtbowl Dashboard.  Then print out, complete, sign and mail in your medical waiver.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press the </font><font><b>Submit</b></font><font> button below to proceed to </font><font><b>Step 2</b></font><font>.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="280" color="A00000"><b><i>Note: DO NOT USE THE BACK BUTTON on your browser.</i></b></font></paragraph></text>
<text label="T2" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="240" color="000000"><b>*NOTE: No child will be allowed to participate without a signed waiver and payment.</b></font></paragraph></text>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T3" alternateLabel="OnlyWaiverIsNeeded" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You still need to complete:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>A signed medical waiver</b></font><font>.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press the </font><font><b>Submit</b></font><font> button below to display the waiver, which you need to print out, complete and sign, and mail to the address shown on the waiver.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="280" color="A00000"><b><i>Note: DO NOT USE THE BACK BUTTON on your browser.</i></b></font></paragraph></text>
<text label="T4" style="normal"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="240" color="000000"><b>*NOTE: No child will be allowed to participate without a signed waiver.</b></font></paragraph></text>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T5" alternateLabel="OnlyPaymentIsNeeded" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>You still need to submit:</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Your payment of $</b></font><font><b><field name="SignupFeeForIndividual"/></b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Press the </font><font><b>Submit</b></font><font> button below to proceed to the payment options.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font size="280" color="A00000"><b><i>Note: DO NOT USE THE BACK BUTTON on your browser.</i></b></font></paragraph></text>
<skipInstructions>
<skip to="__EndOfForm__"/>
</skipInstructions>
<text label="T6" alternateLabel="EverythingIsReceived"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>We have received both your payment and waiver. Thank you!</font></paragraph></text>
</items>
</form>
<form name="AdminSetup" startPoint="false" themePath="dirtbowl2" process="Post-AdminSetup" preProcess="Pre-AdminSetup">
<items>
<heading label="H1" type="Sub"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Admin Setup</font></paragraph></heading>
<fib label="Q1" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Athletic Director:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Name:  </font><blank label="a" length="35" required="false" alternateLabel="AdminsName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Email Address:  </font><blank label="b" length="35" required="false" alternateLabel="AdminsEmail"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Phone Number: </font><blank label="c" length="35" required="false" alternateLabel="AdminPhone"/></paragraph></fib>
<fib label="Q2" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/><sp/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Mailing Address:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Street: </font><blank label="a" length="52" required="false" alternateLabel="AdminAddress"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">City:     </font><blank label="b" length="52" required="false" alternateLabel="AdminCity"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">State:   </font><blank label="c" length="52" required="false" alternateLabel="AdminST"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Zip: </font><blank label="d" length="52" required="false" alternateLabel="AdminZIP"/></paragraph></fib>
<text label="T1"><paragraph indent="720" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000"><i>(The above address is where waivers and checks will be sent.)</i></font></paragraph></text>
<fib label="Q3" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/><sp/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>League Information:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">League Name </font><font face="Arial" size="200" color="000000"><i>(e.g. Mill Valley Dirt Bowl)</i></font><font face="Arial" size="200" color="000000">: </font><blank label="a" length="20" required="false" alternateLabel="LeagueName"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Season </font><font face="Arial" size="200" color="000000"><i>(e.g 2008)</i></font><font face="Arial" size="200" color="000000">: </font><blank label="b" length="20" required="false" alternateLabel="Season"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">URL of the league schedule: </font><blank label="c" length="19" required="false" alternateLabel="ScheduleURL"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">URL of the league Web site: </font><blank label="d" length="19" required="false" alternateLabel="LeagueWebSite"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">URL of the league rules: </font><blank label="e" length="19" required="false" alternateLabel="LeagueRules"/></paragraph></fib>
<fib label="Q4" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Registration Form:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Registration deadline date: </font><blank label="a" length="17" required="false" alternateLabel="RegFormDeadline"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Header text: </font><blank label="b" length="20" required="false" alternateLabel="RegFormHeader"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Sub-header text </font><font face="Arial" size="200" color="000000"><i>(optional)</i></font><font face="Arial" size="200" color="000000">: </font><blank label="c" length="20" required="false" alternateLabel="RegFormSubHeader"/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Additional descriptive text </font><font face="Arial" size="200" color="000000"><i>(optional)</i></font><font face="Arial" size="200" color="000000">: </font><blank label="d" length="19" required="false" alternateLabel="RegFormDescription"/></paragraph></fib>
<text label="T2"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000000"><i>(The above Header, Sub-header and descriptive text appear at the top of the Registration Form, and can contain any information you would like to have appear there.)</i></font></paragraph></text>
<text label="T3"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><sp/><sp/><sp/></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Division Setup:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="720" align="left"><tabPositions><tabStop position="720"/><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><simple-list version="2"><simple-list-field>Record:Divisions:DivNames</simple-list-field><conditions><form name="Divisions" /></conditions></simple-list></font></paragraph></text>
<mc label="Q5" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Check here to add, edit or delete divisions</font></paragraph></choice></mc>
<text label="T4"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><b>Fee Information:</b></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Signup fee for individual players:</font></paragraph></text>
<fib label="Q6" style="rightAlignLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">$ </font><blank label="a" length="12" required="false" alternateLabel="IndividualSignupFee"/></paragraph></fib>
<mc label="Q7" alternateLabel="EnablePaypalPayments" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enable PayPal online payments</font></paragraph></choice></mc>
<text label="T5"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Description of charges (will appear on PayPal check out screen):</font></paragraph></text>
<fib label="Q8" style="leftAlignLabelsJustified"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><blank label="a" length="20" required="false" alternateLabel="ChargeDescription"/></paragraph></fib>
<mc label="Q9" alternateLabel="EmailNotificationPreference" onlyone="false" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000"><b>Options:</b></font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send me an email notification of each new registration</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Send me a single copy of each bulk mailing</font></paragraph></choice></mc>
