</items>
</form>
<form name="AddRecruitFromReg" startPoint="false" themePath="dirtbowl2" process="Post-AddRecruitFromReg">
<items>
<heading label="H1" type="Main"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="360" color="000000">Add to Recruiting list from Registrations</font></paragraph></heading>
<text label="T1"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font color="000080"><u><invitation form="Recruitment" project="">Back to Recruitment List Management</invitation></u></font><sp/><sp/><sp/><sp/><sp/><sp/><sp/><font color="000080"><u><invitation form="AdminDash" project="">Back to Administrator Dashboard</invitation></u></font></paragraph></text>
<text label="T2" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Registered players may be added to the Recruitment list for next year using this utility.  The process cannot be completly automatic, as Players and their families change email addresses, phone numbers, even first names with some regularity.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Instead, this utility offers a series of tools to permit you to review potential additions to your list before making a final decision.</font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font>Registration data is not changed here.  Rather this tool is used to prepare the recruitment list for use in future years.</font></paragraph></text>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Which approach do you want to use (you can use more than one)?</font></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add all registered players that don't appear to be in recruitment list already.</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add all registered players to recruitment list if they were born after a specified date and don't appear to be in list already</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Add  all registration data, automatically replacing recruitment list data with registration data for apparent matches</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Manually compare recruitment and registration data of apparent matches before changing recruitment list data</font></paragraph></choice></mc>
<skipInstructions>
<set field="Message" arithmeticAsText="false">
<string value=" "/>
</set>
<if>
<conditions>
<mcDoesNotEqual field="AddRecruitFromReg:Q1" value="b"/>
</conditions>
<trueSet>
<skip to="__EndOfForm__"/>
</trueSet>
</if>
</skipInstructions>
<text label="T3"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i><field name="Message"/></i></font></paragraph></text>
<fib label="Q2" style="topLabels"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Enter the  cut-off year using 4 digits, e.g. 1999  (Players born before this year will not be added to recruitment list).  </font><font face="Arial" size="200" color="000000"> </font><blank label="a" length="9" required="false" alternateLabel="Year"/></paragraph></fib>
<skipInstructions>
<if>
<conditions>
<isLessThan field="AddRecruitFromReg:Year">
<string value="1940"/>
</isLessThan>
</conditions>
<trueSet>
<set field="Message" arithmeticAsText="false">
<string value="Enter year as a four digit number, e.g. &quot;2001&quot;"/>
</set>
<skip to="T3"/>
</trueSet>
</if>
</skipInstructions>
</items>
</form>
<form name="CompareNMark" startPoint="false" themePath="dirtbowl2" preProcess="Pre-CompareNMark">
<items>
<text label="T1" style="instructional"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font><i>Compare the data from the two files:</i></font></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="5400"><division indent="0" align="center"><font><b>From the Recruitment Records:</b></font></division></cell><cell width="5400"><division indent="0" align="center"><font><b>From the Registration Records:</b></font></division></cell></row></table><paragraph indent="0" align="center"><tabPositions><tabStop position="2880"/></tabPositions></paragraph><table indent="0"><row><cell width="1800"><division indent="0" align="right"><font><b>First:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitPFirst"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>First:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="PlayerFirst"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Last:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitPLast"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>Last:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="PlayerLast"/></font></division></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Parent First:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitParentFirst"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>Parent First:</b></font></division></cell><cell width="272"></cell><cell width="3328"></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitEmail"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>Email:</b></font></division></cell><cell width="272"></cell><cell width="3328"></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Email1:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitEmail2"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>Email1:</b></font></division></cell><cell width="272"></cell><cell width="3328"></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Phone:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitPhone"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>Phone:</b></font></division></cell><cell width="272"></cell><cell width="3328"></cell></row><row><cell width="1800"><division indent="0" align="right"><font><b>Record ID:</b></font></division></cell><cell width="272"></cell><cell width="3328"><division indent="0" align="left"><font><field name="RecruitID"/></font></division></cell><cell width="1800"><division indent="0" align="right"><font><b>Record ID:</b></font></division></cell><cell width="272"></cell><cell width="3328"></cell></row></table></text>
<mc label="Q1" onlyone="true" required="false"><question><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions></paragraph></question><choice label="a"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Leave both records as they are</font></paragraph></choice><choice label="b"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Overwrite the record in the recruitment file with the newer data in the registration</font></paragraph></choice><choice label="c"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">These records are not for the same person.  Add the registration data as a new recruitment record.</font></paragraph></choice><choice label="d"><paragraph indent="0" align="left"><tabPositions><tabStop position="2880"/></tabPositions><font face="Arial" size="200" color="000000">Edit the recruitment record manually, using data from both records.</font></paragraph></choice></mc>
</items>
</form>
</forms>
<processes>
<process name="Post-Registration">
<comment>-- If the session expires we need to re-read the setup variables</comment>
<get recordList="SetupRecords">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="Admin" recordList="SetupRecords">
<set field="AdminName" arithmeticAsText="false">
<string field="Admin:AdminSetup:AdminsName"/>
</set>
<set field="AdminEmail" arithmeticAsText="false">
<string field="Admin:AdminSetup:AdminsEmail"/>
</set>
<set field="AdminAdrss" arithmeticAsText="false">
<string field="Admin:AdminSetup:AdminAddress"/>
</set>
<set field="AdminsCity" arithmeticAsText="false">
<string field="Admin:AdminSetup:AdminCity"/>
</set>
<set field="AdminState" arithmeticAsText="false">
<string field="Admin:AdminSetup:AdminST"/>
</set>
<set field="AdminsZIP" arithmeticAsText="false">
<string field="Admin:AdminSetup:AdminZIP"/>
</set>
<set field="League" arithmeticAsText="false">
<string field="Admin:AdminSetup:LeagueName"/>
</set>
<set field="SeasonYr" arithmeticAsText="false">
<string field="Admin:AdminSetup:Season"/>
</set>
<set field="SignupFeeForIndividual" arithmeticAsText="false">
<string field="Admin:AdminSetup:IndividualSignupFee"/>
</set>
<set field="PaymentChargeDescription" arithmeticAsText="false">
<string field="Admin:AdminSetup:ChargeDescription"/>
</set>
</foreach>
<if>
<conditions>
<isNotBlank field="Registration:RegAgeYr" />
</conditions>
<trueSet>
<if>
<conditions>
<isGreaterThan field="Registration:RegAgeMo">
<string value="8"/>
</isGreaterThan>
</conditions>
<trueSet>
<set field="Registration:PlayerAge" arithmeticAsText="false">
<sub>
<sub>
<operand field="SeasonYr"/>
<operand field="Registration:RegAgeYr"/>
</sub>
<operand value="1"/>
</sub>
</set>
</trueSet>
<falseSet>
<set field="Registration:PlayerAge" arithmeticAsText="false">
<sub>
<operand field="SeasonYr"/>
<operand field="Registration:RegAgeYr"/>
</sub>
</set>
</falseSet>
</if>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="a"/>
</conditions>
<trueSet>
<set field="Registration:Sex" arithmeticAsText="false">
<string value="Boy"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:SexMCQ" value="b"/>
</conditions>
<trueSet>
<set field="Registration:Sex" arithmeticAsText="false">
<string value="Girl"/>
</set>
</trueSet>
</if>
<comment>-- if parent has checked the "willing to coach" box</comment>
<if>
<conditions>
<mcContains field="Registration:WillingToCoachOrUmpire" value="a"/>
</conditions>
<trueSet>
<comment>-- and they are not already signed up as a coach</comment>
<get recordList="MatchingCoachList">
<forms>
<form name="Coach"/>
</forms>
<conditions>
<or>
<equals field="MatchingCoachList:Coach:Email">
<string field="Registration:ParentEmail"/>
</equals>
<equals field="MatchingCoachList:Coach:Email">
<string field="Registration:ParentEmail2"/>
</equals>
</or>
</conditions></get>
<foreach record="MatchingCoach" recordList="MatchingCoachList">
<if>
<conditions>
<isNotBlank field="MatchingCoach:Coach:Email" />
</conditions>
<trueSet>
<set field="Registration:CoachVolunteer" arithmeticAsText="false">
<string value="RegisteredCoach"/>
</set>
</trueSet>
</if>
</foreach>
<if>
<conditions>
<doesNotEqual field="Registration:CoachVolunteer">
<string value="RegisteredCoach"/>
</doesNotEqual>
</conditions>
<trueSet>
<comment>-- mark them as "available"</comment>
<set field="Registration:CoachVolunteer" arithmeticAsText="false">
<string value="Available"/>
</set>
</trueSet>
</if>
</trueSet>
<falseSet>
<comment>-- in case they unchecked the previously-checked box</comment>
<set field="Registration:CoachVolunteer" arithmeticAsText="false">
<string value=" "/>
</set>
</falseSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="a"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Youth L"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="b"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult S"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="c"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult M"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="d"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult L"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<mcEquals field="Registration:ShirtSize" value="e"/>
</conditions>
<trueSet>
<set field="Registration:UniformSize" arithmeticAsText="false">
<string value="Adult XL"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="Registration:RegID" />
</conditions>
<trueSet>
<get recordList="Record List 18">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="RegNo" recordList="Record List 18">
<set field="RegNo:AdminSetup:PlayerIDGenerator" arithmeticAsText="false">
<add>
<operand field="RegNo:AdminSetup:PlayerIDGenerator"/>
<operand value="1"/>
</add>
</set>
<set field="PlayerID" arithmeticAsText="false">
<string value="player"/>
<string field="RegNo:AdminSetup:PlayerIDGenerator"/>
<string field="Registration:ParentEmail"/>
</set>
<set field="Registration:RegID" arithmeticAsText="false">
<string field="PlayerID"/>
</set>
</foreach>
</trueSet>
</if>
<set field="Registration:Birthday" arithmeticAsText="true">
<string field="Registration:RegAgeMo"/>
<string value="/"/>
<string field="Registration:RegAgeDay"/>
<string value="/"/>
<string field="Registration:RegAgeYr"/>
</set>
<set field="Registration:FriendsList" arithmeticAsText="false">
<string field="Registration:Friend:a"/>
<string value="   "/>
<string field="Registration:Friend:b"/>
<string value="   "/>
<string field="Registration:Friend:c"/>
</set>
<set field="PlayerFirst" arithmeticAsText="false">
<string field="Registration:FirstName"/>
</set>
<set field="PlayerLast" arithmeticAsText="false">
<string field="Registration:LastName"/>
</set>
<if>
<conditions>
<equals field="From">
<string value="AdminRegMgmt"/>
</equals>
</conditions>
<trueSet>
<show form="AdminShowWaiver"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="RegistrationAudit"/>
</equals>
</conditions>
<trueSet>
<set field="Registration:BadEmail?" arithmeticAsText="false">
<string value=" "/>
</set>
<show form="AuditFormLoop"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="AddPlayerToGroupRegistration"/>
</equals>
</conditions>
<trueSet>
<set field="Registration:GroupRegistrationId" arithmeticAsText="false">
<string field="GroupRegistationId"/>
</set>
<set field="Registration:TeamId" arithmeticAsText="false">
<string field="Team"/>
</set>
<set field="Registration:PaymentReceived" arithmeticAsText="false">
<string value="Yes"/>
</set>
<set field="Registration:FirstName" arithmeticAsText="false">
<string field="AddPlayerToGroupRegistration:FirstName"/>
</set>
<set field="Registration:LastName" arithmeticAsText="false">
<string field="AddPlayerToGroupRegistration:LastName"/>
</set>
<set field="Registration:ParentEmail" arithmeticAsText="false">
<string field="AddPlayerToGroupRegistration:Parents&apos; Email"/>
</set>
<send>
<to addressField="AddPlayerToGroupRegistration:Parents&apos; Email"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject><field name="League"/> Registration</subject>
<body document="InvitationToCompleteRegistration" reset="false" showHeader="true"/>
</send>
<show form="AddPlayerToGroupRegistration"/>
</trueSet>
</if>
<show form="RegStep2"/>
</process>
<process name="Post-RegStep2">
<if>
<conditions>
<isBlank field="Registration:LinkToPlayerDashboardSent" />
</conditions>
<trueSet>
<comment>-- Means that this is not the user editing his/her record from the player dashboard,</comment>
<comment>-- but either the first time registrant or the admin creating the record.</comment>
<if>
<conditions>
<equals field="Registration:PaymentReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<send>
<to addressField="Registration:ParentEmail"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject>Your Dirt Bowl Registration</subject>
<body document="PostRegistrationLetterWithoutPaymentInstructions" reset="false" showHeader="true"/>
</send>
<if>
<conditions>
<isNotBlank field="Registration:ParentEmail2" />
</conditions>
<trueSet>
<send>
<to addressField="Registration:ParentEmail2"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject>Your Dirt Bowl Registration</subject>
<body document="PostRegistrationLetterWithoutPaymentInstructions" reset="false" showHeader="true"/>
</send>
</trueSet>
</if>
</trueSet>
<falseSet>
<send>
<to addressField="Registration:ParentEmail"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject>Your Dirt Bowl Registration</subject>
<body document="PostRegistrationLetterWithPaymentInstructions" reset="false" showHeader="true"/>
</send>
<if>
<conditions>
<isNotBlank field="Registration:ParentEmail2" />
</conditions>
<trueSet>
<send>
<to addressField="Registration:ParentEmail2"/>
<from addressField="AdminEmail" aliasField="AdminName"/>
<subject>Your Dirt Bowl Registration</subject>
<body document="PostRegistrationLetterWithPaymentInstructions" reset="false" showHeader="true"/>
</send>
</trueSet>
</if>
</falseSet>
</if>
<get recordList="Registration Records">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<equals field="Registration Records:Registration:RegID">
<string field="Registration:RegID"/>
</equals>
</conditions></get>
<foreach record="Such Record" recordList="Registration Records">
<set field="Such Record:Registration:LinkToPlayerDashboardSent" arithmeticAsText="false">
<string value="Yes"/>
</set>
</foreach>
<get recordList="Record List 19">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="Selection" recordList="Record List 19">
<if>
<conditions>
<mcContains field="Selection:AdminSetup:EmailNotificationPreference" value="a"/>
</conditions>
<trueSet>
<comment>-- This is needed to prevent a weird bug that causes designer to crash</comment>
<set field="PlayerFullName" arithmeticAsText="false">
<string field="Registration:FirstName"/>
<string value=" "/>
<string field="Registration:LastName"/>
</set>
<send>
<to addressField="AdminEmail"/>
<from addressField="AdminEmail" aliasLiteral="Dirt Bowl Automated Email Server"/>
<subject>Registration received for <field name="PlayerFullName"/></subject>
<body document="AdminRegNotification" reset="false" showHeader="true"/>
</send>
</trueSet>
</if>
</foreach>
</trueSet>
</if>
<if>
<conditions>
<equals field="BouncebackFlag">
<string value="AdminRegisteringPlayer"/>
</equals>
</conditions>
<trueSet>
<comment>-- Admin is registering a player; this passes him right through back to the admin menu</comment>
<show form="AdminBounceback"/>
</trueSet>
</if>
<if>
<conditions>
<equals field="Registration:PaymentReceived">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<show form="PlayerDash"/>
</trueSet>
<falseSet>
<if>
<conditions>
<isBlank field="EnableOnlinePayments" />
</conditions>
<trueSet>
<show document="PaymentByCheckInstructions" reset="false"/>
</trueSet>
<falseSet>
<show form="OnlinePayment"/>
</falseSet>
</if>
</falseSet>
</if>
</process>
<process name="Post-AdminDash">
<if>
<conditions>
<isBlank field="AdminName" />
</conditions>
<trueSet>
<show form="AdminSetup"/>
</trueSet>
</if>
<get recordList="Record List 1">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="Record" recordList="Record List 1">
<if>
<conditions>
<mcContains field="Record:AdminSetup:EmailNotificationPreference" value="a"/>
</conditions>
<trueSet>
<set field="FlagA" arithmeticAsText="false">
<string value="ON"/>
</set>
</trueSet>
<falseSet>
<set field="FlagA" arithmeticAsText="false">
<string value="OFF"/>
</set>
</falseSet>
</if>
<if>
<conditions>
<mcContains field="Record:AdminSetup:EmailNotificationPreference" value="b"/>
</conditions>
<trueSet>
<set field="FlagB" arithmeticAsText="false">
<string value="ON"/>
</set>
</trueSet>
<falseSet>
<set field="FlagB" arithmeticAsText="false">
<string value="OFF"/>
</set>
</falseSet>
</if>
</foreach>
<show document="AdminDashboard" reset="false"/>
</process>
<process name="Post-AdminSetup">
<set field="AdminSetup:UsingDivisions?" arithmeticAsText="false">
<string value="No"/>
</set>
<get recordList="Record List 96">
<forms>
<form name="Divisions"/>
</forms>
</get>
<foreach record="DivCount" recordList="Record List 96">
<set field="AdminSetup:UsingDivisions?" arithmeticAsText="false">
<string value="Yes"/>
</set>
</foreach>
<if>
<conditions>
<mcContains field="AdminSetup:Q5" value="a"/>
</conditions>
<trueSet>
<set field="AdminSetup:Q5" arithmeticAsText="false">
<string value=" "/>
</set>
<show form="Divisions"/>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="AdminSetup:Coach4EachTeam" />
</conditions>
<trueSet>
<set field="AdminSetup:Coach4EachTeam" arithmeticAsText="false">
<string value="No"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="AdminSetup:AllPlayersAssignedChecked" />
</conditions>
<trueSet>
<set field="AdminSetup:AllPlayersAssignedChecked" arithmeticAsText="false">
<string value="No"/>
</set>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="AdminSetup:UniformOrdered" />
</conditions>
<trueSet>
<set field="AdminSetup:UniformOrdered" arithmeticAsText="false">
<string value="No"/>
</set>
</trueSet>
</if>
<show form="AdminDash"/>
</process>
<process name="Post-RecruitDB">
<if>
<conditions>
<equals field="Action">
<string value="AddNonDupes"/>
</equals>
</conditions>
<trueSet>
<set field="AllDone" arithmeticAsText="false">
<string value="Yes"/>
</set>
<if>
<conditions>
<equals field="From">
<string value="a"/>
</equals>
</conditions>
<trueSet>
<get recordList="Record List 113">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<equals field="Record List 113:Registration:Recruiting">
<string value="No"/>
</equals>
</conditions></get>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="b"/>
</equals>
</conditions>
<trueSet>
<get recordList="Record List 113">
<forms>
<form name="Registration"/>
</forms>
<conditions>
<and>
<equals field="Record List 113:Registration:Recruiting">
<string value="No"/>
</equals>
<isLessThanOrEqualTo field="Record List 113:Registration:RegAgeYr">
<string field="AddRecruitFromReg:Year"/>
</isLessThanOrEqualTo>
</and>
</conditions></get>
</trueSet>
</if>
<if>
<conditions>
<equals field="From">
<string value="c"/>
</equals>
</conditions>
<trueSet>
<get recordList="Record List 113">
<forms>
<form name="Registration"/>
</forms>
</get>
</trueSet>
</if>
<foreach record="SuchNonDupe" recordList="Record List 113">
<if>
<conditions>
<and>
<doesNotEqual field="SuchNonDupe:Registration:Recruiting">
<string value="No"/>
</doesNotEqual>
<isNotBlank field="SuchNonDupe:Registration:Recruiting" />
</and>
</conditions>
<trueSet>
<get recordList="Record List 115">
<forms>
<form name="RecruitmentDB"/>
</forms>
<conditions>
<equals field="SuchNonDupe:Registration:Recruiting">
<string field="Record List 115:RecruitmentDB:RecruitmentId"/>
</equals>
</conditions></get>
<foreach record="PreviousRecruit" recordList="Record List 115">
<set field="PreviousRecruit:RecruitmentDB:FirstName" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:FirstName"/>
</set>
<set field="PreviousRecruit:RecruitmentDB:LastName" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:LastName"/>
</set>
<set field="PreviousRecruit:RecruitmentDB:ParentFirst" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:ParentFirstName"/>
</set>
<set field="PreviousRecruit:RecruitmentDB:Email" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:ParentEmail"/>
</set>
<set field="PreviousRecruit:RecruitmentDB:Email2" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:ParentEmail2"/>
</set>
<set field="PreviousRecruit:RecruitmentDB:Phone" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:Phone1"/>
</set>
<set field="SuchNonDupe:Registration:Recruiting" arithmeticAsText="false">
<string value="Added"/>
</set>
<set field="AllDone" arithmeticAsText="false">
<string value="Skip"/>
</set>
</foreach>
</trueSet>
<falseSet>
<set field="AllDone" arithmeticAsText="false">
<string value="No"/>
</set>
<set field="RecruitmentDB:FirstName" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:FirstName"/>
</set>
<set field="RecruitmentDB:LastName" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:LastName"/>
</set>
<set field="RecruitmentDB:ParentFirst" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:ParentFirstName"/>
</set>
<set field="RecruitmentDB:Email" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:ParentEmail"/>
</set>
<set field="RecruitmentDB:Email2" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:ParentEmail2"/>
</set>
<set field="RecruitmentDB:Phone" arithmeticAsText="false">
<string field="SuchNonDupe:Registration:Phone1"/>
</set>
<set field="SuchNonDupe:Registration:Recruiting" arithmeticAsText="false">
<string value="Added"/>
</set>
<get recordList="Record List 114">
<forms>
<form name="AdminSetup"/>
</forms>
</get>
<foreach record="RecordID" recordList="Record List 114">
<set field="RecruitmentDB:RecruitmentId" arithmeticAsText="false">
<add>
<operand field="RecordID:AdminSetup:RecruitmentIdGenerator"/>
<operand value="1"/>
</add>
</set>
<set field="RecordID:AdminSetup:RecruitmentIdGenerator" arithmeticAsText="false">
<string field="RecruitmentDB:RecruitmentId"/>
</set>
</foreach>
</falseSet>
</if>
<if>
<conditions>
<equals field="AllDone">
<string value="Yes"/>
</equals>
</conditions>
<trueSet>
<set field="Action" arithmeticAsText="false">
<string value=" "/>
</set>
<set field="Message" arithmeticAsText="false">
<string value="Registered players added to recruitment database"/>
</set>
<show document="Message" reset="false"/>
<show form="AddRecruitFromReg"/>
</trueSet>
<falseSet>
<if>
<conditions>
<doesNotEqual field="AllDone">
<string value="Skip"/>
</doesNotEqual>
</conditions>
<trueSet>
<show form="RecruitmentDB"/>
</trueSet>
</if>
</falseSet>
</if>
</foreach>
</trueSet>
</if>
<if>
<conditions>
<equals field="Action">
<string value="AddNonDupes"/>
</equals>
</conditions>
<trueSet>
<show form="RecruitmentDB"/>
</trueSet>
</if>
<if>
<conditions>
<isBlank field="RecruitmentDB:RecruitmentId" />
</conditions>
<trueSet>
<get recordList="Setup Records">
<forms>
<form name="AdminSetup"/>
</forms>
